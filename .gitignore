# Конфиг у каждого свой: имена устройств, каналы, комнаты.
# В репозитории живёт только config.example.yaml.
config.yaml

# Свои темы (с 1.25) - у каждого свои, как и конфиг. Заготовки «_*.yaml»
# живут в репозитории. Чтобы хранить свои темы в git, уберите эту строку.
themes/*.yaml
!themes/_*.yaml

# Данные демона: списки и всё, что он хранит сам. Своё у каждого
# контроллера, как и конфиг, - и в публичный репозиторий им незачем.
data/

# Пароли и всё, что рядом с ними
*.passwd
*.htpasswd
.htpasswd
secrets.*

# Бэкапы, которые оставляют после себя патч-скрипты
*.bak
*.bak-*
*.orig
*.rej

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Хлам редакторов и систем
.vscode/
.idea/
*.swp
.DS_Store
