{#-
  Вся внешность панели живёт здесь. Python сюда не заглядывает - он присылает
  уже посчитанные числа. Правьте свободно, рестарт демона не нужен.

  Единая раскладка любой плитки:
      иконка сверху слева   ·   значение сверху справа
      название снизу слева  ·   состояние под ним
  Активное устройство не инвертируется в белое, а обводится оранжевой рамкой.

  На входе:
    tiles[]  - плитки с готовой геометрией (x, y, w, h) и данными
    width, height, rx, theme, title, updated, connected
-#}
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     class="{{ theme }}" style="--fs:{{ fs | default(1) }}" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}"
     font-family="-apple-system, 'SF Pro Display', 'SF Pro Text', 'Segoe UI', Inter, system-ui, sans-serif">

<style>
  /* ---- палитра: светлая тема ------------------------------------------ */
  svg {
    /* Масштаб типографики. В обычной плитке 1, в раскрытой на весь экран
       больше: размеры шрифтов зашиты в пикселях, и без этого подписи на
       крупной картинке выглядят микроскопическими. */
    --fs: 1;
    --bg-top:      #F1F1F3;
    --bg-bottom:   #E6E6E9;
    --tile:        #D9D9DC;   /* сама плитка */
    --edge:        rgba(60,60,67,.20);
    --edge-w:      1.5;
    --active:      #E09B2D;   /* рамка включённого устройства */
    --active-w:    3.5;
    /* Чип строки состояния: мягкая версия .plate.on. У включённой плитки
       активность показана рамкой 3.5 - для чипа высотой 36 это грубо,
       поэтому здесь заливка и тонкий контур того же семейства.
       Чернила значка гуще основного активного цвета: тонкие штрихи на
       светлом фоне выцветают там, где широкая рамка ещё читается.
       Двоеточие после имени переменной в комментариях писать нельзя -
       разбор палитры принимает это за объявление и съедает следующее. */
    --active-soft:      #EBD9B4;
    --active-soft-edge: rgba(184,121,26,.35);
    --active-ink:       #A96A0F;
    --ink:         #3A3A3E;
    --ink-dim:     #8A8A90;
    --ink-faint:   rgba(60,60,67,.34);
    --stroke:      #6E6E75;   /* иконки */
    --window:      #B4BCC7;   /* «улица» за шторой */
    --fabric:      #F0ECE5;   /* ткань */
  }
  /* ---- тёмная тема ------------------------------------------------------ */
  .dark {
    --bg-top:      #1B1B1F;
    --bg-bottom:   #101012;
    --tile:        #2C2C31;
    --edge:        rgba(255,255,255,.16);
    --edge-w:      1.5;
    --active:      #FFAE28;
    --active-w:    3.5;
    --active-soft:      #3A2E18;
    --active-soft-edge: rgba(255,174,40,.32);
    --active-ink:       #FFAE28;
    --ink:         #EDEDF0;
    --ink-dim:     rgba(255,255,255,.52);
    --ink-faint:   rgba(255,255,255,.28);
    --stroke:      #C6C6CC;
    --window:      #39404A;
    --fabric:      #7B7568;
  }

  /* ---- типографика ------------------------------------------------------ */
  .h1     { font-size: calc(26px * var(--fs)); font-weight: 700; letter-spacing: -.6px; fill: var(--ink); }
  .h1-sub { font-size: calc(13px * var(--fs)); font-weight: 500; fill: var(--ink-faint); }
  .h2     { font-size: calc(18px * var(--fs)); font-weight: 650; letter-spacing: -.3px; fill: var(--ink); }
  .name   { font-size: calc(15px * var(--fs));   font-weight: 500; fill: var(--ink); }
  .name-s { font-size: calc(11px * var(--fs));   font-weight: 500; fill: var(--ink); }
  .mid    { font-size: calc(19px * var(--fs)); font-weight: 600; fill: var(--ink);
            letter-spacing: -.4px; }
  .lvhouse{ stroke: var(--ink-faint); stroke-width: calc(1.6px * var(--fs));
            stroke-linecap: round; }
  .lvblade{ stroke: var(--stroke); stroke-width: calc(1.8px * var(--fs));
            stroke-linecap: round; }
  .on .lvblade, .wheel:not(.off) ~ * .lvblade { stroke: var(--stroke); }
  .badge-s{ font-size: calc(12px * var(--fs));   font-weight: 600; fill: var(--ink); }
  .on .name-s, .inkdark .name-s { fill: var(--ink); }
  .onlight .name-s { fill: #FFFFFF; }
  .status { font-size: calc(13.5px * var(--fs)); font-weight: 400; fill: var(--ink-dim); }
  .badge  { font-size: calc(17px * var(--fs));   font-weight: 500; fill: var(--ink); }
  .badge2 { font-size: calc(14px * var(--fs));   font-weight: 500; }
  .tag    { font-size: calc(11px * var(--fs));   font-weight: 600; fill: var(--ink-faint); letter-spacing: .4px; }

  /* ---- плитки ----------------------------------------------------------- */
  .plate     { fill: var(--tile); stroke: var(--edge); stroke-width: var(--edge-w); }
  .plate.on  { stroke: var(--active); stroke-width: var(--active-w); }
  /* только рамка, без заливки - рисуется ПОВЕРХ графика или подсветки */
  .rim       { fill: none; stroke: var(--edge); stroke-width: var(--edge-w); }
  .rim.on    { stroke: var(--active); stroke-width: var(--active-w); }
  .icon      { fill: none; stroke: var(--stroke); stroke-width: calc(1.8px * var(--fs));
               stroke-linecap: round; stroke-linejoin: round; }
  .icon-fill { fill: var(--stroke); }
  /* Фигурки человечков состоят из отдельных конечностей и при общей
     толщине выглядят жиже предметных значков - им нужна прибавка. */
  .icon-figure { stroke-width: calc(2px * var(--fs)); }
  /* Просвет под бейджем режима: без него линии корпуса просвечивают
     сквозь значок режима и всё сливается. Цвет задаётся атрибутом -
     он равен заливке чипа, а она зависит от того, активен чип или нет. */

  /* ---- чип строки состояния --------------------------------------------- */
  .chip      { fill: var(--tile); stroke: var(--edge); stroke-width: var(--edge-w); }
  .chip.on   { fill: var(--active-soft); stroke: var(--active-soft-edge); }
  .chip-val  { font-size: calc(14px * var(--fs)); font-weight: 500; fill: var(--ink); }
  /* Значки состояния красятся через currentColor, а не классом.
     Содержимое элемента use лежит в теневом дереве, и селекторы документа
     туда не достают: правило вида «.active .icon» на символ не подействует.
     Угловые скобки в этом комментарии тоже нельзя - внутри style любой
     знак «меньше» обрывает разбор XML, и librsvg молча вернёт ошибку.
     currentColor же наследуется всегда и переживает подстановку
     переменных перед отдачей SVG. */
  .sicon      { fill: none; stroke: currentColor; stroke-width: calc(1.8px * var(--fs));
                stroke-linecap: round; stroke-linejoin: round; }
  .sicon-fill { fill: currentColor; stroke: none; }
  .sicon-figure { stroke-width: calc(2px * var(--fs)); }
  .on .icon      { stroke: var(--active); }
  .on .icon-fill { fill: var(--active); }
  /* подписи и иконка поверх цветного поля ленты - всегда светлые */
  .onlight .name, .onlight .badge { fill: #FFFFFF; }
  .onlight .status                { fill: rgba(255,255,255,.72); }
  .onlight .icon                  { stroke: #FFFFFF; }
  .onlight .icon-fill             { fill: #FFFFFF; }
  .axis      { font-size: calc(9.5px * var(--fs)); font-weight: 500; fill: var(--ink);
               opacity: .55; }
  .span      { font-size: calc(12px * var(--fs)); font-weight: 500; fill: var(--ink-dim); }
  .wnow      { font-size: calc(27px * var(--fs)); font-weight: 600; letter-spacing: -.8px;
               fill: var(--ink); }
  .tick      { stroke: var(--ink); stroke-width: calc(.5px * var(--fs)); opacity: .13; }
  .tick.major{ stroke-width: calc(.9px * var(--fs)); opacity: .22; }
  .frame rect,
  .frame line{ fill: none; stroke: var(--stroke); stroke-width: calc(1.6px * var(--fs));
               opacity: .40; stroke-linecap: round; }
  .frame .sill{ stroke-width: calc(2.6px * var(--fs)); opacity: .5; }
  .hline     { stroke: var(--ink); stroke-width: calc(.5px * var(--fs)); opacity: .13; }
  .hline.edge{ opacity: .20; }
  /* циферблат термостата */
  .dial .track { fill: none; stroke: var(--ink); stroke-width: calc(7px * var(--fs));
                 stroke-linecap: round; opacity: .12; }
  .dial .fill  { fill: none; stroke: var(--stroke); stroke-width: calc(7px * var(--fs));
                 stroke-linecap: round; opacity: .55; }
  .dial.live .fill { stroke: var(--active); opacity: .95; }
  .dial .mark  { stroke: var(--ink); stroke-width: calc(2.4px * var(--fs)); stroke-linecap: round;
                 opacity: .70; }
  .dial .mark-dot { fill: var(--ink); opacity: .70; }
  .dial .mark.target { stroke: var(--active); stroke-width: calc(3.4px * var(--fs)); opacity: 1; }
  .dial.muted  { opacity: .5; }
  .dial-big    { font-size: calc(30px * var(--fs)); font-weight: 600; letter-spacing: -1px;
                 fill: var(--ink); }
  .dial-deg    { font-size: calc(18px * var(--fs)); font-weight: 500; fill: var(--ink); }
  .dial-sub    { font-size: calc(11.5px * var(--fs)); font-weight: 500; fill: var(--ink-dim); }
  .dial-mode   { font-size: calc(13px * var(--fs)); font-weight: 600; fill: var(--ink-dim); }
  .wheel.off .wlab.near { fill: var(--ink-dim); }
  /* шкала кондиционера */
  .warc        { fill: none; stroke: var(--active); stroke-width: calc(2.4px * var(--fs));
                 opacity: .85; }
  .wtick       { stroke: var(--ink); stroke-width: calc(1px * var(--fs)); opacity: .28; }
  .wtick.major { stroke-width: calc(1.6px * var(--fs)); opacity: .5; }
  .wnotch      { fill: none; stroke: var(--ink-dim); stroke-width: calc(1.5px * var(--fs));
                 stroke-linecap: round; stroke-linejoin: round; }
  .wlab        { font-size: calc(11px * var(--fs)); fill: var(--ink-faint); }
  /* выбранное значение заметно крупнее соседних - взгляд цепляется за него */
  .wlab.near   { font-size: calc(23px * var(--fs)); font-weight: 700; fill: var(--ink);
                 letter-spacing: -.5px; }
  .wheel.off   { opacity: .45; }
  .off-dim   { opacity: .55; }
  .offline   { opacity: .40; }
  .dot-warn  { fill: #E09B2D; }
  .dot-off   { fill: var(--ink-faint); }
</style>

<defs>
  <linearGradient id="{{ uid }}bg" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="var(--bg-top)"/>
    <stop offset="1" stop-color="var(--bg-bottom)"/>
  </linearGradient>

  <linearGradient id="{{ uid }}sky" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="var(--window)"/>
    <stop offset="1" stop-color="var(--window)" stop-opacity=".5"/>
  </linearGradient>

  <!-- подложки под подписи: гасят картинку сверху и снизу цветом плитки,
       чтобы текст читался поверх полноразмерного полотна в любой теме -->
  <linearGradient id="{{ uid }}scrim-t" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0"   stop-color="var(--tile)" stop-opacity=".88"/>
    <stop offset=".30" stop-color="var(--tile)" stop-opacity="0"/>
  </linearGradient>
  <linearGradient id="{{ uid }}scrim-b" x1="0" y1="0" x2="0" y2="1">
    <stop offset=".48" stop-color="var(--tile)" stop-opacity="0"/>
    <stop offset=".80" stop-color="var(--tile)" stop-opacity=".88"/>
    <stop offset="1"   stop-color="var(--tile)" stop-opacity=".96"/>
  </linearGradient>

  <!-- к низу плитки гасим картинку до цвета подложки, чтобы подписи читались -->
  <linearGradient id="{{ uid }}scrim" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0"   stop-color="var(--tile)" stop-opacity="0"/>
    <stop offset=".45" stop-color="var(--tile)" stop-opacity=".45"/>
    <stop offset=".74" stop-color="var(--tile)" stop-opacity=".90"/>
    <stop offset="1"   stop-color="var(--tile)" stop-opacity="1"/>
  </linearGradient>

  <!-- поле ленты: слева холодный, справа тёплый (заливается per-tile) -->
  <linearGradient id="{{ uid }}dim" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0"   stop-color="#0A0A0C" stop-opacity="0"/>
    <stop offset=".50" stop-color="#0A0A0C" stop-opacity=".30"/>
    <stop offset="1"   stop-color="#0A0A0C" stop-opacity=".78"/>
  </linearGradient>

  <linearGradient id="{{ uid }}foldL" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="#000" stop-opacity="0"/>
    <stop offset="1" stop-color="#000" stop-opacity=".20"/>
  </linearGradient>
  <linearGradient id="{{ uid }}foldR" x1="1" y1="0" x2="0" y2="0">
    <stop offset="0" stop-color="#000" stop-opacity="0"/>
    <stop offset="1" stop-color="#000" stop-opacity=".20"/>
  </linearGradient>

  <pattern id="{{ uid }}weave" width="7" height="7" patternUnits="userSpaceOnUse">
    <rect width="7" height="7" fill="var(--fabric)"/>
    <line x1="0" y1="0" x2="0" y2="7" stroke="rgba(0,0,0,.09)" stroke-width="1.6"/>
  </pattern>

  <!-- иконки: единый бокс 24x24, только штрихи -->
  <symbol id="{{ uid }}ic-power" viewBox="0 0 24 24">
    <path class="icon" d="M12 3.5v8"/>
    <path class="icon" d="M7.2 6.6a7.2 7.2 0 1 0 9.6 0"/>
  </symbol>
  <symbol id="{{ uid }}ic-bulb" viewBox="0 0 24 24">
    <path class="icon" d="M12 3.2a5.7 5.7 0 0 0-3.3 10.3c.6.4.9 1 .9 1.7v.4h4.8v-.4c0-.7.3-1.3.9-1.7A5.7 5.7 0 0 0 12 3.2z"/>
    <path class="icon" d="M9.9 18.7h4.2M10.7 21h2.6"/>
  </symbol>
  <symbol id="{{ uid }}ic-strip" viewBox="0 0 24 24">
    <path class="icon" d="M3 8.5h18v3.2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
    <path class="icon" d="M6.5 14v2.6M12 14v3.6M17.5 14v2.6"/>
  </symbol>
  <symbol id="{{ uid }}ic-curtain" viewBox="0 0 24 24">
    <path class="icon" d="M3 4.5h18"/>
    <path class="icon" d="M6 4.5v15c2.6-.6 3.6-2.9 3.6-6.2V4.5"/>
    <path class="icon" d="M18 4.5v15c-2.6-.6-3.6-2.9-3.6-6.2V4.5"/>
  </symbol>
  <symbol id="{{ uid }}ic-blind" viewBox="0 0 24 24">
    <path class="icon" d="M3 4.2h18M3 8.2h18M3 12.2h18"/>
    <path class="icon" d="M12 12.2v7.4"/>
    <circle class="icon-fill" cx="12" cy="20.4" r="1.7"/>
  </symbol>
  <symbol id="{{ uid }}ic-thermo" viewBox="0 0 24 24">
    <path class="icon" d="M14 14.2V5.4a2 2 0 1 0-4 0v8.8a4.2 4.2 0 1 0 4 0z"/>
  </symbol>
  <symbol id="{{ uid }}ic-drop" viewBox="0 0 24 24">
    <path class="icon" d="M12 3.2s5.4 6 5.4 9.5a5.4 5.4 0 1 1-10.8 0C6.6 9.2 12 3.2 12 3.2z"/>
  </symbol>
  <symbol id="{{ uid }}ic-co2" viewBox="0 0 24 24">
    <path class="icon" d="M6.6 17.5a3.9 3.9 0 0 1-.5-7.8 5.3 5.3 0 0 1 10.2-1.2 3.6 3.6 0 0 1 1.2 7z"/>
    <path class="icon" d="M9.4 20.6h6.4"/>
  </symbol>
  <symbol id="{{ uid }}ic-leaf" viewBox="0 0 24 24">
    <path class="icon" d="M20 4c0 8.3-4.2 12.8-9.6 12.8A5.4 5.4 0 0 1 5 11.4C5 6.4 11.6 4.6 20 4z"/>
    <path class="icon" d="M4.2 20.2C6.6 15.4 10.4 11.6 15.4 9"/>
  </symbol>
  <symbol id="{{ uid }}ic-wind" viewBox="0 0 24 24">
    <path class="icon" d="M3 8.6h10.2a2.9 2.9 0 1 0-2.9-2.9"/>
    <path class="icon" d="M3 13.4h13.6a2.9 2.9 0 1 1-2.9 2.9"/>
    <path class="icon" d="M3 18.2h7"/>
  </symbol>
  <symbol id="{{ uid }}ic-window" viewBox="0 0 24 24">
    <rect class="icon" x="3.5" y="3.5" width="17" height="17" rx="2"/>
    <path class="icon" d="M12 3.5v17M3.5 12h17"/>
  </symbol>
  <symbol id="{{ uid }}ic-fan" viewBox="0 0 24 24">
    <circle class="icon" cx="12" cy="12" r="2.1"/>
    <path class="icon" d="M12 9.9C12 6.4 9.6 3.5 12 3.5s4.4 2.2 2.2 4.6"/>
    <path class="icon" d="M14.1 12c3.5 0 6.4-2.4 6.4 0s-2.2 4.4-4.6 2.2"/>
    <path class="icon" d="M12 14.1c0 3.5 2.4 6.4 0 6.4s-4.4-2.2-2.2-4.6"/>
    <path class="icon" d="M9.9 12c-3.5 0-6.4 2.4-6.4 0s2.2-4.4 4.6-2.2"/>
  </symbol>
  <symbol id="{{ uid }}ic-heat" viewBox="0 0 24 24">
    <path class="icon" d="M8 3.4c-2 2.4-.6 3.9.4 5.2 1 1.3 1.6 3-.4 5"/>
    <path class="icon" d="M15.6 3.4c-2 2.4-.6 3.9.4 5.2 1 1.3 1.6 3-.4 5"/>
    <path class="icon" d="M4.5 20.6h15"/>
  </symbol>
  <symbol id="{{ uid }}ic-tap" viewBox="0 0 24 24">
    <path class="icon" d="M4 12h6.4a3 3 0 0 1 3 3v.8"/>
    <path class="icon" d="M10.4 12V8.6a3 3 0 0 1 3-3H20"/>
    <path class="icon" d="M17 5.6v6"/>
    <path class="icon" d="M13.4 18.2s2 2.1 2 3.1a2 2 0 1 1-4 0c0-1 2-3.1 2-3.1z"/>
  </symbol>
  <symbol id="{{ uid }}ic-sun" viewBox="0 0 24 24">
    <circle class="icon" cx="12" cy="12" r="4.2"/>
    <path class="icon" d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"/>
  </symbol>
  <symbol id="{{ uid }}ic-moon" viewBox="0 0 24 24">
    <path class="icon" d="M20.4 14.6A8.6 8.6 0 0 1 9.4 3.6a8.6 8.6 0 1 0 11 11z"/>
  </symbol>
  <symbol id="{{ uid }}ic-tv" viewBox="0 0 24 24">
    <rect class="icon" x="2.8" y="4.4" width="18.4" height="12.4" rx="2"/>
    <path class="icon" d="M8.4 20.4h7.2"/>
  </symbol>
  <symbol id="{{ uid }}ic-door" viewBox="0 0 24 24">
    <path class="icon" d="M5.6 3.6h12.8v16.8H5.6z"/>
    <circle class="icon-fill" cx="15" cy="12" r="1.1"/>
  </symbol>
  {#- Фигурки: позы срисованы с пешеходного светофора и знака «Осторожно,
      дети» - эти силуэты узнаются без разглядывания. Поправки центровки
      уже внесены в координаты, чтобы макрос о них не помнил. -#}
  <symbol id="{{ uid }}ic-motion" viewBox="0 0 24 24">
    <circle class="sicon-fill" cx="15.2" cy="4.6" r="2.3"/>
    <path class="sicon sicon-figure" d="M14 7.7 11.5 13.6"/>
    <path class="sicon sicon-figure" d="M14 8.5 8.9 8.9 9.2 12.3"/>
    <path class="sicon sicon-figure" d="M14 8.5 15.8 12.9 18.8 10.4"/>
    <path class="sicon sicon-figure" d="M11.5 13.6 8.7 17.2 5.2 15.8"/>
    <path class="sicon sicon-figure" d="M11.5 13.6 15.1 15.4 15.2 20.7"/>
  </symbol>
  <symbol id="{{ uid }}ic-person" viewBox="0 0 24 24">
    <circle class="sicon-fill" cx="11.8" cy="4.6" r="2.3"/>
    <path class="sicon sicon-figure" d="M11.8 6.8 11.8 12.4"/>
    <path class="sicon sicon-figure" d="M11.8 7.5 7.3 10.4 9.2 13.4"/>
    <path class="sicon sicon-figure" d="M11.8 7.5 16.7 10.5 14.2 13.6"/>
    <path class="sicon sicon-figure" d="M11.8 12.4 9.9 16.5 9.7 20.6"/>
    <path class="sicon sicon-figure" d="M11.8 12.4 13.7 16.8 13.7 20.7"/>
  </symbol>
  {#- Распахнутая дверь: широкий проём, створка в перспективе.
      Закрытую показывать незачем, поэтому второго состояния нет. -#}
  <symbol id="{{ uid }}ic-door-open" viewBox="0 0 24 24">
    <path class="sicon" d="M3.2 3.2h10v17.6h-10z"/>
    <path class="sicon" d="M13.2 5 20.6 2.6v18.8L13.2 19z"/>
    <circle class="sicon-fill" cx="14.9" cy="12.4" r="0.9"/>
  </symbol>
  {#- Протечка: капля заливкой плюс рябь - от простой капли отличается
      сразу, а простая капля уже занята влажностью. -#}
  <symbol id="{{ uid }}ic-leak" viewBox="0 0 24 24">
    <path class="sicon-fill" d="M12 2.6s5.2 5.8 5.2 9.2a5.2 5.2 0 1 1-10.4 0C6.8 8.4 12 2.6 12 2.6z"/>
    <path class="sicon" d="M4.6 20.6c1.5 1.3 3 1.3 4.5 0s3-1.3 4.5 0 3 1.3 4.5 0"/>
  </symbol>
  {#- Устройства: корпус узнаётся по силуэту, режим читается бейджем.
      Сдвиг вправо оптический - масса корпуса лежит левее середины. -#}
  <symbol id="{{ uid }}ic-ac-unit" viewBox="0 0 24 24">
    <g transform="translate(0.5,-0.4)">
      <rect class="sicon" x="2.6" y="4.2" width="14.6" height="6.4" rx="2"/>
      <path class="sicon" d="M5.2 8.8h9.4"/>
      <path class="sicon" d="M4.4 14.2c1.2 1.1 2.4 1.1 3.6 0s2.4-1.1 3.6 0"/>
    </g>
  </symbol>
  <symbol id="{{ uid }}ic-vacuum" viewBox="0 0 24 24">
    <g transform="translate(0.3,-1)">
      <circle class="sicon" cx="10.4" cy="12" r="7.3"/>
      <path class="sicon" d="M3.6 9.2a7.3 7.3 0 0 1 13.6 0"/>
      <circle class="sicon" cx="10.4" cy="15.4" r="1.5"/>
    </g>
  </symbol>
  <symbol id="{{ uid }}ic-snow" viewBox="0 0 24 24">
    <path class="icon" d="M12 2.6v18.8M3.8 7.3l16.4 9.4M20.2 7.3L3.8 16.7"/>
    <path class="icon" d="M12 6.2 9.7 4M12 6.2 14.3 4M12 17.8l-2.3 2.2M12 17.8l2.3 2.2"/>
    <path class="icon" d="m6.9 9.1-3-.5M6.9 9.1 6 6.3M17.1 14.9l3 .5M17.1 14.9l.9 2.8"/>
    <path class="icon" d="m17.1 9.1 3-.5M17.1 9.1 18 6.3M6.9 14.9l-3 .5M6.9 14.9 6 17.7"/>
  </symbol>
  <symbol id="{{ uid }}ic-swing" viewBox="0 0 24 24">
    <path class="icon" d="M4 5.5h16M4 10h16"/>
    <path class="icon" d="M9 14.5c1.6 1.4 4.4 1.4 6 0"/>
    <path class="icon" d="M7.5 18.5c2.6 2 6.4 2 9 0"/>
  </symbol>
  <symbol id="{{ uid }}ic-next" viewBox="0 0 24 24">
    <path class="icon" d="M9 5.5 16.5 12 9 18.5"/>
  </symbol>
  {#- Бейджи режима. Рисуются в своей сетке 12x12 и ставятся в правый
      нижний угол корпуса: один корпус, сменный бейдж - новые режимы
      добавляются, не изобретая каждый раз новый значок. -#}
  <symbol id="{{ uid }}bg-snow" viewBox="0 0 12 12">
    <path class="sicon" d="M6 1.4v9.2M2.1 3.7l7.8 4.6M9.9 3.7 2.1 8.3"/>
  </symbol>
  <symbol id="{{ uid }}bg-heat" viewBox="0 0 12 12">
    <path class="sicon" d="M6 10.4V3.1M6 3.1 3.6 5.5M6 3.1l2.4 2.4"/>
    <path class="sicon" d="M3.2 8.6h5.6"/>
  </symbol>
  <symbol id="{{ uid }}bg-water" viewBox="0 0 12 12">
    <path class="sicon-fill" d="M6 1.6s2.8 3.1 2.8 4.9a2.8 2.8 0 1 1-5.6 0C3.2 4.7 6 1.6 6 1.6z"/>
  </symbol>
  <symbol id="{{ uid }}bg-fan" viewBox="0 0 12 12">
    <circle class="sicon" cx="6" cy="6" r="1.1"/>
    <path class="sicon" d="M6 4.9C6 3.1 4.9 1.6 6 1.6s2.1 1 1 2.3"/>
    <path class="sicon" d="M7.1 6c1.8 0 3.3-1.1 3.3 0s-1 2.1-2.3 1"/>
    <path class="sicon" d="M6 7.1c0 1.8 1.1 3.3 0 3.3s-2.1-1-1-2.3"/>
    <path class="sicon" d="M4.9 6c-1.8 0-3.3 1.1-3.3 0s1-2.1 2.3-1"/>
  </symbol>
  {#- Авто: буква, а не картинка. Режим «сам разберётся» рисунком не
      выразить, а буква А узнаётся мгновенно и на всех языках. -#}
  <symbol id="{{ uid }}bg-auto" viewBox="0 0 12 12">
    <path class="sicon" d="M3.1 9.4 6 2.6l2.9 6.8"/>
    <path class="sicon" d="M4.3 7.3h3.4"/>
  </symbol>
  <symbol id="{{ uid }}bg-home" viewBox="0 0 12 12">
    <path class="sicon" d="M2.2 6 6 2.8 9.8 6"/>
    <path class="sicon" d="M3.4 6.4v3.4h5.2V6.4"/>
  </symbol>
  <symbol id="{{ uid }}ic-socket" viewBox="0 0 24 24">
    <rect class="icon" x="3.5" y="3.5" width="17" height="17" rx="5"/>
    <path class="icon" d="M9.5 9.8v2.4M14.5 9.8v2.4"/>
  </symbol>

{% for t in tiles %}
  {#- обрезаем ЧУТЬ внутрь контура: рамка рисуется поверх и раньше
      съедала первую и последнюю точку графика -#}
  <clipPath id="{{ uid }}clip{{ t.i }}">
    <rect x="2" y="2" width="{{ t.w - 4 }}" height="{{ t.h - 4 }}" rx="{{ rx - 1 }}"/>
  </clipPath>
{% endfor %}
</defs>


{#- ==================== макросы ==================== -#}

{% macro plate(t) %}
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        class="plate {{ 'on' if t.on }}"/>
{% endmacro %}

{#- Значок устройства с бейджем режима в правом нижнем углу.
    Просвет под бейджем красится в цвет подложки чипа, поэтому значки
    устройств всегда живут внутри chip() - иначе цвет угадать нельзя. -#}
{% macro icon_badge(name, badge, size=26, knock='var(--tile)', badge_color=None) %}
  {% set s = size / 24.0 %}
  <use href="#{{ uid }}ic-{{ name }}" xlink:href="#{{ uid }}ic-{{ name }}"
       width="{{ size }}" height="{{ size }}"/>
  {% if badge %}
  <circle fill="{{ knock }}" stroke="none" cx="{{ 18.1 * s }}" cy="{{ 17.4 * s }}"
          r="{{ 5.4 * s }}"/>
  {#- Бейдж режима красится отдельно от корпуса: корпус говорит «что это»,
      цвет бейджа - «что оно делает». Синий холод, красный тепло, зелёный
      обдув читаются без подписей. -#}
  <g{% if badge_color %} color="{{ badge_color }}"{% endif %}>
    <use href="#{{ uid }}bg-{{ badge }}" xlink:href="#{{ uid }}bg-{{ badge }}"
         x="{{ 12.1 * s }}" y="{{ 11.4 * s }}"
         width="{{ 12 * s }}" height="{{ 12 * s }}"/>
  </g>
  {% endif %}
{% endmacro %}

{#- Чип строки состояния: маленькая плитка со значком и, если нужно,
    числом. Высота 36, радиус 10 - те же пропорции, что у больших плашек
    (RX 24 при высоте 170). Поля: 10 слева, 6 до числа, 12 справа -
    цифры прямоугольные и липнут к краю сильнее, чем скруглённый значок.
    active тонирует чип, как .plate.on тонирует плитку. -#}
{% macro chip(name, value=None, badge=None, active=False, w=None, badge_color=None) %}
  {% set icon_size = 26 %}
  {#- Поля разные для двух случаев. Со значком и числом: 10 слева, 6 между,
      12 справа - цифры прямоугольные и липнут к краю сильнее, чем
      скруглённый значок. Без числа значок просто центрируется: поля 10 и 4
      выглядят как перекос вправо. -#}
  {% set pad_l = 10 if value else 7 %}
  {% set text_w = (value|length * 8.5) if value else 0 %}
  {% set width = w or (pad_l + icon_size + (6 + text_w + 12 if value else 7)) %}
  {% set ink = 'var(--active-ink)' if active else 'var(--stroke)' %}
  {% set knock = 'var(--active-soft)' if active else 'var(--tile)' %}
  <g color="{{ ink }}">
    <rect class="chip {{ 'on' if active }}" x="0.75" y="0.75"
          width="{{ width - 1.5 }}" height="34.5" rx="10"/>
    <g transform="translate({{ pad_l }},5)">
      {{ icon_badge(name, badge, icon_size, knock, badge_color) }}
    </g>
    {% if value %}
    <text class="chip-val" x="{{ width - 12 }}" y="23" text-anchor="end">{{ value }}</text>
    {% endif %}
  </g>
{% endmacro %}

{% macro icon(name, size=27) %}
  {% if t is defined %}{% endif %}
  <use href="#{{ uid }}ic-{{ name }}" xlink:href="#{{ uid }}ic-{{ name }}"
       x="18" y="17" width="{{ size }}" height="{{ size }}"/>
{% endmacro %}

{#- мелкая плитка: иконка по центру сверху, короткая подпись снизу -#}
{% macro icon_c(t, name, size=24) %}
  {% if t.compact %}
  <use href="#{{ uid }}ic-{{ name }}" xlink:href="#{{ uid }}ic-{{ name }}"
       x="{{ (t.w - size) / 2 }}" y="14" width="{{ size }}" height="{{ size }}"/>
  {% else %}
  <use href="#{{ uid }}ic-{{ name }}" xlink:href="#{{ uid }}ic-{{ name }}"
       x="18" y="17" width="{{ size + 3 }}" height="{{ size + 3 }}"/>
  {% endif %}
{% endmacro %}

{#- тумблер как на скриншотах: пилюля с бегунком, бегунок уезжает вправо -#}
{% macro toggle(t) %}
  <g transform="translate(18,20)">
    <rect x="0" y="0" width="34" height="20" rx="10" fill="none"
          stroke="{{ 'var(--active)' if t.on else 'var(--stroke)' }}" stroke-width="2.2"/>
    <circle cx="{{ 23 if t.on else 11 }}" cy="10" r="6.2"
            fill="{{ 'var(--active)' if t.on else 'var(--stroke)' }}"/>
  </g>
{% endmacro %}

{% macro value_tr(t) %}
  {% if t.short and not t.compact %}
  <text x="{{ t.w - 20 }}" y="41" class="badge" text-anchor="end">{{ t.short }}</text>
  {% endif %}
{% endmacro %}

{#- название всегда; вторая строка - только если её попросили -#}
{#- Заголовок: одна строка или несколько, если в названии есть перенос.
    Строки идут снизу вверх, чтобы низ плитки оставался на месте. -#}
{% macro title_text(t, x, y, cls, anchor='start') %}
  {% set lines = t.title_lines or [t.title] %}
  {% for line in lines %}
  <text x="{{ x }}" y="{{ y - (lines|length - 1 - loop.index0) * 17 }}"
        class="{{ cls }}" text-anchor="{{ anchor }}">{{ line }}</text>
  {% endfor %}
{% endmacro %}

{% macro caption(t, status) %}
  {% if t.compact %}
  <text x="{{ t.w / 2 }}" y="{{ t.h - 13 }}" class="name-s" text-anchor="middle">{{ t.title_s or t.title }}</text>
  {% elif status and (t.show_status or t.always_status) %}
  {{ title_text(t, 20, t.h - 40, 'name') }}
  <text x="20" y="{{ t.h - 18 }}" class="status">{{ status }}</text>
  {% else %}
  {{ title_text(t, 20, t.h - 20, 'name') }}
  {% endif %}
{% endmacro %}

{#- Индикатор состояния данных:
      серая точка  - канала нет в MQTT или у него флаг ошибки
      жёлтая точка - значение не обновлялось дольше 5 минут
    На обычной плитке живёт над подписью справа, на мелкой - в верхнем
    углу, иначе налезает на текст, который там по центру. -#}
{% macro badge_dot(t) %}
  {% set cx = (t.w - 12) if t.compact else (t.w - 20) %}
  {% set cy = 12 if t.compact else (t.h - 22) %}
  {% set r = 3 if t.compact else 3.5 %}
  {% if t.offline %}
  <circle cx="{{ cx }}" cy="{{ cy }}" r="{{ r }}" class="dot-off"/>
  {% elif t.stale %}
  <circle cx="{{ cx }}" cy="{{ cy }}" r="{{ r }}" class="dot-warn"/>
  {% endif %}
{% endmacro %}


{#- ---- график: от рамки до рамки, заливка до пола ---- -#}
{% macro tile_chart(t) %}
  {{ plate(t) }}
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    {#- сетка: часы по вертикали, шкала значений по горизонтали.
        Шаг шкалы общий для всех рядов плитки, поэтому линии совпадают. -#}
    {% for tk in t.ticks %}
    <line x1="{{ tk.x }}" y1="0" x2="{{ tk.x }}" y2="{{ t.h }}"
          class="tick{{ ' major' if tk.major }}"/>
    {% endfor %}
    {% for hl in t.hlines %}
    <line x1="0" y1="{{ hl.y }}" x2="{{ t.w }}" y2="{{ hl.y }}"
          class="hline{{ ' edge' if hl.edge }}"/>
    {% endfor %}
    {% if t.grid_labels %}
      {#- первая серия подписана слева, вторая справа, каждая своим цветом -#}
      {% for s in t.series %}
        {% set first = loop.first %}
        {% for lb in s.labels %}
          {% if first %}
        <text x="7" y="{{ lb.y - 3 }}" class="axis" fill="{{ s.text_color }}">{{ lb.text }}</text>
          {% else %}
        <text x="{{ t.w - 7 }}" y="{{ lb.y - 3 }}" text-anchor="end"
              class="axis" fill="{{ s.text_color }}">{{ lb.text }}</text>
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% endif %}
    {% if t.time_labels %}
      {% for tm in t.times %}
      <text x="{{ tm.x }}" y="{{ t.h * 0.82 - 3 }}" class="axis"
            text-anchor="{{ tm.anchor }}">{{ tm.text }}</text>
      {% endfor %}
    {% endif %}
    {% for s in t.series %}
      {% if s.geom %}
      <linearGradient id="{{ uid }}fade{{ t.i }}-{{ loop.index }}" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0"   stop-color="{{ s.color }}" stop-opacity=".42"/>
        <stop offset=".55" stop-color="{{ s.color }}" stop-opacity=".16"/>
        <stop offset="1"   stop-color="{{ s.color }}" stop-opacity=".04"/>
      </linearGradient>
      <path d="{{ s.geom.area }}" fill="url(#{{ uid }}fade{{ t.i }}-{{ loop.index }})"/>
      <path d="{{ s.geom.line }}" fill="none" stroke="{{ s.color }}"
            stroke-width="{{ 2.4 * (fs | default(1)) }}"
            stroke-linecap="round" stroke-linejoin="round"/>
      {% endif %}
    {% endfor %}
  </g>
  {# рамку рисуем поверх заливки, чтобы она осталась чёткой #}
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}" class="rim"/>

  {{ icon_c(t, t.icon or 'thermo', 24) }}
  {% for s in t.series %}
  <text x="{{ t.w - 20 }}" y="{{ 41 + loop.index0 * 23 }}" text-anchor="end"
        class="{{ 'badge' if loop.first else 'badge2' }}"
        fill="{{ s.text_color }}">{{ s.value }} {{ s.unit }}</text>
  {% endfor %}
  {% if not t.series or not t.series[0].geom %}
  <text x="20" y="{{ t.h / 2 }}" class="status">нет истории</text>
  {% endif %}
  {{ caption(t, t.subtitle or t.range_label|upper) }}
  {% if t.show_span and t.scale_note %}
  <text x="{{ t.title_dx }}" y="{{ t.h - 20 }}" class="span">{{ t.scale_note }}</text>
  {% endif %}
{% endmacro %}


{#- ---- выключатель ---- -#}
{% macro tile_switch(t) %}
  {{ plate(t) }}
  {% if t.icon == 'toggle' and not t.compact %}
    {{ toggle(t) }}
  {% else %}
    {{ icon_c(t, t.icon if t.icon != 'toggle' else 'power', 24) }}
  {% endif %}
  {{ value_tr(t) }}
  {{ caption(t, t.status) }}
{% endmacro %}


{#- ---- раздвижные шторы ----
    Створки занимают всю плитку и едут от краёв к центру. Ширина каждой
    пропорциональна тому, насколько она НЕ открыта. К низу картинка гаснет
    до цвета подложки - там лежат подписи. -#}
{% macro tile_curtain(t) %}
  {% set half = t.w / 2.0 %}
  {% set lw = half * (1 - t.left_open) %}
  {% set rw = half * (1 - t.right_open) %}
  {{ plate(t) }}
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    <rect width="{{ t.w }}" height="{{ t.h }}" fill="url(#{{ uid }}sky)"/>

    {#- силуэт окна: раму видно в проёме между створками,
        поэтому сразу понятно, что это шторы, а не заливка -#}
    {% set fx = t.w * 0.16 %}
    {% set fy = t.h * 0.12 %}
    {% set fw = t.w * 0.68 %}
    {% set fh = t.h * 0.60 %}
    <g class="frame">
      <rect x="{{ '%.1f'|format(fx) }}" y="{{ '%.1f'|format(fy) }}"
            width="{{ '%.1f'|format(fw) }}" height="{{ '%.1f'|format(fh) }}" rx="2"/>
      <line x1="{{ '%.1f'|format(fx + fw / 2) }}" y1="{{ '%.1f'|format(fy) }}"
            x2="{{ '%.1f'|format(fx + fw / 2) }}" y2="{{ '%.1f'|format(fy + fh) }}"/>
      <line x1="{{ '%.1f'|format(fx) }}" y1="{{ '%.1f'|format(fy + fh * 0.42) }}"
            x2="{{ '%.1f'|format(fx + fw) }}" y2="{{ '%.1f'|format(fy + fh * 0.42) }}"/>
      <line x1="{{ '%.1f'|format(fx - t.w * 0.05) }}" y1="{{ '%.1f'|format(fy + fh) }}"
            x2="{{ '%.1f'|format(fx + fw + t.w * 0.05) }}" y2="{{ '%.1f'|format(fy + fh) }}"
            class="sill"/>
    </g>

    {% if lw > 1 %}
    <rect x="0" y="0" width="{{ '%.1f'|format(lw) }}" height="{{ t.h }}" fill="url(#{{ uid }}weave)"/>
    <rect x="{{ '%.1f'|format([lw - 12, 0]|max) }}" y="0"
          width="{{ '%.1f'|format([lw, 12]|min) }}" height="{{ t.h }}" fill="url(#{{ uid }}foldL)"/>
    {% endif %}

    {% if rw > 1 %}
    <rect x="{{ '%.1f'|format(t.w - rw) }}" y="0"
          width="{{ '%.1f'|format(rw) }}" height="{{ t.h }}" fill="url(#{{ uid }}weave)"/>
    <rect x="{{ '%.1f'|format(t.w - rw) }}" y="0"
          width="{{ '%.1f'|format([rw, 12]|min) }}" height="{{ t.h }}" fill="url(#{{ uid }}foldR)"/>
    {% endif %}

    {# гашение к низу под подписи #}
    <rect width="{{ t.w }}" height="{{ t.h }}" fill="url(#{{ uid }}scrim)"/>
  </g>
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        class="rim {{ 'on' if t.on }}"/>
  {{ icon_c(t, t.icon or 'blind', 22) }}
  {{ value_tr(t) }}
  {{ caption(t, t.status) }}
{% endmacro %}


{#- ---- светодиодная лента ----
    Плитка - это поле из двух осей:
      X: слева холодный свет, справа тёплый
      Y: сверху ярко, снизу темно
    Точка показывает фактическое положение, оранжевая рамка - что лента включена. -#}
{% macro tile_light(t) %}
  {{ plate(t) }}
  <linearGradient id="{{ uid }}cct{{ t.i }}" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="{{ t.cold }}"/>
    <stop offset="1" stop-color="{{ t.warm }}"/>
  </linearGradient>
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    {#- включена - полная насыщенность; выключена - бледное поле,
        чтобы на общей панели не бросалась в глаза -#}
    <rect width="{{ t.w }}" height="{{ t.h }}" fill="url(#{{ uid }}cct{{ t.i }})"
          opacity="{{ '1' if t.on else '.34' }}"/>
    <rect width="{{ t.w }}" height="{{ t.h }}" fill="url(#{{ uid }}dim)"
          opacity="{{ '1' if t.on else '.55' }}"/>
    {% if t.has_dot %}
      {% set dx = 16 + t.dot_x * (t.w - 32) %}
      {% set dy = 16 + t.dot_y * (t.h - 32) %}
      {# перекрестье помогает считать положение по осям #}
      <line x1="{{ '%.1f'|format(dx) }}" y1="0"
            x2="{{ '%.1f'|format(dx) }}" y2="{{ t.h }}"
            stroke="#FFF" stroke-width="1" opacity=".26"/>
      <line x1="0" y1="{{ '%.1f'|format(dy) }}"
            x2="{{ t.w }}" y2="{{ '%.1f'|format(dy) }}"
            stroke="#FFF" stroke-width="1" opacity=".26"/>
      <g opacity="{{ '1' if t.on else '.55' }}">
        <circle cx="{{ '%.1f'|format(dx) }}" cy="{{ '%.1f'|format(dy) }}" r="9.5"
                fill="{{ t.color }}" stroke="#FFF" stroke-width="2.6"/>
        <circle cx="{{ '%.1f'|format(dx) }}" cy="{{ '%.1f'|format(dy) }}" r="9.5"
                fill="none" stroke="#000" stroke-width="1" opacity=".22"/>
      </g>
    {% endif %}
  </g>
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        class="rim {{ 'on' if t.on }}"/>
  <g class="{{ 'onlight' if t.on }}">
    {{ icon_c(t, t.icon or 'strip', 25) }}
    {#- на мелкой плитке цифру не пишем: поле «холодный-тёплый» и положение
        точки уже показывают и яркость, и температуру -#}
    {% if not t.compact %}
    {% set label = t.short if t.w >= 260 else t.short_min %}
    {% if label %}
    <text x="{{ t.w - 20 }}" y="41" class="badge" text-anchor="end">{{ label }}</text>
    {% endif %}
    {% endif %}
    {{ caption(t, t.status) }}
  </g>
{% endmacro %}


{#- ---- диммируемый светильник ----
    Одна величина, поэтому просто заливка снизу вверх на высоту яркости. -#}
{% macro tile_dimmer(t) %}
  {{ plate(t) }}
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    <rect x="0" y="{{ '%.1f'|format(t.h * (1 - t.fill)) }}"
          width="{{ t.w }}" height="{{ '%.1f'|format(t.h * t.fill) }}"
          fill="{{ t.color }}" opacity=".55"/>
    <rect x="0" y="{{ '%.1f'|format(t.h * (1 - t.fill) - 1) }}"
          width="{{ t.w }}" height="2" fill="{{ t.color }}" opacity=".9"/>
  </g>
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        class="rim {{ 'on' if t.on }}"/>
  {{ icon_c(t, t.icon or 'bulb', 24) }}
  {{ value_tr(t) }}
  {#- на мелкой плитке цифра в углу не помещается - ставим по центру -#}
  {% if t.compact and t.short %}
  <text x="{{ t.w / 2 }}" y="{{ '%.0f'|format(t.h * 0.66) }}" class="mid"
        text-anchor="middle">{{ t.short }}</text>
  {% endif %}
  {{ caption(t, t.status) }}
{% endmacro %}


{#- ---- термостат ----
    Циферблат: незамкнутая дуга со шкалой, закрашен участок МЕЖДУ
    фактической температурой и уставкой - тот самый разрыв, который
    прибору предстоит закрыть. Две засечки отмечают обе границы,
    в разрыве дуги снизу стоит режим работы. -#}
{% macro tile_thermostat(t) %}
  {{ plate(t) }}
  {% if t.dial and not t.compact %}
    <g class="dial {{ 'live' if t.on }} {{ 'muted' if not t.enabled }}">
      {% if t.dial.track %}<path d="{{ t.dial.track }}" class="track"/>{% endif %}
      {% if t.dial.fill %}<path d="{{ t.dial.fill }}" class="fill"/>{% endif %}
      {% for m in t.dial.marks %}
      <line x1="{{ m.x1 }}" y1="{{ m.y1 }}" x2="{{ m.x2 }}" y2="{{ m.y2 }}"
            class="mark {{ m.kind }}"/>
      {% if m.kind == 'current' %}
      {#- точка на конце: риска текущей температуры не теряется на заливке -#}
      <circle cx="{{ m.x2 }}" cy="{{ m.y2 }}" r="2.6" class="mark-dot"/>
      {% endif %}
      {% endfor %}
    </g>
    {#- центрируем ЧИСЛО, знак градуса приписываем за ним: иначе широкий "°"
        перетягивает центровку и цифра кажется сдвинутой влево -#}
    <g {% if not t.enabled %}opacity=".5"{% endif %}>
      <text x="{{ t.dial.cx }}" y="{{ t.dial.cy + 6 }}" class="dial-big"
            text-anchor="middle">{{ t.target_num }}</text>
      {% if t.target_num != '--' %}
      <text x="{{ t.dial.cx + t.deg_dx }}" y="{{ t.dial.cy - 8 }}" class="dial-deg">°</text>
      {% endif %}
    </g>
    {% if t.current %}
    <text x="{{ t.dial.cx }}" y="{{ t.dial.cy + 27 }}" class="dial-sub"
          text-anchor="middle">сейчас {{ t.current }}</text>
    {% endif %}
    <text x="{{ t.w / 2 }}" y="20" class="tag" text-anchor="middle">{{ t.title|upper }}</text>
    <text x="{{ t.w / 2 }}" y="{{ t.h - 16 }}" class="dial-mode"
          text-anchor="middle">{{ t.status }}</text>
  {% else %}
    {{ icon_c(t, t.icon or 'heat', 24) }}
    {% if t.current and not t.compact %}
    <text x="{{ t.w - 20 }}" y="41" class="badge" text-anchor="end">{{ t.current }}</text>
    {% endif %}
    {% if not t.compact %}
    <text x="20" y="{{ t.h - 62 }}" class="big"
          {% if not t.enabled %}opacity=".5"{% endif %}>{{ t.target }}</text>
    {% endif %}
    {{ caption(t, t.status) }}
  {% endif %}
{% endmacro %}


{#- ---- погода: текущая слева, прогноз кривой ----
    Данные не из истории, а из каналов temp_00…temp_NN виртуального
    устройства: это прогноз вперёд, а не прошлое. Сетка и подписи - те же,
    что у обычных графиков, чтобы плитки читались одинаково. -#}
{% macro tile_forecast(t) %}
  {{ plate(t) }}
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    {#- сетка: часы по вертикали, шкала по горизонтали -#}
    {% for tk in t.ticks %}
    <line x1="{{ tk.x }}" y1="0" x2="{{ tk.x }}" y2="{{ t.h }}"
          class="tick{{ ' major' if tk.major }}"/>
    {% endfor %}
    {% for hl in t.hlines %}
    <line x1="0" y1="{{ hl.y }}" x2="{{ t.w }}" y2="{{ hl.y }}"
          class="hline{{ ' edge' if hl.edge }}"/>
    {% endfor %}
    {% if t.geom %}
    <linearGradient id="{{ uid }}wfade{{ t.i }}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0"   stop-color="#5AA9E6" stop-opacity=".34"/>
      <stop offset=".55" stop-color="#5AA9E6" stop-opacity=".12"/>
      <stop offset="1"   stop-color="#5AA9E6" stop-opacity=".02"/>
    </linearGradient>
    <path d="{{ t.geom.area }}" fill="url(#{{ uid }}wfade{{ t.i }})"/>
    <path d="{{ t.geom.line }}" fill="none" stroke="#3B8FD4"
          stroke-width="{{ 2.4 * (fs | default(1)) }}"
          stroke-linecap="round" stroke-linejoin="round"/>
    {% for m in t.marks %}
    {#- экстремумы: только точки, значения читаются по шкале слева -#}
    <circle cx="{{ m.x }}" cy="{{ m.y }}" r="{{ 3.4 * (fs | default(1)) }}"
            fill="{{ '#C4553B' if m.kind == 'max' else '#3B8FD4' }}"
            stroke="var(--tile)" stroke-width="1.5"/>
    {% endfor %}
    {% endif %}
    {% if t.grid_labels %}
      {% for hl in t.hlines %}
        {% if hl.text %}
      <text x="7" y="{{ hl.y - 3 }}" class="axis" fill="#2B6B9E">{{ hl.text }}</text>
        {% endif %}
      {% endfor %}
    {% endif %}
    {% if t.time_labels %}
      {% for tm in t.times %}
      <text x="{{ tm.x }}" y="{{ t.h * 0.82 - 3 }}" class="axis"
            text-anchor="{{ tm.anchor }}">{{ tm.text }}</text>
      {% endfor %}
    {% endif %}
  </g>
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}" class="rim"/>

  {{ icon_c(t, t.icon or 'sun', 26) }}
  <text x="{{ t.w - 20 }}" y="42" class="wnow" text-anchor="end">{{ t.now_temp }}</text>
  {% if t.desc %}
  <text x="{{ t.w - 20 }}" y="60" class="status" text-anchor="end">{{ t.desc }}</text>
  {% endif %}

  <text x="20" y="{{ t.h - 20 }}" class="name">{{ t.title }}</text>
  {% if t.extra %}
  <text x="{{ t.w - 20 }}" y="{{ t.h - 20 }}" class="status" text-anchor="end">{{ t.extra }}</text>
  {% endif %}
  {% if t.stale_forecast %}
  <circle cx="{{ t.w - 12 }}" cy="12" r="3.5" class="dot-warn"/>
  {% endif %}
{% endmacro %}


{#- ---- кондиционер ----
    Уставка читается прямо на шкале - выбранное значение крупное, соседние
    приглушённые. Отдельной цифры под дугой нет, она дублировала. Внизу
    фактическая температура и режим работы. -#}
{% macro tile_ac(t) %}
  {{ plate(t) }}
  {% if t.wheel and not t.compact %}
    <g class="wheel {{ 'off' if not t.on }}">
      {% for lb in t.wheel.labels %}
      <text x="{{ lb.x }}" y="{{ lb.y }}" text-anchor="middle"
            class="wlab{{ ' near' if lb.near }}">{{ lb.text }}</text>
      {% endfor %}
      {% for tk in t.wheel.ticks %}
      <line x1="{{ tk.x1 }}" y1="{{ tk.y1 }}" x2="{{ tk.x2 }}" y2="{{ tk.y2 }}"
            class="wtick{{ ' major' if tk.major }}"/>
      {% endfor %}
      <path d="{{ t.wheel.arc }}" class="warc"/>
      <path class="wnotch"
            d="M {{ t.wheel.cx - 6 }},{{ t.wheel.cy + 16 }}
               L {{ t.wheel.cx }},{{ t.wheel.cy + 7 }}
               L {{ t.wheel.cx + 6 }},{{ t.wheel.cy + 16 }}"/>
    </g>

    {{ icon_c(t, t.icon, 22) }}
    <text x="{{ t.w - 18 }}" y="30" class="tag" text-anchor="end">{{ t.title|upper }}</text>

    {#- низ плитки: фактическая температура, режим и положение лопастей -#}
    {% if t.current %}
    <text x="20" y="{{ t.h - 38 }}" class="dial-sub">сейчас {{ t.current }}</text>
    {% endif %}
    <text x="20" y="{{ t.h - 16 }}" class="dial-mode">{{ t.status }}</text>
    {% if t.louver %}
    <g class="louver" transform="translate({{ t.w - 68 }},{{ t.h - 40 }})">
      <line x1="0" y1="1" x2="19" y2="1" class="lvhouse"/>
      {% for b in t.louver.blades %}
      <line x1="{{ b.x1 }}" y1="{{ b.y1 }}" x2="{{ b.x2 }}" y2="{{ b.y2 }}"
            class="lvblade" opacity="{{ b.op }}"/>
      {% endfor %}
    </g>
    {% endif %}
    {% if t.louver_h %}
    <g class="louver" transform="translate({{ t.w - 40 }},{{ t.h - 40 }})">
      <line x1="1" y1="0" x2="1" y2="19" class="lvhouse"/>
      {% for b in t.louver_h.blades %}
      <line x1="{{ b.x1 }}" y1="{{ b.y1 }}" x2="{{ b.x2 }}" y2="{{ b.y2 }}"
            class="lvblade" opacity="{{ b.op }}"/>
      {% endfor %}
    </g>
    {% endif %}
  {% else %}
    {{ icon_c(t, t.icon, 24) }}
    {% if t.current and not t.compact %}
    <text x="{{ t.w - 20 }}" y="41" class="badge" text-anchor="end">{{ t.current }}</text>
    {% endif %}
    {% if t.compact %}
    <text x="{{ t.w / 2 }}" y="{{ '%.0f'|format(t.h * 0.62) }}" class="mid"
          text-anchor="middle">{{ t.target }}</text>
    {% else %}
    <text x="20" y="{{ t.h - 62 }}" class="big">{{ t.target }}</text>
    {% endif %}
    {{ caption(t, t.status) }}
  {% endif %}
{% endmacro %}


{#- ---- ссылка на другую панель ---- -#}
{% macro tile_link(t) %}
  {{ plate(t) }}
  {{ icon_c(t, t.icon or 'door', 26) }}
  {% if not t.compact %}
  <use href="#{{ uid }}ic-next" xlink:href="#{{ uid }}ic-next"
       x="{{ t.w - 44 }}" y="18" width="24" height="24"/>
  {% endif %}
  {{ caption(t, t.status) }}
{% endmacro %}


{#- ---- простое значение ---- -#}
{% macro tile_value(t) %}
  {{ plate(t) }}
  {{ icon_c(t, t.icon or 'thermo', 24) }}
  <text x="{{ t.w - 20 }}" y="41" class="badge" text-anchor="end">{{ t.value }} {{ t.unit }}</text>
  {{ caption(t, t.subtitle) }}
{% endmacro %}


{#- ==================== полотно ==================== -#}

<g>
<rect width="{{ width }}" height="{{ height }}" fill="url(#{{ uid }}bg)"/>

{% if title %}
<text x="20" y="44" class="h1">{{ title }}</text>
<text x="{{ width - 20 }}" y="44" class="h1-sub" text-anchor="end">
  {{ updated }}{{ '' if connected else '  · нет связи с MQTT' }}
</text>
{% endif %}

{#- Строка состояния комнаты: чипы справа от заголовка раздела.
    Координаты посчитаны в panel.py - ширина чипа зависит от длины числа,
    а в шаблоне её не измерить. -#}
{% for hd in headers or [] %}
<text x="{{ hd.x }}" y="{{ hd.y }}" class="h2">{{ hd.title }}</text>
{% for c in hd.chips or [] %}
<g transform="translate({{ c.x }},{{ c.y }})">
  {{ chip(c.icon, c.value, c.badge, c.active, none, c.badge_color) }}
</g>
{% endfor %}
{% endfor %}

{% for c in top_chips or [] %}
<g transform="translate({{ c.x }},{{ c.y }})">
  {{ chip(c.icon, c.value, c.badge, c.active, none, c.badge_color) }}
</g>
{% endfor %}

{% for t in tiles %}
<g transform="translate({{ t.x }},{{ t.y }})" class="{{ 'offline' if t.offline }}"{{ t.attrs|safe }}>
  {% if   t.kind == 'chart'   %}{{ tile_chart(t) }}
  {% elif t.kind == 'switch'  %}{{ tile_switch(t) }}
  {% elif t.kind == 'curtain' %}{{ tile_curtain(t) }}
  {% elif t.kind == 'light'   %}{{ tile_light(t) }}
  {% elif t.kind == 'dimmer'  %}{{ tile_dimmer(t) }}
  {% elif t.kind == 'thermostat' %}{{ tile_thermostat(t) }}
  {% elif t.kind == 'forecast' %}{{ tile_forecast(t) }}
  {% elif t.kind == 'ac' %}{{ tile_ac(t) }}
  {% elif t.kind == 'link' %}{{ tile_link(t) }}
  {% else %}{{ tile_value(t) }}
  {% endif %}
  {{ badge_dot(t) }}
</g>
{% endfor %}
</g>
</svg>
