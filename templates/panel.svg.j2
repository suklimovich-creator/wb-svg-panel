{#-
  Вся внешность панели живёт здесь. Python сюда не заглядывает - он присылает
  уже посчитанные числа. Правьте свободно, рестарт демона не нужен.

  Единая раскладка любой плитки:
      иконка сверху слева   ·   значение сверху справа
      название снизу слева  ·   состояние под ним
  Активное устройство не инвертируется в белое, а обводится оранжевой рамкой.

  На входе:
    tiles[]  - плитки с готовой геометрией (x, y, w, h) и данными
    width, height, rx, theme, title, updated, connected

  Здесь остался каркас: стили, значки, шапка, разделы и раскладка. Сами
  плитки живут в templates/tiles/ - по файлу на группу, как и модули
  Python. Подкаталог обязателен: плоская раскладка, когда panel.svg.j2
  лежит рядом с panel.py, после разделения больше не работает.
-#}
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     class="{{ theme }}" style="--fs:{{ fs | default(1) }}" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}"
     font-family="-apple-system, 'SF Pro Display', 'SF Pro Text', 'Segoe UI', Inter, system-ui, sans-serif">

{#- Плитки живут в templates/tiles/. Импорт с контекстом: макросам нужны
    uid, fs и rx, общие для документа, а перечислять их в каждом вызове -
    это двадцать два макроса по три лишних параметра. -#}
{% import "tiles/_base.j2"    as base     with context %}
{% import "tiles/basic.j2"    as basic    with context %}
{% import "tiles/devices.j2"  as devices  with context %}
{% import "tiles/chart.j2"    as chart    with context %}
{% import "tiles/forecast.j2" as forecast with context %}
{% import "tiles/ac.j2"       as ac       with context %}

<style>
{#- Один элемент <style> на документ, собранный из кусков: общее в базе,
    дуга термостата и колесо кондиционера - рядом со своими плитками.
    Порядок тот же, что был до разделения: каскад меняться не должен. -#}
{{ base.style() }}
{{ devices.style() }}
{{ ac.style() }}
</style>

<defs>
{{ base.defs() }}

{% for t in tiles %}
  {#- обрезаем ЧУТЬ внутрь контура: рамка рисуется поверх и раньше
      съедала первую и последнюю точку графика -#}
  <clipPath id="{{ uid }}clip{{ t.i }}">
    <rect x="2" y="2" width="{{ t.w - 4 }}" height="{{ t.h - 4 }}" rx="{{ rx - 1 }}"/>
  </clipPath>
{% endfor %}
</defs>


{#- название всегда; вторая строка - только если её попросили -#}


{#- ---- ссылка на другую панель ---- -#}


{#- ==================== полотно ==================== -#}

<g>
<rect width="{{ width }}" height="{{ height }}" fill="url(#{{ uid }}bg)"/>

{% if title %}
<text x="20" y="44" class="h1">{{ title }}</text>
<text x="{{ width - 20 }}" y="44" class="h1-sub" text-anchor="end">
  {{ updated }}{{ '' if connected else '  · нет связи с MQTT' }}
</text>
{% endif %}

{#- Строка состояния комнаты: чипы справа от заголовка раздела.
    Координаты посчитаны в panel.py - ширина чипа зависит от длины числа,
    а в шаблоне её не измерить. -#}
{% for hd in headers or [] %}
{#- Заголовок раздела - кнопка: сворачивает и разворачивает. Зона нажатия
    шире текста, чтобы попадать пальцем, но не на всю ширину: справа живут
    чипы, у них свои нажатия. -#}
<g{% if hd.key %} data-section="{{ hd.key }}" data-folded="{{ 1 if hd.folded else 0 }}"{% if accordion %} data-accordion="1"{% endif %}{% endif %}>
  {% if hd.key %}
  {#- Подложка заголовка: едва заметная, только чтобы строка читалась как
      кнопка. Выключается section_plate: false у панели. -#}
  {% if plate_sections %}
  <rect x="{{ hd.tap_x }}" y="{{ hd.tap_y }}" width="{{ hd.tap_w }}" height="36"
        rx="10" class="section-plate"/>
  {% endif %}
  <rect x="{{ hd.tap_x }}" y="{{ hd.tap_y }}" width="{{ hd.tap_w }}" height="36"
        fill="transparent"/>
  {% endif %}
  <text x="{{ hd.x }}" y="{{ hd.y }}" class="h2">{{ hd.title }}</text>
  {% if hd.key %}
  {#- вниз - раскрыт, вправо - свёрнут -#}
  <path class="fold-arrow" d="{% if hd.folded %}M{{ hd.arrow_x }} {{ hd.arrow_y - 5 }}l5 5l-5 5{% else %}M{{ hd.arrow_x - 2 }} {{ hd.arrow_y - 2 }}l5 5l5 -5{% endif %}"/>
  {% endif %}
</g>
{% for c in hd.chips or [] %}
<g transform="translate({{ c.x }},{{ c.y }})">
  {{ base.chip(c.icon, c.value, c.badge, c.active, none, c.badge_color,
            c.chart, c.chart_title, c.unit) }}
</g>
{% endfor %}
{% endfor %}

{% for c in top_chips or [] %}
<g transform="translate({{ c.x }},{{ c.y }})">
  {{ base.chip(c.icon, c.value, c.badge, c.active, none, c.badge_color,
            c.chart, c.chart_title, c.unit) }}
</g>
{% endfor %}

{% for t in tiles %}
<g transform="translate({{ t.x }},{{ t.y }})" class="{{ 'offline' if t.offline }}"{{ t.attrs|safe }}>
  {% if   t.kind == 'chart'   %}{{ chart.tile_chart(t) }}
  {% elif t.kind == 'switch'  %}{{ basic.tile_switch(t) }}
  {% elif t.kind == 'curtain' %}{{ devices.tile_curtain(t) }}
  {% elif t.kind == 'light'   %}{{ devices.tile_light(t) }}
  {% elif t.kind == 'dimmer'  %}{{ devices.tile_dimmer(t) }}
  {% elif t.kind == 'thermostat' %}{{ devices.tile_thermostat(t) }}
  {% elif t.kind == 'forecast' %}{{ forecast.tile_forecast(t) }}
  {% elif t.kind == 'ac' %}{{ ac.tile_ac(t) }}
  {% elif t.kind == 'header' %}{{ basic.tile_header(t) }}
  {% elif t.kind == 'link' %}{{ basic.tile_link(t) }}
  {% elif t.kind == 'scene' %}{{ basic.tile_scene(t) }}
  {% else %}{{ basic.tile_value(t) }}
  {% endif %}
  {#- Точка «нет данных» заголовку не нужна: он ничего не измеряет,
      а чипы про своё состояние говорят сами. -#}
  {% if t.kind != 'header' %}{{ base.badge_dot(t) }}{% endif %}
  {% if t.zones %}{{ base.zone_rects(t) }}{% endif %}
</g>
{% endfor %}
</g>
</svg>
