{#-
  Вся внешность панели живёт здесь. Python сюда не заглядывает - он присылает
  уже посчитанные числа. Правьте свободно, рестарт демона не нужен.

  Единая раскладка любой плитки:
      иконка сверху слева   ·   значение сверху справа
      название снизу слева  ·   состояние под ним
  Активное устройство не инвертируется в белое, а обводится оранжевой рамкой.

  На входе:
    tiles[]  - плитки с готовой геометрией (x, y, w, h) и данными
    width, height, rx, theme, title, updated, connected

  Здесь остался каркас: стили, значки, шапка, разделы и раскладка. Сами
  плитки живут в templates/tiles/ - по файлу на группу, как и модули
  Python. Подкаталог обязателен: плоская раскладка, когда panel.svg.j2
  лежит рядом с panel.py, после разделения больше не работает.
-#}
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     class="{{ PAL.classes(theme) }}" style="--fs:{{ fs | default(1) }}" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}"
     font-family="-apple-system, 'SF Pro Display', 'SF Pro Text', 'Segoe UI', Inter, system-ui, sans-serif">

{#- Плитки живут в templates/tiles/. Импорт с контекстом: макросам нужны
    uid, fs и rx, общие для документа, а перечислять их в каждом вызове -
    это двадцать два макроса по три лишних параметра. -#}
{% import "tiles/_base.j2"    as base     with context %}
{% import "tiles/basic.j2"    as basic    with context %}
{% import "tiles/devices.j2"  as devices  with context %}
{% import "tiles/chart.j2"    as chart    with context %}
{% import "tiles/forecast.j2" as forecast with context %}
{% import "tiles/ac.j2"       as ac       with context %}

<style>
{#- Один элемент <style> на документ, собранный из кусков: общее в базе,
    дуга термостата и колесо кондиционера - рядом со своими плитками.
    Порядок тот же, что был до разделения: каскад меняться не должен. -#}
{{ base.style() }}
{{ devices.style() }}
{{ ac.style() }}
</style>

<defs>
{{ base.defs() }}

{#- Тени для светлых тем (light, autumn, retro, noir): два размытия на всю панель - чёткое
    у края и широкое мягкое. Именно на панель, а не на плитку: двадцать
    фильтров старый планшет тянет плохо, два - терпимо. shadows: false в
    конфиге выключает. -#}
{% set th_shadow = PAL.info(theme).shadow %}
{% set depth = PAL.info(theme).depth %}
{#- Неоморфизм без теней не бывает: и у основы без них (тёмные) тени есть. -#}
{% set use_shadows = shadows and depth != 'flat' and (th_shadow or depth == 'neumo') %}
{#- Сила теней: у светлой - чуть-чуть, у неё есть контур; у остальных
    контура почти нет, тень и отделяет плитку от фона. -#}
{% set sh_amb = th_shadow.amb if th_shadow else 0 %}
{% set sh_key = th_shadow.key if th_shadow else 0 %}
{#- В неоморфизме amb - тёмная тень, key - светлая. Тема, унаследовавшая
    слабые тени обычной формы, получает свои. -#}
{% if depth == 'neumo' %}
{% set sh_amb = sh_amb if sh_amb >= 0.3 else 0.7 %}
{% set sh_key = sh_key if sh_key >= 0.3 else 1.0 %}
{% endif %}
{% if use_shadows and depth == 'neumo' %}
  {#- неоморфизм: одно размытие на обе тени, область шире панели - светлая
      тень уходит вверх-влево за край первой плитки -#}
  <filter id="{{ uid }}sh-neu" filterUnits="userSpaceOnUse" x="-30" y="-30"
          width="{{ width + 60 }}" height="{{ height + 70 }}">
    <feGaussianBlur stdDeviation="7"/>
  </filter>
{% elif use_shadows %}
  <filter id="{{ uid }}sh-key" filterUnits="userSpaceOnUse" x="0" y="0"
          width="{{ width }}" height="{{ height + 40 }}">
    <feGaussianBlur stdDeviation="1.4"/>
  </filter>
  <filter id="{{ uid }}sh-amb" filterUnits="userSpaceOnUse" x="0" y="0"
          width="{{ width }}" height="{{ height + 40 }}">
    <feGaussianBlur stdDeviation="10"/>
  </filter>
{% endif %}
{% if depth == 'glass' %}
  {#- Отсвет стекла (1.40): свет сверху экрана. В координатах панели, а не
      плитки: страница сдвигает его на величину прокрутки (data-glare), и
      блик переезжает с плитки на плитку, пока они едут под ним. -#}
  <radialGradient id="{{ uid }}glare" gradientUnits="userSpaceOnUse" data-glare="1"
                  cx="{{ (width * 0.22)|round(1) }}" cy="0" r="{{ (width * 1.25)|round(1) }}">
    <stop offset="0" stop-color="var(--glare)"/>
    <stop offset=".55" stop-color="var(--glare)" stop-opacity=".35"/>
    <stop offset="1" stop-color="var(--glare)" stop-opacity="0"/>
  </radialGradient>
{% endif %}
{% for t in tiles %}
  {#- Обрезка - ровно по средней линии рамки, и рамка рисуется поверх:
      заливка уходит под неё без зазора. Раньше обрезали на точку внутрь,
      и между заливкой и рамкой светилась полоска подложки. -#}
  <clipPath id="{{ uid }}clip{{ t.i }}">
    <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"/>
  </clipPath>
{% endfor %}
</defs>


{#- название всегда; вторая строка - только если её попросили -#}


{#- ---- ссылка на другую панель ---- -#}


{#- ==================== полотно ==================== -#}

<g>
{#- bare - плитка для пульта: фон страницы под ней не нужен, она лежит на оверлее. -#}
{% if not bare %}
<rect width="{{ width }}" height="{{ height }}" fill="url(#{{ uid }}bg)"{% if depth == 'glass' %} class="wall"{% endif %}/>
{% if depth == 'glass' %}
{#- Обои стекла (1.40): пятна на экран высоты (по пропорции телефона).
    На странице их рисует фон окна, неподвижный при прокрутке, а этот
    слой прячется: он нужен картинке без страницы (киоск, /panel.svg). -#}
{% set wall_h = [height, width * 2.2]|min %}
<g class="wall">
  {% for i in range(1, 5) %}
  <rect width="{{ width }}" height="{{ wall_h|round(1) }}" fill="url(#{{ uid }}wall{{ i }})"/>
  {% endfor %}
</g>
{% endif %}
{% endif %}

{% if title %}
{#- Во вкладках полоса может стоять над шапкой - шапка сдвигается на её
    высоту. И вместо названия панели - значок и название открытой комнаты. -#}
{% if head_dy %}<g transform="translate(0,{{ head_dy }})">{% endif %}
{% if head_icon %}
{#- Нажатие на шапку показывает кнопки страницы (панели, колонки, тема,
    вид): во вкладках их полоса спрятана, на небольшом экране она лишняя. -#}
<rect width="{{ width }}" height="64" fill="transparent" data-headtap="1"/>
<g class="h1-ic"><use href="#{{ uid }}ic-{{ head_icon }}" xlink:href="#{{ uid }}ic-{{ head_icon }}"
   x="20" y="19" width="28" height="28"/></g>
<text x="54" y="44" class="h1">{{ title }}</text>
{% else %}
<text x="20" y="44" class="h1">{{ title }}</text>
{% endif %}
{#- Часы - крупно, под ними день недели и дата (с 1.35): раньше было
    только мелкое время, и на стене его было не прочесть. -#}
<text x="{{ width - 20 }}" y="38" class="clock" text-anchor="end">{{ updated }}</text>
<text x="{{ width - 20 }}" y="54" class="h1-sub date" text-anchor="end">
  {{- today or '' }}{{ '' if connected else ' · нет связи с MQTT' }}</text>
{% if head_dy %}</g>{% endif %}
{% endif %}

{#- Строка состояния комнаты: чипы справа от заголовка раздела.
    Координаты посчитаны в panel.py - ширина чипа зависит от длины числа,
    а в шаблоне её не измерить. -#}
{% for hd in headers or [] %}
{#- Заголовок раздела - кнопка: сворачивает и разворачивает. Подложка
    тянется до первого чипа, а зона нажатия - на всю полосу раздела по
    высоте и ширине: чипы рисуются после неё и забирают свои нажатия
    сами. -#}
<g{% if hd.key %} data-section="{{ hd.key }}" data-folded="{{ 1 if hd.folded else 0 }}"{% if accordion %} data-accordion="1"{% endif %}{% endif %}>
  {% if hd.key %}
  {#- Подложка заголовка: едва заметная, только чтобы строка читалась как
      кнопка. Выключается section_plate: false у панели. -#}
  {% if plate_sections %}
  <rect x="{{ hd.tap_x }}" y="{{ hd.tap_y }}" width="{{ hd.tap_w }}" height="36"
        rx="10" class="section-plate"/>
  {% endif %}
  <rect x="{{ hd.hit_x }}" y="{{ hd.hit_y }}" width="{{ hd.hit_w }}" height="{{ hd.hit_h }}"
        fill="transparent"/>
  {% endif %}
  <text x="{{ hd.x }}" y="{{ hd.y }}" class="h2">{{ hd.title }}</text>
  {% if hd.key %}
  {#- вниз - раскрыт, вправо - свёрнут -#}
  <path class="fold-arrow" d="{% if hd.folded %}M{{ hd.arrow_x }} {{ hd.arrow_y - 5 }}l5 5l-5 5{% else %}M{{ hd.arrow_x - 2 }} {{ hd.arrow_y - 2 }}l5 5l5 -5{% endif %}"/>
  {% endif %}
</g>
{% for c in hd.chips or [] %}
<g transform="translate({{ c.x }},{{ c.y }})">
  {{ base.chip(c.icon, c.value, c.badge, c.active, none, c.badge_color,
            c.chart, c.chart_title, c.unit, c.alarm, c.attrs) }}
</g>
{% endfor %}
{% endfor %}

{#- Вкладки (режим tabs, с 1.36): ряд «пилюль», как выбор режима в пульте
    кондиционера, - значок над подписью, на узком ряду одни значки. Видна
    одна комната, переключение только нажатием: смахивание на стене путают
    с прокруткой. Красная точка - тревога в закрытой вкладке. -#}
{% if tabs %}
{% set tp = tab_plate %}
<g data-tabbar="{{ tab_dock }}" data-bar-y="{{ tp.y }}" data-bar-h="{{ tp.h }}">
<rect x="0" y="{{ tp.y }}" width="{{ tp.w }}" height="{{ tp.h }}" class="tabbar"/>
<rect x="0" y="{{ tp.line_y }}" width="{{ tp.w }}" height="1" class="tabbar-line"/>
{% for t in tabs %}
<g data-section="{{ t.key }}" data-folded="{{ 0 if t.active else 1 }}" data-tab="1" class="tab{{ ' on' if t.active }}">
  <rect x="{{ t.hit_x }}" y="{{ t.y }}" width="{{ t.hit_w }}" height="{{ t.h }}" fill="transparent"/>
  {% if t.round %}
  <circle cx="{{ t.cx }}" cy="{{ t.cy }}" r="{{ t.r }}" class="tab-pill"/>
  {% else %}
  <rect x="{{ t.x }}" y="{{ t.y }}" width="{{ t.w }}" height="{{ t.h }}" rx="{{ [rx, t.h / 2] | min }}" class="tab-pill"/>
  {% endif %}
  <g class="tab-ic"><use href="#{{ uid }}ic-{{ t.icon }}" xlink:href="#{{ uid }}ic-{{ t.icon }}"
     x="{{ t.ix }}" y="{{ t.iy }}" width="{{ t.isize }}" height="{{ t.isize }}"/></g>
  {% if t.label %}
  <text x="{{ t.tx }}" y="{{ t.ty }}" text-anchor="middle" class="tab-t">{{ t.label }}</text>
  {% endif %}
  <title>{{ t.title }}</title>
  {% if t.alarm %}
  <circle cx="{{ t.dot_x }}" cy="{{ t.dot_y }}" r="4" class="tab-alarm"/>
  {% endif %}
</g>
{% endfor %}
</g>
{% endif %}

{% for c in top_chips or [] %}
<g transform="translate({{ c.x }},{{ c.y }})">
  {{ base.chip(c.icon, c.value, c.badge, c.active, none, c.badge_color,
            c.chart, c.chart_title, c.unit, c.alarm, c.attrs) }}
</g>
{% endfor %}

{#- Слой теней - под всеми плитками разом. Ширина размытой тени чуть
    меньше плитки: тень выглядывает снизу, а не обводит со всех сторон. -#}
{% if use_shadows and depth == 'neumo' %}
{#- Неоморфизм (1.32): тёмная тень снизу-справа, светлая сверху-слева.
    Включённая плитка утоплена - внешних теней у неё нет. -#}
{% set raised = tiles | rejectattr('kind', 'equalto', 'header') | rejectattr('on') | list %}
<g class="shadows">
  <g filter="url(#{{ uid }}sh-neu)" opacity="{{ sh_amb }}" style="fill:var(--shadow)">
  {% for t in raised %}
    <rect x="{{ t.x + 7 }}" y="{{ t.y + 8 }}" width="{{ t.w - 4 }}" height="{{ t.h - 4 }}" rx="{{ rx }}"/>
  {% endfor %}
  </g>
  <g filter="url(#{{ uid }}sh-neu)" opacity="{{ sh_key }}" style="fill:var(--neu-light)">
  {% for t in raised %}
    <rect x="{{ t.x - 5 }}" y="{{ t.y - 5 }}" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"/>
  {% endfor %}
  </g>
</g>
{% elif use_shadows %}
{% set plated = tiles | rejectattr('kind', 'equalto', 'header') | list %}
<g class="shadows" style="fill:var(--shadow)">
  <g filter="url(#{{ uid }}sh-amb)" opacity="{{ sh_amb }}">
  {% for t in plated %}
    <rect x="{{ t.x + 8 }}" y="{{ t.y + 10 }}" width="{{ t.w - 16 }}" height="{{ t.h - 6 }}" rx="{{ rx }}"/>
  {% endfor %}
  </g>
  <g filter="url(#{{ uid }}sh-key)" opacity="{{ sh_key }}">
  {% for t in plated %}
    <rect x="{{ t.x + 1 }}" y="{{ t.y + 2.5 }}" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"/>
  {% endfor %}
  </g>
</g>
{% endif %}

{% if depth == 'glass' %}
{#- Стекло (1.40): налёт и отсвет - одним слоем под всеми плитками. -#}
{% set glassy = tiles | rejectattr('kind', 'equalto', 'header') | list %}
<g class="glass-under" pointer-events="none">
  {% for t in glassy %}
  <rect x="{{ t.x + 1 }}" y="{{ t.y + 1 }}" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}" class="glass-fill"/>
  {% if not bare %}<rect x="{{ t.x + 1 }}" y="{{ t.y + 1 }}" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}" fill="url(#{{ uid }}glare)"/>{% endif %}
  {% endfor %}
</g>
{% endif %}

{% for t in tiles %}
<g transform="translate({{ t.x }},{{ t.y }})" class="{{ 'offline' if t.offline }}{{ ' tile-on' if t.on }}{{ ' inv' if t.inv }}"{{ t.attrs|safe }}>
  {% if   t.kind == 'chart'   %}{{ chart.tile_chart(t) }}
  {% elif t.kind == 'switch'  %}{{ basic.tile_switch(t) }}
  {% elif t.kind == 'curtain' %}{{ devices.tile_curtain(t) }}
  {% elif t.kind == 'roller'  %}{{ devices.tile_roller(t) }}
  {% elif t.kind == 'light'   %}{{ devices.tile_light(t) }}
  {% elif t.kind == 'dimmer'  %}{{ devices.tile_dimmer(t) }}
  {% elif t.kind == 'thermostat' %}{{ devices.tile_thermostat(t) }}
  {% elif t.kind == 'forecast' %}{{ forecast.tile_forecast(t) }}
  {% elif t.kind == 'ac' %}{{ ac.tile_ac(t) }}
  {% elif t.kind == 'fancoil' %}{{ devices.tile_fancoil(t) }}
  {% elif t.kind == 'header' %}{{ basic.tile_header(t) }}
  {% elif t.kind == 'link' %}{{ basic.tile_link(t) }}
  {% elif t.kind == 'scene' %}{{ basic.tile_scene(t) }}
  {% elif t.kind == 'scenes' %}{{ basic.tile_scenes(t) }}
  {% elif t.kind == 'camera' %}{{ basic.tile_camera(t) }}
  {% elif t.kind == 'list' %}{{ basic.tile_list(t) }}
  {% elif t.kind == 'agenda' %}{{ basic.tile_agenda(t) }}
  {% elif t.kind == 'leak' %}{{ basic.tile_leak(t) }}
  {% elif t.kind == 'valve' %}{{ basic.tile_valve(t) }}
  {#- Телевизор рисуется как обычный выключатель: значок, обводка по
      питанию и строка состояния. Своего макроса ему не нужно -
      всё нестандартное живёт в пульте, а не на плитке. -#}
  {% elif t.kind == 'tv' %}{% if t.tvk %}{{ basic.tile_tv(t) }}{% else %}{{ basic.tile_switch(t) }}{% endif %}
  {% else %}{{ basic.tile_value(t) }}
  {% endif %}
  {#- Точка «нет данных» заголовку не нужна: он ничего не измеряет,
      а чипы про своё состояние говорят сами. -#}
  {% if t.kind != 'header' %}{{ base.badge_dot(t) }}{% endif %}
  {% if t.zones %}{{ base.zone_rects(t) }}{% endif %}
</g>
{% endfor %}
{% if depth == 'glass' %}
{#- блик края стекла - поверх плиток, мимо нажатий -#}
<g class="glass-rims" pointer-events="none">
  {% for t in glassy %}
  <rect x="{{ t.x + 1.6 }}" y="{{ t.y + 1.6 }}" width="{{ t.w - 3.2 }}" height="{{ t.h - 3.2 }}" rx="{{ [rx - 0.6, 0]|max }}" class="glass-rim"/>
  {% endfor %}
</g>
{% endif %}
</g>
</svg>
