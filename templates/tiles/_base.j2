{#-
  Общее для всех плиток: подложка, значки, чипы, подписи, области
  нажатия. Здесь же общие стили и библиотека значков - значок задаётся
  в конфиге по имени, и `icon: sun` может стоять на любой плитке, не
  только на прогнозе.

  Часть templates/panel.svg.j2, вынесенная в отдельный файл при
  разделении шаблона. Импортируется с контекстом: макросам нужны
  uid, fs и rx, общие для всего документа.
-#}

{#- Стили этого файла. Элемент <style> в SVG остаётся один:
    resolve_css_vars разбирает только первый, и в остальных
    var() уехал бы на контроллер неразвёрнутым, а librsvg и
    старые WebView такое молча игнорируют. Поэтому каркас
    склеивает куски, а не выпускает несколько блоков. -#}
{% macro style() %}
  /* ---- палитры тем ----------------------------------------------------
     С 1.24 - данные, а не CSS: wbpanel/builtin_themes/«имя».yaml, блоки
     собирает wbpanel/palette.py. Корневая тема - svg {}, остальные -
     .имя {} только со своими значениями поверх родителя. */
{{ PAL.css()|safe }}
  .sheen     { pointer-events: none; }


  /* ---- тёмная карточка (inv) ----------------------------------------
     Значки красятся через currentColor (см. .icon): color на группе
     доходит и внутрь symbol, куда селекторы не проникают. */
  .inv              { color: var(--inv-stroke); }
  .inv .plate, .inv .plate.on { fill: var(--inv-tile); stroke: var(--inv-tile); stroke-width: 0; }
  .inv .rim, .inv .rim.on     { stroke: var(--inv-tile); stroke-width: 0; }
  .inv text         { fill: var(--inv-ink); }
  .inv .status, .inv .dial-mode, .inv .dial-sub, .inv .tag, .inv .axis,
  .inv .span, .inv .li-more, .inv .ag-date, .inv .ag-sep, .inv .ag-empty,
  .inv .lnote, .inv .siderow, .inv .wlab { fill: var(--inv-dim); }
  .inv .wlab.near, .inv .siderow.on { fill: var(--inv-ink); }
  .inv .tick, .inv .hline, .inv .wtick, .inv .dial .track,
  .inv .dial .mark  { stroke: var(--inv-ink); }
  .inv .mark-dot    { fill: var(--inv-ink); }
  .inv .dial .fill  { stroke: var(--inv-ink); }
  .inv .dial.live .fill, .inv .dial .mark.target, .inv .warc,
  .inv .goal        { stroke: var(--inv-accent); }
  .inv .dial.cool .fill, .inv .dial.cool .mark.target { stroke: var(--inv-stroke); }
  .inv .fanbars rect { fill: var(--inv-ink); }
  .inv .fanbars.live rect.on { fill: var(--inv-accent); }
  .inv .wnotch      { stroke: var(--inv-dim); }
  .inv .ag-now      { fill: var(--inv-accent); }
  .shadows   { pointer-events: none; }
  /* ---- органы управления (1.17): клавиша, диод, колесо ---- */
  .led-frame  { fill: #000000; opacity: .55; }
  .led-off    { fill: var(--ink); opacity: .16; }
  .led-gloss  { fill: #FFFFFF; opacity: .45; }
  .key        { fill: var(--ac-pill); stroke: var(--edge); stroke-width: 1; }
  .key-sh     { fill: var(--shadow); }
  .key-hl     { fill: var(--neu-light); }
  .kface      { stroke: var(--edge); stroke-width: .8; }
  .key-split  { stroke: #000000; stroke-width: 1.2; opacity: .45; }
  .slot       { fill: var(--shadow); opacity: .85; }
  .drum       { fill: var(--ac-pill); }
  .roller.on .drum { fill: var(--ac-pill); }
  .rib        { stroke: #000000; }
  .rib-hi     { stroke: #FFFFFF; }
  .lvl-track  { fill: var(--ink); opacity: .12; }
  .lvl        { fill: var(--ink-dim); }
  .roller.on .lvl { fill: var(--active); }
  .inv .lvl-track { fill: var(--inv-ink); }
  /* колесо пульта телевизора (1.21) */
  .tvw-ar     { fill: var(--ink); opacity: .8; }
  .tvw-ok     { fill: var(--active); }
  .tvw-okt    { fill: #FFFFFF; font-weight: 700; letter-spacing: .3px; }
  .tvw-ic     { color: var(--ink); }
  .tvw.off .tvw-ok { fill: var(--ink-dim); opacity: .55; }
  .skey       { cursor: pointer; }
  .skey-ic    { color: var(--ink); }
  .skey-t     { fill: var(--ink); font-weight: 500; }
  .skey-dot   { fill: var(--ink); opacity: .22; }
  .skey-dot.on { fill: var(--active); opacity: .95; }
  .skey.fired .skey-face { stroke: var(--active); stroke-width: 2; }
  .skey.fired .skey-ic { color: var(--active); }
  .skey.busy  { opacity: .6; }
  .sph-arc    { fill: none; stroke: var(--ink); stroke-linecap: round; }
  .sph-fill   { fill: none; stroke: var(--ink-dim); stroke-linecap: round; }
  .sphere.on .sph-fill { stroke: var(--active); }
  .sph-knob   { fill: var(--ink-dim); stroke: var(--tile); stroke-width: 2; }
  .sphere.on .sph-knob { fill: var(--ink); }
  .inv .sph-arc { stroke: var(--inv-ink); }
  .inv .sphere.on .sph-fill { stroke: var(--inv-accent); }
  .inv .sph-knob { stroke: var(--inv-tile); }
  .inv .sphere.on .sph-knob { fill: var(--inv-ink); }
  .inv .roller.on .lvl { fill: var(--inv-accent); }
  /* Сетка графика на угольном фоне читается вдвое ярче, чем на сером. */
  .graphite .tick, .graphite .hline { opacity: .07; }
  .graphite .tick.major { opacity: .12; }

  /* ---- типографика ------------------------------------------------------ */
  .h1     { font-size: calc(26px * var(--fs)); font-weight: 700; letter-spacing: -.6px; fill: var(--ink); }
  .h1-sub { font-size: calc(13px * var(--fs)); font-weight: 500; fill: var(--ink-faint); }
  .clock  { font-size: calc(24px * var(--fs)); font-weight: 600; fill: var(--ink-dim);
            letter-spacing: -.3px; font-variant-numeric: tabular-nums; }
  .h1-sub.date { font-size: calc(12px * var(--fs)); fill: var(--ink-dim); opacity: .85; }
  .h2     { font-size: calc(18px * var(--fs)); font-weight: 650; letter-spacing: -.3px; fill: var(--ink); }
  /* подложка заголовка раздела: подсказывает, что по строке можно нажать */
  /* Полоса раздела (заголовок в гармошке). Цвет и плотность - из темы:
     при общей прозрачности .35 в нуаре и графите полоса сливалась с фоном. */
  .section-plate { fill: var(--section); opacity: var(--section-op); }
  /* стрелка у заголовка раздела: вниз - раскрыт, вправо - свёрнут */
  .fold-arrow { fill: none; stroke: var(--ink-dim);
                stroke-width: calc(2px * var(--fs));
                stroke-linecap: round; stroke-linejoin: round; }
  .name   { font-size: calc(15px * var(--fs));   font-weight: 500; fill: var(--ink); }
  .name-s { font-size: calc(11px * var(--fs));   font-weight: 500; fill: var(--ink); }
  .mid    { font-size: calc(19px * var(--fs)); font-weight: 600; fill: var(--ink);
            letter-spacing: -.4px; }
  .lvhouse{ stroke: var(--ink-faint); stroke-width: calc(1.6px * var(--fs));
            stroke-linecap: round; }
  .lvblade{ stroke: var(--stroke); stroke-width: calc(1.8px * var(--fs));
            stroke-linecap: round; }
  .on .lvblade, .wheel:not(.off) ~ * .lvblade { stroke: var(--stroke); }
  .badge-s{ font-size: calc(12px * var(--fs));   font-weight: 600; fill: var(--ink); }
  .on .name-s, .inkdark .name-s { fill: var(--ink); }
  .onlight .name-s { fill: #FFFFFF; }
  .status { font-size: calc(13.5px * var(--fs)); font-weight: 400; fill: var(--ink-dim); }
  .badge  { font-size: calc(17px * var(--fs));   font-weight: 500; fill: var(--ink); }
  .badge2 { font-size: calc(14px * var(--fs));   font-weight: 500; }
  /* Имя ряда перед числом в шапке графика: того же кегля - мельче
     прописные CO2 и VOC выглядели строчными, - но плотнее и бледнее. */
  .bname  { font-weight: 650; opacity: .75; }
  .tag    { font-size: calc(11px * var(--fs));   font-weight: 600; fill: var(--ink-faint); letter-spacing: .4px; }

  /* ---- плитки ----------------------------------------------------------- */
  .plate     { fill: var(--tile); stroke: var(--edge); stroke-width: var(--edge-w); }
  .plate.on  { fill: var(--tile-on); stroke: var(--active); stroke-width: var(--active-w); }
  /* только рамка, без заливки - рисуется ПОВЕРХ графика или подсветки */
  .rim       { fill: none; stroke: var(--edge); stroke-width: var(--edge-w); }
  .rim.on    { stroke: var(--active); stroke-width: var(--active-w); }
  /* Толщина значков без fs: значок - symbol, его линия и так растёт
     вместе с размером. С fs на весь экран она умножалась дважды, и
     облако на графике заплывало в кляксу. */
  .icon      { fill: none; stroke: currentColor; stroke-width: 1.8px;
               stroke-linecap: round; stroke-linejoin: round; }
  .icon-fill { fill: currentColor; }
  /* Фигурки человечков состоят из отдельных конечностей и при общей
     толщине выглядят жиже предметных значков - им нужна прибавка. */
  .icon-figure { stroke-width: 2px; }
  /* Просвет под бейджем режима: без него линии корпуса просвечивают
     сквозь значок режима и всё сливается. Цвет задаётся атрибутом -
     он равен заливке чипа, а она зависит от того, активен чип или нет. */

  /* ---- чип строки состояния --------------------------------------------- */
  .chip      { fill: var(--tile); stroke: var(--edge); stroke-width: var(--edge-w); }
  .chip.on   { fill: var(--active-soft); stroke: var(--active-soft-edge); }
  .chip.alarm { fill: #C4553B; stroke: #C4553B; }
  .chip-val  { font-size: calc(14px * var(--fs)); font-weight: 500; fill: var(--ink); }
  /* Число на включённом чипе: в нуаре чип чёрный, и тёмная цифра на нём
     пропадала. Своя переменная - в остальных темах она равна --ink. */
  .chip.on ~ .chip-val { fill: var(--chip-on-ink); }
  /* Значки состояния красятся через currentColor, а не классом.
     Содержимое элемента use лежит в теневом дереве, и селекторы документа
     туда не достают: правило вида «.active .icon» на символ не подействует.
     Угловые скобки в этом комментарии тоже нельзя - внутри style любой
     знак «меньше» обрывает разбор XML, и librsvg молча вернёт ошибку.
     currentColor же наследуется всегда и переживает подстановку
     переменных перед отдачей SVG. */
  .sicon      { fill: none; stroke: currentColor; stroke-width: 1.8px;
                stroke-linecap: round; stroke-linejoin: round; }
  .sicon-fill { fill: currentColor; stroke: none; }
  .sicon-figure { stroke-width: 2px; }
  /* Класс on ставится только на прямоугольники подложки, рамки и чипа,
     а у них нет потомков, так что эти два правила внутри панели не
     срабатывают. Живой механизм подсветки - .onlight на группе ниже.
     Оставлены на случай, если значок когда-нибудь окажется внутри
     группы с этим классом; тогда же и пригодятся.
     Угловые скобки здесь недопустимы: внутри style они ломают разбор
     XML, и панель перестаёт открываться как картинка. */
  .on .icon      { stroke: var(--active); }
  .on .icon-fill { fill: var(--active); }
  /* подписи и иконка поверх цветного поля ленты - всегда светлые */
  .onlight .name, .onlight .badge { fill: #FFFFFF; }
  .onlight .status                { fill: rgba(255,255,255,.72); }
  .onlight .icon                  { stroke: #FFFFFF; }
  .onlight .icon-fill             { fill: #FFFFFF; }
  /* Значки - currentColor: цвет задаётся группе и наследуется внутрь
     symbol. Классы на группе (.onlight, .inv) так и перекрашивают значок. */
  svg               { color: var(--stroke); }
  .onlight          { color: #FFFFFF; }
  .axis      { font-size: calc(9.5px * var(--fs)); font-weight: 500; fill: var(--ink);
               opacity: .55; }
  .span      { font-size: calc(12px * var(--fs)); font-weight: 500; fill: var(--ink-dim); }
  .wnow      { font-size: calc(27px * var(--fs)); font-weight: 600; letter-spacing: -.8px;
               fill: var(--ink); }
  .tick      { stroke: var(--ink); stroke-width: calc(.5px * var(--fs)); opacity: .13; }
  .tick.major{ stroke-width: calc(.9px * var(--fs)); opacity: .22; }
  .frame rect,
  .frame line{ fill: none; stroke: var(--stroke); stroke-width: calc(1.6px * var(--fs));
               opacity: .40; stroke-linecap: round; }
  .frame .sill{ stroke-width: calc(2.6px * var(--fs)); opacity: .5; }
  .hline     { stroke: var(--ink); stroke-width: calc(.5px * var(--fs)); opacity: .13; }
  .hline.edge{ opacity: .20; }
  /* Сцена сработала: короткая вспышка подложки. Держится 0.7 с - ровно
     чтобы палец успел заметить, и не дольше: сцена уже отработала. */
  .fired .plate { fill: var(--active-soft); }
  .fired .icon  { stroke: var(--active-ink); }
  /* Подложка под кадром камеры: видна, пока снимок не пришёл, и остаётся
     навсегда, если камера молчит. Без неё в плитке зияет дыра цвета фона
     панели, и непонятно, плитка это вообще или пустое место. */
  .cam-hole  { fill: var(--window); }
  .off-dim   { opacity: .55; }
  .offline   { opacity: .40; }
  .dot-warn  { fill: #E09B2D; }
  .dot-off   { fill: var(--ink-faint); }
  /* Пункты списка. Кегль задаётся атрибутом: его считает сервер по полю
     font плитки и масштабу, и объявлять font-size здесь нельзя - правило
     таблицы стилей сильнее атрибута и перебило бы его. */
  .lk        { fill: var(--ink); font-weight: 450; }
  .lk.wet    { font-weight: 650; }
  .lk-more   { fill: var(--ink-dim); font-weight: 500; }
  .lk-dry    { fill: none; stroke: var(--ink-dim); stroke-width: 1.6; }
  .lk-wet    { fill: #C4553B; }
  .lk-off    { fill: var(--ink-dim); opacity: .35; }
  .onlight .lk, .onlight .lk-more { fill: #FFFFFF; }
  .onlight .lk-dry { stroke: rgba(255,255,255,.8); }
  .onlight .lk-wet { fill: #FFFFFF; }
  .zone      { opacity: .11; }
  .zword     { font-size: calc(12.5px * var(--fs)); font-weight: 600; }
  .legend    { font-size: calc(9px * var(--fs)); font-weight: 500; fill: var(--ink); }
  .legend .lname { font-weight: 650; }
  .lnote     { font-size: calc(7.5px * var(--fs)); fill: var(--ink-dim); }
  .ag-txt    { fill: var(--ink); font-weight: 450; }
  .ag-time   { fill: var(--ink); font-weight: 600; }
  .ag-time.small { fill: var(--ink-dim); font-weight: 500; }
  .ag-now    { fill: var(--active); }
  .ag-past   { opacity: .42; }
  .ag-sep    { fill: var(--ink-dim); font-weight: 600; }
  .ag-empty  { fill: var(--ink-dim); }
  .ag-date   { fill: var(--ink-dim); font-weight: 500; }
  .li        { fill: var(--ink); font-weight: 450; }
  .li-dot    { fill: var(--ink-dim); }
  .li-more   { fill: var(--ink-dim); font-weight: 450; }
  .li-count  { font-size: calc(17px * var(--fs)); font-weight: 600; fill: var(--ink-dim); }
  /* Протечка: красная во всю плитку, видно с другого конца коридора.
     Цвет один в обеих темах - тревога не должна зависеть от оформления. */
  .plate.alarm   { fill: #C4553B; stroke: #C4553B; }
  /* Перекрытый кран: красная рамка. Открытый - норма и рамки не имеет. */
  .plate.closed  { stroke: #C4553B; stroke-width: var(--active-w); }
  .valve-mark    { font-size: calc(12px * var(--fs)); font-weight: 650;
                   letter-spacing: .3px; }
{% endmacro %}

{#- Библиотека значков. Живёт в <defs> каркаса, адресуется по uid.
    Выпускается всегда целиком: имя значка приходит из конфига,
    и заранее неизвестно, какие понадобятся. -#}
{% macro defs() %}
  {#- Органы управления (с 1.17): блик на ручке и клавише, цилиндр колеса
      диммера, светящийся диод. Один раз на документ. -#}
  {#- острая фаска: свет на верхнем-левом скосе, тень на нижнем-правом -#}
  <linearGradient id="{{ uid }}bev" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#FFFFFF" stop-opacity=".6"/>
    <stop offset=".47" stop-color="#FFFFFF" stop-opacity="0"/>
    <stop offset=".53" stop-color="#000000" stop-opacity="0"/>
    <stop offset="1" stop-color="#000000" stop-opacity=".38"/>
  </linearGradient>
  <linearGradient id="{{ uid }}gl" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#FFFFFF" stop-opacity=".22"/>
    <stop offset=".55" stop-color="#FFFFFF" stop-opacity="0"/>
    <stop offset="1" stop-color="#000000" stop-opacity=".16"/>
  </linearGradient>
  <linearGradient id="{{ uid }}cyl" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#000000" stop-opacity=".55"/>
    <stop offset=".5" stop-color="#FFFFFF" stop-opacity=".10"/>
    <stop offset="1" stop-color="#000000" stop-opacity=".55"/>
  </linearGradient>
  <linearGradient id="{{ uid }}cylh" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="#000000" stop-opacity=".55"/>
    <stop offset=".5" stop-color="#FFFFFF" stop-opacity=".10"/>
    <stop offset="1" stop-color="#000000" stop-opacity=".55"/>
  </linearGradient>
  <linearGradient id="{{ uid }}led" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#FFE2A8"/>
    <stop offset="1" stop-color="var(--active)"/>
  </linearGradient>
  <linearGradient id="{{ uid }}ledh" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="#FFE2A8"/>
    <stop offset="1" stop-color="var(--active)"/>
  </linearGradient>
  <linearGradient id="{{ uid }}dglow" x1="0" y1="1" x2="0" y2="0">
    <stop offset="0" stop-color="var(--active)" stop-opacity=".45"/>
    <stop offset="1" stop-color="var(--active)" stop-opacity="0"/>
  </linearGradient>
  {#- шар ленты: блик и тень к краю -#}
  <radialGradient id="{{ uid }}spec" cx=".32" cy=".29" r=".42">
    <stop offset="0" stop-color="#FFFFFF" stop-opacity=".55"/>
    <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"/>
  </radialGradient>
  <radialGradient id="{{ uid }}sprim" cx=".5" cy=".5" r=".5">
    <stop offset=".55" stop-color="#101114" stop-opacity="0"/>
    <stop offset="1" stop-color="#101114" stop-opacity=".55"/>
  </radialGradient>
  {#- клавиша сцены: тёплый свет снизу, тем сильнее, чем ярче сцена -#}
  <radialGradient id="{{ uid }}sglow" cx=".5" cy="1" r=".9">
    <stop offset="0" stop-color="#FFC27A" stop-opacity=".5"/>
    <stop offset="1" stop-color="#FFC27A" stop-opacity="0"/>
  </radialGradient>
  <!-- мягкая тень под шаром ленты: без размытия, градиентом -->
  <radialGradient id="{{ uid }}sphsh" cx=".5" cy=".5" r=".5">
    <stop offset=".7" stop-color="var(--shadow)" stop-opacity="{{ '.6' if NEU else '.32' }}"/>
    <stop offset="1" stop-color="var(--shadow)" stop-opacity="0"/>
  </radialGradient>
  {% if NEU %}
  <!-- неоморфизм (1.32): светлая тень ручек и колёс - сверху-слева -->
  <radialGradient id="{{ uid }}sphhl" cx=".5" cy=".5" r=".5">
    <stop offset=".7" stop-color="var(--neu-light)" stop-opacity=".95"/>
    <stop offset="1" stop-color="var(--neu-light)" stop-opacity="0"/>
  </radialGradient>
  <!-- край плитки: свет на верхней-левой кромке, тень на нижней-правой -
       без него на тёмном фоне выпуклость расплывалась, граница не читалась -->
  <linearGradient id="{{ uid }}neu-edge" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="var(--neu-light)" stop-opacity=".75"/>
    <stop offset=".45" stop-color="var(--neu-light)" stop-opacity="0"/>
    <stop offset=".55" stop-color="var(--shadow)" stop-opacity="0"/>
    <stop offset="1" stop-color="var(--shadow)" stop-opacity=".7"/>
  </linearGradient>
  <linearGradient id="{{ uid }}neu-edge-in" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="var(--shadow)" stop-opacity=".8"/>
    <stop offset=".45" stop-color="var(--shadow)" stop-opacity="0"/>
    <stop offset=".55" stop-color="var(--neu-light)" stop-opacity="0"/>
    <stop offset="1" stop-color="var(--neu-light)" stop-opacity=".6"/>
  </linearGradient>
  <!-- утопленная плитка: тень у верхнего-левого края внутри, свет у нижнего-правого -->
  <linearGradient id="{{ uid }}neu-in" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="var(--shadow)" stop-opacity=".8"/>
    <stop offset=".22" stop-color="var(--shadow)" stop-opacity="0"/>
    <stop offset=".78" stop-color="var(--neu-light)" stop-opacity="0"/>
    <stop offset="1" stop-color="var(--neu-light)" stop-opacity=".85"/>
  </linearGradient>
  {% endif %}
  <radialGradient id="{{ uid }}halo" cx=".5" cy=".5" r=".5">
    <stop offset="0" stop-color="var(--active)" stop-opacity=".55"/>
    <stop offset="1" stop-color="var(--active)" stop-opacity="0"/>
  </radialGradient>
  {#- клавиша: верх светлее, низ темнее и наоборот - какая половина нажата -#}
  <linearGradient id="{{ uid }}key-on" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#000000" stop-opacity=".22"/>
    <stop offset=".5" stop-color="#000000" stop-opacity=".12"/>
    <stop offset=".5" stop-color="#FFFFFF" stop-opacity=".10"/>
    <stop offset="1" stop-color="#000000" stop-opacity=".02"/>
  </linearGradient>
  <linearGradient id="{{ uid }}key-off" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#FFFFFF" stop-opacity=".10"/>
    <stop offset=".5" stop-color="#000000" stop-opacity=".02"/>
    <stop offset=".5" stop-color="#000000" stop-opacity=".12"/>
    <stop offset="1" stop-color="#000000" stop-opacity=".22"/>
  </linearGradient>
  <linearGradient id="{{ uid }}keyh-on" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="#FFFFFF" stop-opacity=".10"/>
    <stop offset=".5" stop-color="#000000" stop-opacity=".02"/>
    <stop offset=".5" stop-color="#000000" stop-opacity=".12"/>
    <stop offset="1" stop-color="#000000" stop-opacity=".22"/>
  </linearGradient>
  <linearGradient id="{{ uid }}keyh-off" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="#000000" stop-opacity=".22"/>
    <stop offset=".5" stop-color="#000000" stop-opacity=".12"/>
    <stop offset=".5" stop-color="#FFFFFF" stop-opacity=".10"/>
    <stop offset="1" stop-color="#000000" stop-opacity=".02"/>
  </linearGradient>
  {% if PAL.info(theme).sheen %}
  {#- Отсвет плиток тёмных тем: радиальный из левого верхнего угла. Цвет -
      переменной, чтобы плоская подстановка для старых браузеров его
      развернула. -#}
  <radialGradient id="{{ uid }}sheen" cx="0" cy="0" r="1.15">
    <stop offset="0" stop-color="var(--sheen)"/>
    <stop offset="1" stop-color="var(--sheen)" stop-opacity="0"/>
  </radialGradient>
  <radialGradient id="{{ uid }}sheen-on" cx="0" cy="0" r="1.25">
    <stop offset="0" stop-color="var(--sheen-on)"/>
    <stop offset=".55" stop-color="var(--sheen-on)" stop-opacity=".25"/>
    <stop offset="1" stop-color="var(--sheen-on)" stop-opacity="0"/>
  </radialGradient>
  {% endif %}
  <linearGradient id="{{ uid }}bg" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="var(--bg-top)"/>
    <stop offset="1" stop-color="var(--bg-bottom)"/>
  </linearGradient>

  <linearGradient id="{{ uid }}sky" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="var(--window)"/>
    <stop offset="1" stop-color="var(--window)" stop-opacity=".5"/>
  </linearGradient>

  <!-- подложки под подписи: гасят картинку сверху и снизу цветом плитки,
       чтобы текст читался поверх полноразмерного полотна в любой теме -->
  <linearGradient id="{{ uid }}scrim-t" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0"   stop-color="var(--tile)" stop-opacity=".88"/>
    <stop offset=".30" stop-color="var(--tile)" stop-opacity="0"/>
  </linearGradient>
  <linearGradient id="{{ uid }}scrim-b" x1="0" y1="0" x2="0" y2="1">
    <stop offset=".48" stop-color="var(--tile)" stop-opacity="0"/>
    <stop offset=".80" stop-color="var(--tile)" stop-opacity=".88"/>
    <stop offset="1"   stop-color="var(--tile)" stop-opacity=".96"/>
  </linearGradient>

  <!-- к низу плитки гасим картинку до цвета подложки, чтобы подписи читались -->
  <linearGradient id="{{ uid }}scrim" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0"   stop-color="var(--tile)" stop-opacity="0"/>
    <stop offset=".45" stop-color="var(--tile)" stop-opacity=".45"/>
    <stop offset=".74" stop-color="var(--tile)" stop-opacity=".90"/>
    <stop offset="1"   stop-color="var(--tile)" stop-opacity="1"/>
  </linearGradient>

  <!-- поле ленты: слева холодный, справа тёплый (заливается per-tile) -->
  <linearGradient id="{{ uid }}dim" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0"   stop-color="#0A0A0C" stop-opacity="0"/>
    <stop offset=".50" stop-color="#0A0A0C" stop-opacity=".30"/>
    <stop offset="1"   stop-color="#0A0A0C" stop-opacity=".78"/>
  </linearGradient>

  <linearGradient id="{{ uid }}foldL" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="#000" stop-opacity="0"/>
    <stop offset="1" stop-color="#000" stop-opacity=".20"/>
  </linearGradient>
  <linearGradient id="{{ uid }}foldR" x1="1" y1="0" x2="0" y2="0">
    <stop offset="0" stop-color="#000" stop-opacity="0"/>
    <stop offset="1" stop-color="#000" stop-opacity=".20"/>
  </linearGradient>
  <!-- то же для полотна, уходящего вверх: тень собирается у нижней кромки -->
  <linearGradient id="{{ uid }}foldB" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#000" stop-opacity="0"/>
    <stop offset="1" stop-color="#000" stop-opacity=".20"/>
  </linearGradient>

  <!-- шторы нового вида (1.20): складка - полоса светотени, у римской
       тень к нижней кромке каждой складки; подложка под подписи легче
       прежней - вид за окном должен оставаться видом -->
  <linearGradient id="{{ uid }}plt" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="#000" stop-opacity=".26"/>
    <stop offset=".3" stop-color="#000" stop-opacity="0"/>
    <stop offset=".55" stop-color="#FFF" stop-opacity=".12"/>
    <stop offset=".8" stop-color="#000" stop-opacity="0"/>
    <stop offset="1" stop-color="#000" stop-opacity=".2"/>
  </linearGradient>
  <linearGradient id="{{ uid }}rfold" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#FFF" stop-opacity=".10"/>
    <stop offset=".55" stop-color="#000" stop-opacity="0"/>
    <stop offset="1" stop-color="#000" stop-opacity=".32"/>
  </linearGradient>
  <linearGradient id="{{ uid }}scrim2" x1="0" y1="0" x2="0" y2="1">
    <stop offset=".55" stop-color="var(--tile)" stop-opacity="0"/>
    <stop offset=".80" stop-color="var(--tile)" stop-opacity=".72"/>
    <stop offset="1"   stop-color="var(--tile)" stop-opacity=".9"/>
  </linearGradient>

  <linearGradient id="{{ uid }}scrimL" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0"   stop-color="var(--tile)" stop-opacity=".9"/>
    <stop offset=".42" stop-color="var(--tile)" stop-opacity=".7"/>
    <stop offset=".75" stop-color="var(--tile)" stop-opacity="0"/>
  </linearGradient>

  <pattern id="{{ uid }}weave" width="7" height="7" patternUnits="userSpaceOnUse">
    <rect width="7" height="7" fill="var(--fabric)"/>
    <line x1="0" y1="0" x2="0" y2="7" stroke="rgba(0,0,0,.09)" stroke-width="1.6"/>
  </pattern>

  <!-- иконки: единый бокс 24x24, только штрихи -->
  <symbol id="{{ uid }}ic-undo" viewBox="0 0 24 24">
    <path class="icon" d="M9 7L5 11l4 4"/>
    <path class="icon" d="M5 11h9a5 5 0 0 1 0 10h-3"/>
  </symbol>
  <symbol id="{{ uid }}ic-home" viewBox="0 0 24 24">
    <path class="icon" d="M4 11l8-7 8 7"/>
    <path class="icon" d="M6.5 9.5V20h11V9.5"/>
  </symbol>
  <symbol id="{{ uid }}ic-power" viewBox="0 0 24 24">
    <path class="icon" d="M12 3.5v8"/>
    <path class="icon" d="M7.2 6.6a7.2 7.2 0 1 0 9.6 0"/>
  </symbol>
  <symbol id="{{ uid }}ic-list" viewBox="0 0 24 24">
    <path class="icon" d="M9.5 6.5h10M9.5 12h10M9.5 17.5h10"/>
