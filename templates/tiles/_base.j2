  <symbol id="{{ uid }}ic-thermo" viewBox="0 0 24 24">
    <path class="icon" d="M14 14.2V5.4a2 2 0 1 0-4 0v8.8a4.2 4.2 0 1 0 4 0z"/>
  </symbol>
  <symbol id="{{ uid }}ic-drop" viewBox="0 0 24 24">
    <path class="icon" d="M12 3.2s5.4 6 5.4 9.5a5.4 5.4 0 1 1-10.8 0C6.6 9.2 12 3.2 12 3.2z"/>
  </symbol>
  {#- CO2 - сама формула, как на бытовых датчиках. Облако, которое было
      здесь, читалось как погода «облачно», а молекула O=C=O на мелком
      размере - как звено цепи. VOC - колба: летучие вещества - химия.
      Оба рисуются дважды: ic-co2 серым для плиток и ic-co2-s через
      currentColor для чипа - на красном чипе «проветрить» значок белый. -#}
  {% for sfx, fill, line in (('', 'icon-fill', 'icon'), ('-s', 'sicon-fill', 'sicon')) %}
  <symbol id="{{ uid }}ic-co2{{ sfx }}" viewBox="0 0 24 24">
    <text class="{{ fill }}" x="1.2" y="15.6" font-size="11.5" font-weight="700"
          letter-spacing="-.3">CO</text>
