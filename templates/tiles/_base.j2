{#- ==================== макросы ==================== -#}

{#- ---- органы управления (с 1.17) ----
    Диод-ночник: окошко-полоска; светится, когда прибор выключен, - чтобы
    найти выключатель в темноте. Включённый гасит диод, светится плитка. -#}
{% macro diode(d, lit, horiz=False) %}
  <rect x="{{ d.x - 2 }}" y="{{ d.y - 2 }}" width="{{ d.w + 4 }}" height="{{ d.h + 4 }}" rx="3.6" class="led-frame"/>
  {% if lit %}
  <ellipse cx="{{ d.x + d.w / 2 }}" cy="{{ d.y + d.h / 2 }}" rx="{{ d.w / 2 + 9 }}" ry="{{ d.h / 2 + 9 }}"
           fill="url(#{{ uid }}halo)"/>
  <rect x="{{ d.x }}" y="{{ d.y }}" width="{{ d.w }}" height="{{ d.h }}" rx="3"
        fill="url(#{{ uid }}{{ 'ledh' if horiz else 'led' }})"/>
  {% else %}
  <rect x="{{ d.x }}" y="{{ d.y }}" width="{{ d.w }}" height="{{ d.h }}" rx="3" class="led-off"/>
  {% endif %}
  {% if horiz %}
  <rect x="{{ d.x + 1.2 }}" y="{{ d.y + 3 }}" width="1.6" height="{{ d.h - 8 if d.h > 10 else 2 }}" rx=".8" class="led-gloss"/>
  {% else %}
  <rect x="{{ d.x + 3 }}" y="{{ d.y + 1.2 }}" width="{{ d.w - 8 if d.w > 10 else 2 }}" height="1.6" rx=".8" class="led-gloss"/>
  {% endif %}
{% endmacro %}

{#- Мягкие тени органов управления (1.23.1). Без фильтров: круглому -
    радиальный градиент, прямоугольному - три рамки с нарастающим краем.
    Прежняя тень - тот же контур, сдвинутый вниз, - выглядывала из-под
    детали резким серпом. -#}
{#- Тени органов управления. Форма темы (depth, с 1.32): flat - без
    теней; neumo - две тени, светлая сверху-слева и тёмная снизу-справа. -#}
{% macro soft_round(cx, cy, r, dy) %}
  {% if DEPTH == 'neumo' %}
  {% set o = (dy * 1.3 + 1.5)|round(1) %}
  <circle cx="{{ (cx - o)|round(1) }}" cy="{{ (cy - o)|round(1) }}" r="{{ (r * 1.14)|round(1) }}" fill="url(#{{ uid }}sphhl)"/>
  <circle cx="{{ (cx + o)|round(1) }}" cy="{{ (cy + o)|round(1) }}" r="{{ (r * 1.14)|round(1) }}" fill="url(#{{ uid }}sphsh)"/>
  {% elif DEPTH != 'flat' %}
  <circle cx="{{ cx }}" cy="{{ (cy + dy)|round(1) }}" r="{{ (r * 1.16)|round(1) }}" fill="url(#{{ uid }}sphsh)"/>
  {% endif %}
{% endmacro %}
{% macro soft_rect(x, y, w, h, r, dy) %}
  {% if DEPTH == 'neumo' %}
  {% set o = (dy * 0.9 + 1)|round(1) %}
  {% for g in (3.0, 1.8, 0.6) %}
  <rect x="{{ (x - g - o)|round(1) }}" y="{{ (y - g - o)|round(1) }}" width="{{ (w + 2 * g)|round(1) }}"
        height="{{ (h + 2 * g)|round(1) }}" rx="{{ (r + g)|round(1) }}" class="key-hl" opacity=".3"/>
  <rect x="{{ (x - g + o)|round(1) }}" y="{{ (y - g + o)|round(1) }}" width="{{ (w + 2 * g)|round(1) }}"
        height="{{ (h + 2 * g)|round(1) }}" rx="{{ (r + g)|round(1) }}" class="key-sh" opacity=".16"/>
  {% endfor %}
  {% elif DEPTH != 'flat' %}
  {% for g in (3.0, 1.8, 0.6) %}
  <rect x="{{ (x - g)|round(1) }}" y="{{ (y + dy - g * 0.5)|round(1) }}" width="{{ (w + 2 * g)|round(1) }}"
        height="{{ (h + 2 * g)|round(1) }}" rx="{{ (r + g)|round(1) }}" class="key-sh" opacity=".07"/>
  {% endfor %}
  {% endif %}
{% endmacro %}

{#- Клавиша-качалка: нажатая половина утоплена (градиент), разделитель
    посередине, диод у дальнего края. -#}
{% macro rocker(t) %}
  {% set k = t.key %}
  {% set r = 16 if k.kw > 50 else 11 %}
  <g class="rocker {{ 'on' if t.on }}">
    {{ soft_rect(k.kx, k.ky, k.kw, k.kh, r, 2.5) }}
    <rect x="{{ k.kx }}" y="{{ k.ky }}" width="{{ k.kw }}" height="{{ k.kh }}" rx="{{ r }}" class="key"/>
    {#- фаска: острая - скос по краю и плоское лицо внутри, без фаски -
        лицо плоское целиком; нажатую половину показывают тень и диод -#}
    {% if BEVEL == 'sharp' %}
    <rect x="{{ k.kx }}" y="{{ k.ky }}" width="{{ k.kw }}" height="{{ k.kh }}" rx="{{ r }}" fill="url(#{{ uid }}bev)"/>
    <rect x="{{ k.kx + 3 }}" y="{{ k.ky + 3 }}" width="{{ k.kw - 6 }}" height="{{ k.kh - 6 }}" rx="{{ r - 2.5 }}" class="key kface"/>
    {% endif %}
    {% if BEVEL != 'none' %}
    {% set ins = 3 if BEVEL == 'sharp' else 0 %}
    <rect x="{{ k.kx + ins }}" y="{{ k.ky + ins }}" width="{{ k.kw - 2 * ins }}" height="{{ k.kh - 2 * ins }}" rx="{{ r - ins * 0.8 }}"
          fill="url(#{{ uid }}{{ 'keyh' if k.horiz else 'key' }}-{{ 'on' if t.on else 'off' }})"/>
    {% endif %}
    {% if k.horiz %}
    <line x1="{{ k.kx + k.kw / 2 }}" y1="{{ k.ky + 8 }}" x2="{{ k.kx + k.kw / 2 }}" y2="{{ k.ky + k.kh - 8 }}" class="key-split"/>
    {% else %}
    <line x1="{{ k.kx + 8 }}" y1="{{ k.ky + k.kh / 2 }}" x2="{{ k.kx + k.kw - 8 }}" y2="{{ k.ky + k.kh / 2 }}" class="key-split"/>
    {% endif %}
    {{ diode(k.led, not t.on, k.horiz) }}
  </g>
{% endmacro %}

{#- Шар ленты (1.18): светится цветом света, по нему соты, вокруг
    слева дуга яркости, снизу точки теплоты. -#}
{% macro sphere(t) %}
  {% set k = t.sphere %}
  <defs>
    <radialGradient id="{{ uid }}sb{{ t.i }}" cx=".34" cy=".32" r=".72">
      <stop offset="0" stop-color="{{ k.c0 }}"/>
      <stop offset=".6" stop-color="{{ k.c1 }}"/>
      <stop offset="1" stop-color="{{ k.c2 }}"/>
    </radialGradient>
    <radialGradient id="{{ uid }}sh{{ t.i }}" cx=".5" cy=".5" r=".5">
      <stop offset=".45" stop-color="{{ k.hue }}" stop-opacity="{{ k.halo_op }}"/>
      <stop offset="1" stop-color="{{ k.hue }}" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <g class="sphere {{ 'on' if t.on }}">
    {% if t.on %}
    <circle cx="{{ k.cx }}" cy="{{ k.cy }}" r="{{ k.halo_r }}" fill="url(#{{ uid }}sh{{ t.i }})"/>
    {% endif %}
    <circle cx="{{ k.cx }}" cy="{{ k.cy + k.r * 0.07 }}" r="{{ k.r * 1.16 }}" fill="url(#{{ uid }}sphsh)"/>
    <circle cx="{{ k.cx }}" cy="{{ k.cy }}" r="{{ k.r }}" fill="url(#{{ uid }}sb{{ t.i }})"/>
    <path d="{{ k.seams }}" fill="none" stroke="{{ k.seam }}" stroke-opacity="{{ k.seam_op }}"
          stroke-width="{{ k.seam_w }}" stroke-linejoin="round"/>
    <circle cx="{{ k.cx }}" cy="{{ k.cy }}" r="{{ k.r }}" fill="url(#{{ uid }}sprim)"/>
    <circle cx="{{ k.cx }}" cy="{{ k.cy }}" r="{{ k.r }}" fill="url(#{{ uid }}spec)"/>
    <circle cx="{{ k.cx }}" cy="{{ k.cy }}" r="{{ k.r }}" fill="none" stroke="#FFFFFF" stroke-opacity=".14"/>
    <path d="{{ k.b_track }}" class="lvl-track sph-arc" stroke-width="{{ k.sw }}"/>
    {% if k.b_fill %}<path d="{{ k.b_fill }}" class="sph-fill" stroke-width="{{ k.sw }}"/>{% endif %}
    {% for d in k.dots %}
    <circle cx="{{ d.x }}" cy="{{ d.y }}" r="{{ k.dot_r }}" fill="{{ d.c }}" opacity="{{ '.95' if t.on else '.8' }}"/>
    {% endfor %}
    <circle cx="{{ k.knob_t.x }}" cy="{{ k.knob_t.y }}" r="{{ k.knob_r }}" class="sph-knob"/>
    <circle cx="{{ k.knob_b.x }}" cy="{{ k.knob_b.y }}" r="{{ k.knob_r }}" class="sph-knob"/>
    {% if k.led %}
    {{ diode({'x': k.led.x - 13, 'y': k.led.y - 3.25, 'w': 26, 'h': 6.5}, not t.on) }}
    {% endif %}
  </g>
{% endmacro %}

{#- Колесо диммера в прорези: цилиндр, рёбра сгущаются к краям. -#}
{% macro roller(t) %}
  {% set k = t.roll %}
  {% set horiz = k.kind == 'wide' %}
  <g class="roller {{ 'on' if t.on }}">
    <rect x="{{ k.kx - 4 }}" y="{{ k.ky - 4 }}" width="{{ k.kw + 8 }}" height="{{ k.kh + 8 }}" rx="5" class="slot"/>
    <rect x="{{ k.kx }}" y="{{ k.ky }}" width="{{ k.kw }}" height="{{ k.kh }}" rx="2" class="drum"/>
    {% for r in k.ribs %}
    <line x1="{{ r.x1 }}" y1="{{ r.y1 }}" x2="{{ r.x2 }}" y2="{{ r.y2 }}" class="rib" stroke-width="{{ r.w }}" opacity="{{ r.op }}"/>
    {% if horiz %}
    <line x1="{{ r.hx }}" y1="{{ r.y1 }}" x2="{{ r.hx }}" y2="{{ r.y2 }}" class="rib-hi" stroke-width="{{ r.hw }}" opacity="{{ r.hop }}"/>
    {% else %}
    <line x1="{{ r.x1 }}" y1="{{ r.hy }}" x2="{{ r.x2 }}" y2="{{ r.hy }}" class="rib-hi" stroke-width="{{ r.hw }}" opacity="{{ r.hop }}"/>
    {% endif %}
    {% endfor %}
    <rect x="{{ k.kx }}" y="{{ k.ky }}" width="{{ k.kw }}" height="{{ k.kh }}" rx="2" fill="url(#{{ uid }}{{ 'cylh' if horiz else 'cyl' }})"/>
    {% set b = k.bar %}
    {% if b.horiz %}
    <rect x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="4" rx="2" class="lvl-track"/>
    <rect x="{{ b.x }}" y="{{ b.y }}" width="{{ (b.w * t.level)|round(1) }}" height="4" rx="2" class="lvl"/>
    {% else %}
    <rect x="{{ b.x }}" y="{{ b.y }}" width="4" height="{{ b.h }}" rx="2" class="lvl-track"/>
    <rect x="{{ b.x }}" y="{{ (b.y + b.h * (1 - t.level))|round(1) }}" width="4" height="{{ (b.h * t.level)|round(1) }}" rx="2" class="lvl"/>
    {% endif %}
    {% if k.led %}
    {{ diode({'x': k.led.x - 13, 'y': k.led.y - 3.25, 'w': 26, 'h': 6.5}, not t.on) }}
    {% endif %}
  </g>
{% endmacro %}

{% macro plate(t) %}
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        class="plate {{ 'on' if t.on }}"/>
  {#- Неоморфизм: включённая плитка утоплена - тень у верхнего края внутри,
      свет у нижнего. Внешних теней у неё нет (panel.svg.j2). -#}
  {% if NEU and t.on %}
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        fill="url(#{{ uid }}neu-in)" class="neu-in"/>
  {% endif %}
  {#- кромка: у выпуклой свет сверху-слева, у утопленной - наоборот -#}
  {% if NEU %}
  <rect x="1.6" y="1.6" width="{{ t.w - 3.2 }}" height="{{ t.h - 3.2 }}" rx="{{ [rx - 0.6, 0]|max }}" fill="none"
        stroke="url(#{{ uid }}neu-edge{{ '-in' if t.on else '' }})" stroke-width="1.2"/>
  {% endif %}
  {{ sheen(t, t.on) }}
{% endmacro %}

{#- Тени плиток рисуются не здесь, а одним слоем под всеми плитками в
    panel.svg.j2 (shadow_layer): размытие одно на панель, а не на плитку. -#}
{% macro shadow(t) %}{% endmacro %}

{#- Отсвет поверх подложки - в тёмных темах (dark, graphite). Рамку не трогает:
    отступ в полторы точки внутрь. -#}
{% macro sheen(t, on=False) %}
  {% if PAL.info(theme).sheen %}
  <rect x="1.5" y="1.5" width="{{ t.w - 3 }}" height="{{ t.h - 3 }}" rx="{{ [rx - 0.5, 0]|max }}"
        fill="url(#{{ uid }}sheen{{ '-on' if on }})" class="sheen"/>
  {% endif %}
{% endmacro %}

{#- Значок устройства с бейджем режима в правом нижнем углу.
    Просвет под бейджем красится в цвет подложки чипа, поэтому значки
    устройств всегда живут внутри chip() - иначе цвет угадать нельзя. -#}
{% macro icon_badge(name, badge, size=26, knock='var(--tile)', badge_color=None) %}
  {% set s = size / 24.0 %}
  <use href="#{{ uid }}ic-{{ name }}" xlink:href="#{{ uid }}ic-{{ name }}"
       width="{{ size }}" height="{{ size }}"/>
  {% if badge %}
  <circle fill="{{ knock }}" stroke="none" cx="{{ 18.1 * s }}" cy="{{ 17.4 * s }}"
          r="{{ 5.4 * s }}"/>
  {#- Бейдж режима красится отдельно от корпуса: корпус говорит «что это»,
      цвет бейджа - «что оно делает». Синий холод, красный тепло, зелёный
      обдув читаются без подписей. -#}
  <g{% if badge_color %} color="{{ badge_color }}"{% endif %}>
    <use href="#{{ uid }}bg-{{ badge }}" xlink:href="#{{ uid }}bg-{{ badge }}"
         x="{{ 12.1 * s }}" y="{{ 11.4 * s }}"
         width="{{ 12 * s }}" height="{{ 12 * s }}"/>
  </g>
  {% endif %}
{% endmacro %}

{#- Чип строки состояния: маленькая плитка со значком и, если нужно,
    числом. Высота 36, радиус 10 - те же пропорции, что у больших плашек
    (RX 24 при высоте 170). Поля: 10 слева, 6 до числа, 12 справа -
    цифры прямоугольные и липнут к краю сильнее, чем скруглённый значок.
    active тонирует чип, как .plate.on тонирует плитку. -#}
{% macro chip(name, value=None, badge=None, active=False, w=None, badge_color=None,
              chart=None, chart_title=None, unit=None, alarm=False, attrs='') %}
  {% set icon_size = 26 %}
  {#- Значки воздуха у чипа - свои, через currentColor (см. ic-co2-s). -#}
  {% set name = name ~ '-s' if name in ('co2', 'voc') else name %}
  {#- Поля разные для двух случаев. Со значком и числом: 10 слева, 6 между,
      12 справа - цифры прямоугольные и липнут к краю сильнее, чем
      скруглённый значок. Без числа значок просто центрируется: поля 10 и 4
      выглядят как перекос вправо. -#}
  {% set pad_l = 10 if value else 7 %}
  {% set text_w = (value|length * 8.5) if value else 0 %}
  {% set width = w or (pad_l + icon_size + (6 + text_w + 12 if value else 7)) %}
  {#- Тревога - красный чип с белым значком, в обеих темах одинаково:
      протечку не должно быть видно хуже из-за оформления. -#}
  {% set ink = '#FFFFFF' if alarm else ('var(--active-ink)' if active else 'var(--stroke)') %}
  {% set knock = '#C4553B' if alarm else ('var(--active-soft)' if active else 'var(--tile)') %}
  {#- data-chart делает чип кнопкой: по нажатию открывается график канала.
      Ставится только там, где график осмыслен, - решает build_status. -#}
  <g color="{{ ink }}"{% if chart %} data-chart="{{ chart }}"
     data-chart-title="{{ chart_title }}" data-unit="{{ unit or '' }}"{% endif %}{{ attrs|safe }}>
    <rect class="chip{{ ' on' if active }}{{ ' alarm' if alarm }}" x="0.75" y="0.75"
          width="{{ width - 1.5 }}" height="34.5" rx="10"/>
    <g transform="translate({{ pad_l }},5)">
      {{ icon_badge(name, badge, icon_size, knock, badge_color) }}
    </g>
    {% if value %}
    <text class="chip-val" x="{{ width - 12 }}" y="23" text-anchor="end"{% if alarm %} fill="#FFFFFF" style="fill:#FFFFFF"{% endif %}>{{ value }}</text>
    {% endif %}
  </g>
{% endmacro %}

{% macro icon(name, size=27) %}
  {% if t is defined %}{% endif %}
  <use href="#{{ uid }}ic-{{ name }}" xlink:href="#{{ uid }}ic-{{ name }}"
       x="18" y="17" width="{{ size }}" height="{{ size }}"/>
{% endmacro %}

{#- мелкая плитка: иконка по центру сверху, короткая подпись снизу -#}
{#- LOW - плитка в половину высоты (одна ячейка, 78 px). Там подпись
    стоит на h-40, то есть ровно на значке: текст ложился поверх него.
    Значок уезжает влево и центрируется, текст - вправо от значка. -#}
{% set LOW = 117 %}
{#- Форма темы (с 1.32): глубина плиток и органов управления. -#}
{% set DEPTH = PAL.info(theme).depth %}
{% set NEU = DEPTH == 'neumo' %}
{#- Фаска ручек и клавиш (с 1.34): round - мягкий блик, none - плоское лицо,
    sharp - кольцо скоса вокруг плоского лица. -#}
{% set BEVEL = PAL.info(theme).bevel %}
{% macro icon_c(t, name, size=24) %}
  {% if t.compact %}
  <use href="#{{ uid }}ic-{{ name }}" xlink:href="#{{ uid }}ic-{{ name }}"
       x="{{ (t.w - size) / 2 }}" y="14" width="{{ size }}" height="{{ size }}"/>
  {% elif t.h < LOW %}
  <use href="#{{ uid }}ic-{{ name }}" xlink:href="#{{ uid }}ic-{{ name }}"
       x="16" y="{{ (t.h - size - 3) / 2 }}"
       width="{{ size + 3 }}" height="{{ size + 3 }}"/>
  {% else %}
  {#- На весь экран (fs > 1) значок растёт вместе с текстом. Толщина
      линии уже умножена на fs в .icon, и при прежних 27 единицах контур
      заплывал в кляксу. -#}
  {% set sz = ((size + 3) * (fs | float)) | round(1) %}
  <use href="#{{ uid }}ic-{{ name }}" xlink:href="#{{ uid }}ic-{{ name }}"
       x="18" y="17" width="{{ sz }}" height="{{ sz }}"/>
  {% endif %}
{% endmacro %}

{#- тумблер как на скриншотах: пилюля с бегунком, бегунок уезжает вправо -#}
{% macro toggle(t) %}
  {#- На половинной плитке - по середине высоты, вровень с подписью. -#}
  <g transform="translate(18,{{ ((t.h - 20) / 2) if (t.h < LOW and not t.compact) else 20 }})">
    <rect x="0" y="0" width="34" height="20" rx="10" fill="none"
          stroke="{{ 'var(--active)' if t.on else 'var(--stroke)' }}" stroke-width="2.2"/>
    <circle cx="{{ 23 if t.on else 11 }}" cy="10" r="6.2"
            fill="{{ 'var(--active)' if t.on else 'var(--stroke)' }}"/>
  </g>
{% endmacro %}

{% macro value_tr(t) %}
  {#- На половинной плитке значение во второй строке подписи, см. caption. -#}
  {% if t.short and not t.compact and t.h >= LOW %}
  <text x="{{ t.w - 20 }}" y="41" class="badge" text-anchor="end">{{ t.short }}</text>
  {% endif %}
{% endmacro %}

{#- Заголовок: одна строка или несколько, если в названии есть перенос.
    Строки идут снизу вверх, чтобы низ плитки оставался на месте. -#}
{% macro title_text(t, x, y, cls, anchor='start') %}
  {% set lines = t.title_lines or [t.title] %}
  {% for line in lines %}
  <text x="{{ x }}" y="{{ y - (lines|length - 1 - loop.index0) * 17 }}"
        class="{{ cls }}" text-anchor="{{ anchor }}">{{ line }}</text>
  {% endfor %}
{% endmacro %}

{% macro caption(t, status) %}
  {% if t.compact %}
  <text x="{{ t.w / 2 }}" y="{{ t.h - 13 }}" class="name-s" text-anchor="middle">{{ t.title_s or t.title }}</text>
  {% elif t.h < LOW %}
  {#- Половинная высота: название правее значка одной строкой (обрезано по
      ширине в assemble), под ним значение и состояние. Значение в углу,
      как на высокой плитке, на узкой ложилось поверх названия. -#}
  {% set lx = t.low_x or 56 %}
  {% set shown = status if (status and (t.show_status or t.always_status)) else '' %}
  {% set sub = (t.low_value ~ (' · ' ~ shown if shown else '')) if t.low_value else shown %}
  {% set lines = t.title_low or [t.title] %}
  {#- Строки идут по 17: две названия и значение - блок по центру высоты. -#}
  {% set n = lines|length + (1 if sub else 0) %}
  {% set y0 = t.h / 2 + 5 - (n - 1) * 17 / 2 %}
  {% for line in lines %}
  <text x="{{ lx }}" y="{{ y0 + loop.index0 * 17 }}" class="name">{{ line }}</text>
  {% endfor %}
  {% if sub %}
  <text x="{{ lx }}" y="{{ y0 + lines|length * 17 - 1 }}" class="status">{{ sub }}</text>
  {% endif %}
  {% elif status and (t.show_status or t.always_status) %}
  {{ title_text(t, 20, t.h - 40, 'name') }}
  <text x="20" y="{{ t.h - 18 }}" class="status">{{ status }}</text>
  {% else %}
  {{ title_text(t, 20, t.h - 20, 'name') }}
  {% endif %}
{% endmacro %}

{#- Индикатор состояния данных:
      серая точка  - канала нет в MQTT или у него флаг ошибки
      жёлтая точка - значение не обновлялось дольше 5 минут
    На обычной плитке живёт над подписью справа, на мелкой - в верхнем
    углу, иначе налезает на текст, который там по центру. -#}
{% macro badge_dot(t) %}
  {% set cx = (t.w - 12) if t.compact else (t.w - 20) %}
  {% set cy = 12 if t.compact else (t.h - 22) %}
  {% set r = 3 if t.compact else 3.5 %}
  {% if t.offline %}
  <circle cx="{{ cx }}" cy="{{ cy }}" r="{{ r }}" class="dot-off"/>
  {% elif t.stale %}
  <circle cx="{{ cx }}" cy="{{ cy }}" r="{{ r }}" class="dot-warn"/>
  {% endif %}
{% endmacro %}

{#- ---- области нажатия ----
    Прозрачные прямоугольники для зон, занимающих часть плитки: плюс и
    минус у термостата и всё, что появится дальше. Координаты считает
    сервер - плитка объявила зону, ядро перевело её в доли плитки, а
    шаблон только раскладывает. Рисуются последними, поверх содержимого,
    иначе нажатие ловит то, что нарисовано сверху. -#}
{% macro zone_rects(t) %}
{% for z in t.zones %}
  <rect x="{{ z.x }}" y="{{ z.y }}" width="{{ z.w }}" height="{{ z.h }}"
        fill="transparent" data-zone="{{ z.name }}"/>
{% endfor %}
{% endmacro %}

