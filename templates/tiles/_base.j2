      <circle class="icon" cx="10.4" cy="15.4" r="1.5"/>
    </g>
  </symbol>
  <symbol id="{{ uid }}ic-snow" viewBox="0 0 24 24">
    <path class="icon" d="M12 2.6v18.8M3.8 7.3l16.4 9.4M20.2 7.3L3.8 16.7"/>
