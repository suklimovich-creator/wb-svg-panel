  </symbol>
  {#- Протечка: капля заливкой плюс рябь - от простой капли отличается
      сразу, а простая капля уже занята влажностью. -#}
  <symbol id="{{ uid }}ic-leak" viewBox="0 0 24 24">
    <path class="sicon-fill" d="M12 2.6s5.2 5.8 5.2 9.2a5.2 5.2 0 1 1-10.4 0C6.8 8.4 12 2.6 12 2.6z"/>
    <path class="sicon" d="M4.6 20.6c1.5 1.3 3 1.3 4.5 0s3-1.3 4.5 0 3 1.3 4.5 0"/>
  </symbol>
  {#- Устройства: корпус узнаётся по силуэту, режим читается бейджем.
      Сдвиг вправо оптический - масса корпуса лежит левее середины. -#}
  <symbol id="{{ uid }}ic-ac-unit" viewBox="0 0 24 24">
    <g transform="translate(0.5,-0.4)">
      <rect class="sicon" x="2.6" y="4.2" width="14.6" height="6.4" rx="2"/>
      <path class="sicon" d="M5.2 8.8h9.4"/>
      <path class="sicon" d="M4.4 14.2c1.2 1.1 2.4 1.1 3.6 0s2.4-1.1 3.6 0"/>
