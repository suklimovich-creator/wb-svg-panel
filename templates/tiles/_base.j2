  <symbol id="{{ uid }}bg-water" viewBox="0 0 12 12">
    <path class="sicon-fill" d="M6 1.6s2.8 3.1 2.8 4.9a2.8 2.8 0 1 1-5.6 0C3.2 4.7 6 1.6 6 1.6z"/>
