    <path class="icon" d="M13.4 18.2s2 2.1 2 3.1a2 2 0 1 1-4 0c0-1 2-3.1 2-3.1z"/>
  </symbol>
  <symbol id="{{ uid }}ic-sun" viewBox="0 0 24 24">
