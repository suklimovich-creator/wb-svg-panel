  </symbol>
  <symbol id="{{ uid }}ic-cart" viewBox="0 0 24 24">
    <path class="icon" d="M3 4.5h2.4l2.3 10.2h10.1l2-7.2H6.4"/>
    <circle class="icon" cx="9.2" cy="18.8" r="1.4"/>
    <circle class="icon" cx="16.4" cy="18.8" r="1.4"/>
  </symbol>
  <symbol id="{{ uid }}ic-bulb" viewBox="0 0 24 24">
    <path class="icon" d="M12 3.2a5.7 5.7 0 0 0-3.3 10.3c.6.4.9 1 .9 1.7v.4h4.8v-.4c0-.7.3-1.3.9-1.7A5.7 5.7 0 0 0 12 3.2z"/>
    <path class="icon" d="M9.9 18.7h4.2M10.7 21h2.6"/>
  </symbol>
  <symbol id="{{ uid }}ic-strip" viewBox="0 0 24 24">
    <path class="icon" d="M3 8.5h18v3.2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
