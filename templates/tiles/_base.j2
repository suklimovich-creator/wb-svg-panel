  </symbol>
  {#- Камера: корпус кубиком и объектив. Именно кубик, а не купол -
      он у нас на столе и такой формы, значок должен узнаваться. -#}
  <symbol id="{{ uid }}ic-camera" viewBox="0 0 24 24">
