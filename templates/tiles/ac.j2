{#-
  Кондиционер: колесо режимов и створки жалюзи.

  Часть templates/panel.svg.j2, вынесенная в отдельный файл при
  разделении шаблона. Импортируется с контекстом: макросам нужны
  uid, fs и rx, общие для всего документа.
-#}

{% import "tiles/_base.j2" as base with context %}

{#- Стили этого файла. Элемент <style> в SVG остаётся один:
    resolve_css_vars разбирает только первый, и в остальных
    var() уехал бы на контроллер неразвёрнутым, а librsvg и
    старые WebView такое молча игнорируют. Поэтому каркас
    склеивает куски, а не выпускает несколько блоков. -#}
{% macro style() %}
  .wheel.off .wlab.near { fill: var(--ink-dim); }
  /* шкала кондиционера */
  .warc        { fill: none; stroke: var(--active); stroke-width: calc(2.4px * var(--fs));
                 opacity: .85; }
  .wtick       { stroke: var(--ink); stroke-width: calc(1px * var(--fs)); opacity: .28; }
  .wtick.major { stroke-width: calc(1.6px * var(--fs)); opacity: .5; }
  .wnotch      { fill: none; stroke: var(--ink-dim); stroke-width: calc(1.5px * var(--fs));
                 stroke-linecap: round; stroke-linejoin: round; }
  .wlab        { font-size: calc(11px * var(--fs)); fill: var(--ink-faint); }
  /* выбранное значение заметно крупнее соседних - взгляд цепляется за него */
  .wlab.near   { font-size: calc(23px * var(--fs)); font-weight: 700; fill: var(--ink);
                 letter-spacing: -.5px; }
  /* Выключенный: бледнее, но не до исчезновения - на белой карточке
     при .45 шкала пропадала совсем. */
  .wheel.off   { opacity: .62; }

  /* ---- колесо кондиционера (с 1.15) ---------------------------------
     Цвета - из --ac-* палитры темы. Выключенный - серый диск. */
  .acd-disk          { fill: var(--ac-disk); }
  .acd.off .acd-disk { fill: var(--ac-off); }
  .acd-seg           { fill: none; stroke: var(--ac-seg-cool); stroke-linecap: round; }
  .acd.heat .acd-seg { stroke: var(--ac-seg-heat); }
  .acd-to            { stroke: var(--ink); stroke-linecap: round; opacity: .5; }
  .acd-ti            { stroke: var(--ac-ink); stroke-linecap: round; opacity: .5; }
  .acd-to.mj, .acd-ti.mj { opacity: .9; }
  .acd.off .acd-ti   { stroke: var(--ac-off-ink); }
  .acd-lab           { fill: var(--ac-dim); font-weight: 600; }
  .acd.off .acd-lab  { fill: var(--ac-off-dim); }
  .acd-mi            { stroke: var(--ac-ink); stroke-linecap: round; }
  .acd.off .acd-mi   { stroke: var(--ac-off-ink); }
  .acd-mo            { stroke: var(--ink); stroke-linecap: round; }
  .acd-cm            { stroke: var(--ac-seg-cool); stroke-linecap: round; }
  .acd.heat .acd-cm  { stroke: var(--ac-seg-heat); }
  .acd.off .acd-cm   { stroke: var(--ink-dim); }
  .acd-num           { fill: var(--ac-ink); font-weight: 650; letter-spacing: -1px; }
  .acd.off .acd-num  { fill: var(--ac-off-ink); }
  .acd-deg           { font-weight: 500; }
  .acd-word          { fill: var(--ac-ink); font-weight: 650; }
  .acd.off .acd-word { fill: var(--ac-off-dim); }
  .acd-ic            { color: var(--ac-ink); }
  .acd.off .acd-ic   { color: var(--ac-off-dim); }
  .acd-bar           { fill: var(--ac-dim); }
  .acd-bar.on        { fill: var(--ac-ink); }
  .acd-fan           { fill: var(--ac-ink); font-weight: 650; }
  .acd-hid           { display: none; }
  .acd-now           { fill: var(--ink-dim); font-weight: 500; }
  .acd-cur           { fill: var(--ink); font-weight: 650; letter-spacing: -1px; }
  .acd-name          { fill: var(--ink); font-weight: 500; }
  /* значки жалюзи: веер лопастей и стрелка качания */
  .acl-bg            { fill: var(--ac-pill); }
  .acl.swing .acl-bg { fill: var(--ac-pill-on); }
  .acl-b             { stroke: var(--ink-dim); stroke-linecap: round; opacity: .55; }
  .acl-b.act         { stroke: var(--ink); opacity: 1; }
  .acl.swing .acl-b  { stroke: var(--ac-pill-ink); opacity: 1; }
  .acl-a             { fill: none; stroke: var(--ink-dim); stroke-linecap: round; }
  .acl.swing .acl-a  { stroke: var(--ac-pill-ink); }

  /* ---- пульт на весь экран (с 1.16) ---------------------------------
     Внутри диска - чернила диска, снаружи - чернила плитки; какие
     именно, решает сборщик (inside) и ставит класс .in. */
  .acs-bg            { fill: var(--tile); }
  .acs-disk          { fill: var(--ac-disk); }
  .acs.off .acs-disk { fill: var(--ac-off); }
  .acs-ink           { fill: var(--ink); }
  .acs-ink.in        { fill: var(--ac-ink); }
  .acs.off .acs-ink.in { fill: var(--ac-off-ink); }
  .acs-dim           { fill: var(--ink-dim); }
  .acs-dim.in        { fill: var(--ac-dim); }
  .acs-seg           { fill: none; stroke: var(--ac-seg-cool); stroke-linecap: round; }
  .acs.heat .acs-seg { stroke: var(--ac-seg-heat); }
  .acs-cm            { stroke: var(--ac-seg-cool); stroke-linecap: round; }
  .acs.heat .acs-cm  { stroke: var(--ac-seg-heat); }
  .acs-to            { stroke: var(--ink); stroke-linecap: round; opacity: .5; }
  .acs-ti            { stroke: var(--ac-ink); stroke-linecap: round; opacity: .5; }
  .acs-to.mj, .acs-ti.mj { opacity: .9; }
  .acs.off .acs-ti   { stroke: var(--ac-off-ink); }
  .acs-lab           { fill: var(--ac-dim); font-weight: 600; }
  .acs.off .acs-lab  { fill: var(--ac-off-dim); }
  .acs-mi            { stroke: var(--ac-ink); stroke-linecap: round; }
  .acs.off .acs-mi   { stroke: var(--ac-off-ink); }
  .acs-mo            { stroke: var(--ink); stroke-linecap: round; }
  .acs-num           { fill: var(--ac-ink); font-weight: 650; letter-spacing: -1px; }
  .acs.off .acs-num  { fill: var(--ac-off-ink); }
  .acs-ic            { color: var(--ink); }
  .acs-ic.in         { color: var(--ac-ink); }
  .acs.off .acs-ic.in { color: var(--ac-off-dim); }
  .acs-hid           { display: none; }
  .acs-ring          { fill: none; stroke: var(--ink-dim); opacity: .55; }
  .acs-ring.in       { stroke: var(--ac-dim); }
  .acs-ring.on       { stroke: var(--ink); opacity: 1; }
  .acs-ring.in.on    { stroke: var(--ac-ink); }
  .acs-ring.auto     { stroke-dasharray: 3 3; }
  .acs-blade         { fill: var(--ink); }
  .acs-blade.in      { fill: var(--ac-ink); }
  .acs-hubc          { fill: var(--tile); stroke: var(--ink); }
  .acs-hubc.in       { fill: var(--ac-disk); stroke: var(--ac-ink); }
  .acs-badge         { fill: var(--ink); }
  .acs-badge.in      { fill: var(--ac-ink); }
  .acs-badge-t       { fill: var(--tile); font-weight: 750; }
  .acs-badge-t.in    { fill: var(--ac-disk); }
  .acs-fan-bg        { fill: var(--ac-disk); }
  /* пропеллер крутится сам - CSS, без перерисовки; кто просил меньше
     движения - стоит */
  .acs-spin          { transform-origin: 0 0; animation: acs-spin 1.3s linear infinite; }
  @keyframes acs-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .acs-spin { animation: none; } }
  .acs-gear          { fill: var(--ac-disk); }
  .acs-arrow         { fill: none; stroke: var(--ink-dim); stroke-linecap: round; stroke-linejoin: round; opacity: .6; }
  .acs-arrow.on      { stroke: var(--ac-pill-on); opacity: 1; }
  .acs-dial.auto .acs-arrow.on { stroke: var(--ink); }
  .acs-ptr           { stroke: var(--ac-ink); stroke-linecap: round; }
  .acs-dial.auto .acs-ptr { display: none; }
  .acs-hub           { fill: var(--ac-disk); stroke: var(--ac-ink); }
  .acs-dial.auto .acs-hub { fill: var(--ac-ink); }
  .acs-hub-t         { fill: var(--ac-ink); font-weight: 750; }
  .acs-dial.auto .acs-hub-t { fill: var(--ac-disk); }
  .acs-btn           { fill: var(--ac-pill); }
  .acs-btn-ink       { stroke: var(--ink); fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .acs-pw            { fill: var(--ac-pill-on); }
  .acs-pw-ink        { stroke: var(--ac-pill-ink); fill: none; stroke-linecap: round; }
  .acs.off .acs-pw   { fill: var(--ac-pill); }
  .acs.off .acs-pw-ink { stroke: var(--ink); }
  .acs-ch            { display: none; }
  .acs-ch.open       { display: inline; }
  .acs-ch-bg         { fill: var(--tile); opacity: .98; }
  .acs-ch-line       { fill: var(--ink-dim); opacity: .4; }
  .acs-pill          { fill: var(--ac-pill); }
  .acs-pill.on       { fill: var(--ac-pill-on); }
  .acs-pill-t        { fill: var(--ink); font-weight: 600; }
  .acs-pill-t.on     { fill: var(--ac-pill-ink); }
  .acs-pill-ic       { color: var(--ink); }
  .acs-pill-ic.on    { color: var(--ac-pill-ink); }
  .acs-shade         { fill: var(--shadow); }
  .acs-lit           { fill: none; stroke: #FFFFFF; stroke-opacity: .14; }
{% endmacro %}

{#- ---- кондиционер ----
    Уставка читается прямо на шкале - выбранное значение крупное, соседние
    приглушённые. Отдельной цифры под дугой нет, она дублировала. Внизу
    фактическая температура и режим работы. -#}
{% macro tile_ac(t) %}
  {% if t.screen %}
  {{ screen(t) }}
  {% elif t.disk and not t.compact and t.h >= 150 %}
  {{ disk(t) }}
  {% else %}
  {{ base.plate(t) }}
  {#- В половинную высоту дуга не помещается: там плитка как у прочих. -#}
  {% if t.wheel and not t.compact and t.h >= base.LOW %}
    <g class="wheel {{ 'off' if not t.on }}">
      {% for lb in t.wheel.labels %}
      <text x="{{ lb.x }}" y="{{ lb.y }}" text-anchor="middle"
            class="wlab{{ ' near' if lb.near }}">{{ lb.text }}</text>
      {% endfor %}
      {% for tk in t.wheel.ticks %}
      <line x1="{{ tk.x1 }}" y1="{{ tk.y1 }}" x2="{{ tk.x2 }}" y2="{{ tk.y2 }}"
            class="wtick{{ ' major' if tk.major }}"/>
      {% endfor %}
      <path d="{{ t.wheel.arc }}" class="warc"/>
      <path class="wnotch"
            d="M {{ t.wheel.cx - 6 }},{{ t.wheel.cy + 16 }}
               L {{ t.wheel.cx }},{{ t.wheel.cy + 7 }}
               L {{ t.wheel.cx + 6 }},{{ t.wheel.cy + 16 }}"/>
    </g>

    {{ base.icon_c(t, t.icon, 22) }}
    <text x="{{ t.w - 18 }}" y="30" class="tag" text-anchor="end">{{ t.title|upper }}</text>

    {#- низ плитки: фактическая температура, режим и положение лопастей -#}
    {% if t.current %}
    <text x="20" y="{{ t.h - 38 }}" class="dial-sub">сейчас {{ t.current }}</text>
    {% endif %}
    <text x="20" y="{{ t.h - 16 }}" class="dial-mode">{{ t.status }}</text>
    {% if t.louver %}
    <g class="louver" transform="translate({{ t.w - 68 }},{{ t.h - 40 }})">
      <line x1="0" y1="1" x2="19" y2="1" class="lvhouse"/>
      {% for b in t.louver.blades %}
      <line x1="{{ b.x1 }}" y1="{{ b.y1 }}" x2="{{ b.x2 }}" y2="{{ b.y2 }}"
            class="lvblade" opacity="{{ b.op }}"/>
      {% endfor %}
    </g>
    {% endif %}
    {% if t.louver_h %}
    <g class="louver" transform="translate({{ t.w - 40 }},{{ t.h - 40 }})">
      <line x1="1" y1="0" x2="1" y2="19" class="lvhouse"/>
      {% for b in t.louver_h.blades %}
      <line x1="{{ b.x1 }}" y1="{{ b.y1 }}" x2="{{ b.x2 }}" y2="{{ b.y2 }}"
            class="lvblade" opacity="{{ b.op }}"/>
      {% endfor %}
    </g>
    {% endif %}
  {% else %}
    {{ base.icon_c(t, t.icon, 24) }}
    {% if t.current and not t.compact and t.h >= base.LOW %}
    <text x="{{ t.w - 20 }}" y="41" class="badge" text-anchor="end">{{ t.current }}</text>
    {% endif %}
    {% if t.h < base.LOW and not t.compact %}
    {#- половинная: всё в подписи справа от значка, см. _fit_low -#}
    {% elif t.compact %}
    <text x="{{ t.w / 2 }}" y="{{ '%.0f'|format(t.h * 0.62) }}" class="mid"
          text-anchor="middle">{{ t.target }}</text>
    {% else %}
    <text x="20" y="{{ t.h - 62 }}" class="big">{{ t.target }}</text>
    {% endif %}
    {{ base.caption(t, '' if t.h < base.LOW else t.status) }}
  {% endif %}
  {% endif %}
{% endmacro %}



{#- ---- кондиционер: залитое колесо ----
    Диск больше плитки, видна только его часть. Уставка - большая цифра у
    своей риски, факт - снаружи, внизу слева над названием. Данные для
    пульта лежат в data-атрибутах группы: он крутит шкалу при
    перетаскивании, не перерисовывая плитку. -#}
{% macro disk(t) %}
  {% set d = t.disk %}
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}" class="plate"/>
  {{ base.sheen(t, False) }}
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
  <g class="acd {{ d.kind }}{{ ' off' if not t.on }}" data-cx="{{ d.cx }}" data-cy="{{ d.cy }}"
     data-r="{{ d.r }}" data-rr="{{ d.rr }}" data-dpd="{{ d.dpd }}" data-asp="{{ d.a_sp }}"
     data-val="{{ d.value }}" data-lo="{{ d.lo }}" data-hi="{{ d.hi }}"
     data-cur="{{ d.cur if d.cur is not none else '' }}" data-box="{{ d.box|join(',') }}"
     data-labr="{{ d.lab_r }}" data-w="{{ t.w }}" data-h="{{ t.h }}" data-fs="{{ fs }}"
     data-on="{{ '1' if t.on else '0' }}">
    <circle cx="{{ d.cx }}" cy="{{ d.cy }}" r="{{ d.r }}" class="acd-disk"/>
    {% if d.teeth %}<path d="{{ d.teeth }}" class="acd-disk"/>{% endif %}
    <path d="{{ d.seg or 'M 0,0' }}" class="acd-seg{{ ' acd-hid' if not d.seg }}" stroke-width="{{ d.seg_w }}"/>
    <g class="acd-scale">
      {% for k in d.ticks %}
      <g class="acd-tk{{ ' acd-hid' if k.hide }}" data-t="{{ k.t }}">
      <line x1="{{ k.ox1 }}" y1="{{ k.oy1 }}" x2="{{ k.ox2 }}" y2="{{ k.oy2 }}" class="acd-to{{ ' mj' if k.major }}"
            stroke-width="{{ d.tk_w if k.major else d.tk_w2 }}"/>
      <line x1="{{ k.ix1 }}" y1="{{ k.iy1 }}" x2="{{ k.ix2 }}" y2="{{ k.iy2 }}" class="acd-ti{{ ' mj' if k.major }}"
            stroke-width="{{ d.tk_w if k.major else d.tk_w2 }}"/>
      </g>
      {% endfor %}
      {% for l in d.labels %}
      <text x="{{ l.x }}" y="{{ l.y }}" font-size="{{ d.lab_size }}" text-anchor="middle" data-t="{{ l.t }}"
            class="acd-lab{{ ' acd-hid' if l.hide }}" transform="rotate({{ l.rot }} {{ l.x }} {{ l.ry }})">{{ l.text }}</text>
      {% endfor %}
      {% if d.cur_mark %}
      <line x1="{{ d.cur_mark.x1 }}" y1="{{ d.cur_mark.y1 }}" x2="{{ d.cur_mark.x2 }}" y2="{{ d.cur_mark.y2 }}"
            class="acd-cm" stroke-width="{{ d.cur_mark.w }}"/>
      {% endif %}
    </g>
    <line x1="{{ d.mark.x1 }}" y1="{{ d.mark.y1 }}" x2="{{ d.mark.x2 }}" y2="{{ d.mark.y2 }}"
          class="acd-mi" stroke-width="{{ d.mark.wi }}"/>
    <line x1="{{ d.mark.x2 }}" y1="{{ d.mark.y2 }}" x2="{{ d.mark.x3 }}" y2="{{ d.mark.y3 }}"
          class="acd-mo" stroke-width="{{ d.mark.wo }}"/>
    <text x="{{ d.num.x }}" y="{{ d.num.y }}" font-size="{{ d.num.size }}" text-anchor="middle"
          class="acd-num"><tspan class="acd-v">{{ d.num.text }}</tspan><tspan class="acd-deg"
          font-size="{{ d.num.deg }}" dy="{{ d.num.dy }}">°</tspan></text>
    {% set m = d.mode %}
    <g class="acd-ic"><use href="#{{ uid }}ic-{{ m.icon }}" xlink:href="#{{ uid }}ic-{{ m.icon }}"
         x="{{ m.ix }}" y="{{ m.iy }}" width="{{ m.isize }}" height="{{ m.isize }}"/></g>
    <text x="{{ m.x }}" y="{{ m.y }}" font-size="{{ m.size }}" text-anchor="end" class="acd-word">{{ m.word }}</text>
    {% for b in m.bars %}
    <rect x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ b.h }}" rx="1.4" class="acd-bar{{ ' on' if b.on }}"/>
    {% endfor %}
    {% if m.fan_text %}
    <text x="{{ m.fan_x }}" y="{{ m.fan_y }}" font-size="{{ m.size * 0.95 }}" text-anchor="end" class="acd-fan">{{ m.fan_text }}</text>
    {% endif %}
  </g>
  </g>
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}" class="rim"/>
  {% for ic in d.icons %}
  <g class="acl{{ ' swing' if ic.swing and t.on }}">
    <circle cx="{{ ic.cx }}" cy="{{ ic.cy }}" r="{{ ic.r }}" class="acl-bg"/>
    {% for b in ic.blades %}
    <line x1="{{ b.x1 }}" y1="{{ b.y1 }}" x2="{{ b.x2 }}" y2="{{ b.y2 }}" stroke-width="{{ b.w }}"
          class="acl-b{{ ' act' if b.act and t.on }}"/>
    {% endfor %}
    <path d="{{ ic.arrow }}" class="acl-a" stroke-width="{{ ic.sw }}"/>
  </g>
  {% endfor %}
  {% set n = d.now %}
  <text x="{{ n.lx }}" y="{{ n.ly }}" font-size="{{ n.lsize }}" text-anchor="middle" class="acd-now">сейчас</text>
  <text x="{{ n.x }}" y="{{ n.y }}" font-size="{{ n.size }}" text-anchor="middle" class="acd-cur">{{ n.text }}<tspan
        class="acd-deg" font-size="{{ n.deg }}" dy="{{ n.dy }}">°</tspan></text>
  <text x="20" y="{{ d.title_y }}" font-size="{{ d.title_size }}" class="acd-name">{{ t.title }}</text>
{% endmacro %}

{#- ---- кондиционер на весь экран (с 1.16) ----
    Колесо с зубчатым ободом, вентилятор кольцами на месте уставки другого
    режима, два малых колеса жалюзи, «назад» и питание. Где что лежит -
    решает раскладка в ac_disk.SCREEN; жесты разбирает пульт (padScreen)
    по data-z у элементов. Тени - как у плиток панели: у светлых тем две,
    у тёмных вместо тени светлая кромка. -#}
{% macro shade(x, y, r, s) %}
  {% set dark = theme in ('dark', 'graphite') %}
  {% if dark %}
  <circle cx="{{ x }}" cy="{{ y }}" r="{{ r + 0.6 }}" class="acs-lit" stroke-width="1.2"/>
  {% else %}
  {% set amb = {'light': 0.13, 'autumn': 0.16, 'retro': 0.20, 'noir': 0.24}.get(theme, 0.13) %}
  {% set key = {'light': 0.08, 'autumn': 0.09, 'retro': 0.12, 'noir': 0.14}.get(theme, 0.08) %}
  <circle cx="{{ x }}" cy="{{ y + s.sh_dy }}" r="{{ r * 0.96 }}" class="acs-shade" opacity="{{ amb }}" filter="url(#{{ uid }}acs-amb)"/>
  <circle cx="{{ x }}" cy="{{ y + s.sh_dy2 }}" r="{{ r }}" class="acs-shade" opacity="{{ key }}" filter="url(#{{ uid }}acs-key)"/>
  {% endif %}
{% endmacro %}

{% macro screen(t) %}
  {% set s = t.screen %}
  <defs>
    <filter id="{{ uid }}acs-amb" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="{{ s.sh_blur }}"/></filter>
    <filter id="{{ uid }}acs-key" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="{{ s.sh_key }}"/></filter>
    <linearGradient id="{{ uid }}acs-gl" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity=".22"/>
      <stop offset=".55" stop-color="#FFFFFF" stop-opacity="0"/>
      <stop offset="1" stop-color="#000000" stop-opacity=".16"/>
    </linearGradient>
    <clipPath id="{{ uid }}acs-clip"><rect width="{{ s.w }}" height="{{ s.h }}"/></clipPath>
  </defs>
  <g class="acs {{ s.kind }}{{ ' off' if not t.on }}" clip-path="url(#{{ uid }}acs-clip)"
     data-cx="{{ s.cx }}" data-cy="{{ s.cy }}" data-r="{{ s.r }}" data-rr="{{ s.rr }}" data-dpd="{{ s.dpd }}"
     data-asp="{{ s.a_sp }}" data-val="{{ s.value }}" data-lo="{{ s.lo }}" data-hi="{{ s.hi }}"
     data-cur="{{ s.cur if s.cur is not none else '' }}" data-box="{{ s.box|join(',') }}" data-labr="{{ s.lab_r }}"
     data-w="{{ s.w }}" data-h="{{ s.h }}" data-fs="{{ s.fs }}" data-on="{{ '1' if t.on else '0' }}"
     data-notarget="{{ '1' if s.no_target else '0' }}" data-orient="{{ s.orient }}">
    <rect width="{{ s.w }}" height="{{ s.h }}" class="acs-bg"/>
    {#- колесо уставки -#}
    <g data-z="wheel">
      {{ shade(s.cx, s.cy, s.r, s) }}
      <circle cx="{{ s.cx }}" cy="{{ s.cy }}" r="{{ s.r }}" class="acs-disk"/>
      <path d="{{ s.seg or 'M 0,0' }}" class="acs-seg{{ ' acs-hid' if not s.seg }}" stroke-width="{{ s.seg_w }}"/>
      <g class="acs-scale">
        {% if s.teeth %}<path d="{{ s.teeth }}" class="acs-disk"/>{% endif %}
        {% for k in s.ticks %}
        <g class="acs-tk{{ ' acs-hid' if k.hide }}" data-t="{{ k.t }}">
        <line x1="{{ k.ox1 }}" y1="{{ k.oy1 }}" x2="{{ k.ox2 }}" y2="{{ k.oy2 }}" class="acs-to{{ ' mj' if k.major }}"
              stroke-width="{{ s.tk_w if k.major else s.tk_w2 }}"/>
        <line x1="{{ k.ix1 }}" y1="{{ k.iy1 }}" x2="{{ k.ix2 }}" y2="{{ k.iy2 }}" class="acs-ti{{ ' mj' if k.major }}"
              stroke-width="{{ s.tk_w if k.major else s.tk_w2 }}"/>
        </g>
        {% endfor %}
        {% for l in s.labels %}
        <text x="{{ l.x }}" y="{{ l.y }}" font-size="{{ s.lab_size }}" text-anchor="middle" dominant-baseline="central"
              data-t="{{ l.t }}" class="acs-lab{{ ' acs-hid' if l.hide }}" transform="rotate({{ l.rot }} {{ l.x }} {{ l.y }})">{{ l.text }}</text>
        {% endfor %}
        {% if s.cur_mark %}
        <line x1="{{ s.cur_mark.x1 }}" y1="{{ s.cur_mark.y1 }}" x2="{{ s.cur_mark.x2 }}" y2="{{ s.cur_mark.y2 }}"
              class="acs-cm" stroke-width="{{ s.cur_mark.w }}"/>
        {% endif %}
      </g>
      <circle cx="{{ s.cx }}" cy="{{ s.cy }}" r="{{ s.r + s.lift + 2 }}" fill="url(#{{ uid }}acs-gl)" pointer-events="none"/>
      {% if not s.no_target %}
      <line x1="{{ s.mark.x1 }}" y1="{{ s.mark.y1 }}" x2="{{ s.mark.x2 }}" y2="{{ s.mark.y2 }}" class="acs-mi" stroke-width="{{ s.mark.wi }}"/>
      <line x1="{{ s.mark.x2 }}" y1="{{ s.mark.y2 }}" x2="{{ s.mark.x3 }}" y2="{{ s.mark.y3 }}" class="acs-mo" stroke-width="{{ s.mark.wo }}"/>
      {% endif %}
      <text x="{{ s.num.x }}" y="{{ s.num.y }}" font-size="{{ s.num.size }}" text-anchor="middle" class="acs-num"><tspan
            class="acs-v">{{ s.num.text }}</tspan>{% if not s.no_target %}<tspan font-size="{{ s.num.deg }}" dy="{{ s.num.dy }}">°</tspan>{% endif %}</text>
    </g>
    {#- режим: нажатие открывает выбор -#}
    {% set m = s.mode %}
    <g data-z="mode">
      <rect x="{{ m.hit[0] }}" y="{{ m.hit[1] }}" width="{{ m.hit[2] }}" height="{{ m.hit[3] }}" fill="transparent"/>
      <g class="acs-ic{{ ' in' if m.inside }}"><use href="#{{ uid }}ic-{{ m.icon }}" xlink:href="#{{ uid }}ic-{{ m.icon }}"
         x="{{ m.ix }}" y="{{ m.iy }}" width="{{ m.isize }}" height="{{ m.isize }}"/></g>
      <text x="{{ m.x }}" y="{{ m.y }}" font-size="{{ m.size }}" font-weight="650" text-anchor="{{ m.anchor }}"
            class="acs-ink{{ ' in' if m.inside }}">{{ m.word }}</text>
    </g>
    {#- вентилятор: пропеллер, вокруг кольца скоростей -#}
    {% set f = s.fan %}
    <g data-z="fan" data-fx="{{ f.x }}" data-fy="{{ f.y }}" data-fr="{{ f.r }}" data-rg="{{ f.rg }}"
       data-state="{{ f.state }}" data-sw="{{ f.sw }}" data-swon="{{ f.sw_on }}" class="acs-fan">
      {% if not f.inside %}{{ shade(f.x, f.y, f.r + 3 * f.rg, s) }}
      <circle cx="{{ f.x }}" cy="{{ f.y }}" r="{{ f.r + 3 * f.rg + 4 }}" class="acs-fan-bg"/>{% endif %}
      <circle cx="{{ f.x }}" cy="{{ f.y }}" r="{{ f.hit }}" fill="transparent"/>
      {% for g in f.rings %}
      <circle cx="{{ f.x }}" cy="{{ f.y }}" r="{{ g.r }}" data-ring="{{ g.i }}"
              class="acs-ring in{{ ' on' if t.on and f.ring and g.i <= f.ring }}{{ ' auto' if t.on and f.state in ('auto', 'quiet') }}"
              stroke-width="{{ f.sw_on if t.on and g.i == f.ring else f.sw }}"/>
      {% endfor %}
      <g transform="translate({{ f.x }} {{ f.y }})" pointer-events="none">
        <g class="{{ 'acs-spin' if f.spin }}" style="animation-duration: {{ f.spin or 1 }}s">
          <path d="{{ f.blades }}" class="acs-blade in"/>
          <circle r="{{ f.hub }}" class="acs-hubc in" stroke-width="{{ f.hubw }}"/>
        </g>
      </g>
      <g class="acs-fbadge{{ ' acs-hid' if not (t.on and f.state in ('auto', 'quiet')) }}" pointer-events="none">
        <circle cx="{{ f.bx }}" cy="{{ f.by }}" r="{{ f.badge }}" class="acs-badge in"/>
        {% if f.state == 'quiet' %}
        <g class="acs-ic"><use href="#{{ uid }}ic-moon" xlink:href="#{{ uid }}ic-moon" x="{{ f.bx - f.badge * 0.7 }}"
           y="{{ f.by - f.badge * 0.7 }}" width="{{ f.badge * 1.4 }}" height="{{ f.badge * 1.4 }}" style="color: var(--ac-disk)"/></g>
        {% else %}
        <text x="{{ f.bx }}" y="{{ f.by }}" font-size="{{ f.badge * 1.25 }}" text-anchor="middle" dominant-baseline="central"
              class="acs-badge-t in">A</text>
        {% endif %}
      </g>
    </g>
    {#- малые колёса жалюзи: «A» в центре - качание -#}
    {% for key in ('vdial', 'hdial') %}
    {% set d = s[key] %}
    {% if d %}
    <g data-z="{{ key }}" class="acs-dial{{ ' auto' if d.auto }}" data-x="{{ d.x }}" data-y="{{ d.y }}"
       data-hub="{{ d.hub }}" data-angs="{{ d.angs|join(',') }}" data-values="{{ d.vals|join(',') }}"
       data-active="{{ d.active }}" data-p1="{{ d.p1 }}" data-p2="{{ d.p2 }}" data-aw="{{ d.aw }}" data-awon="{{ d.aw_on }}">
      <circle cx="{{ d.x }}" cy="{{ d.y }}" r="{{ d.hit }}" fill="transparent"/>
      {{ shade(d.x, d.y, d.r, s) }}
      <path d="{{ d.gear }}" class="acs-gear"/>
      <circle cx="{{ d.x }}" cy="{{ d.y }}" r="{{ d.r }}" fill="url(#{{ uid }}acs-gl)" pointer-events="none"/>
      {% for a in d.arrows %}
      <path d="{{ a.d }}" data-i="{{ a.i }}" class="acs-arrow{{ ' on' if a.on }}"
            stroke-width="{{ d.aw_on if a.on and not d.auto else d.aw }}"/>
      {% endfor %}
      <line x1="{{ d.px1 }}" y1="{{ d.py1 }}" x2="{{ d.px2 }}" y2="{{ d.py2 }}" class="acs-ptr" stroke-width="{{ d.pw }}"/>
      <g data-z="{{ key }}-hub">
        <circle cx="{{ d.x }}" cy="{{ d.y }}" r="{{ d.hub }}" class="acs-hub" stroke-width="{{ d.rim }}"/>
        <text x="{{ d.x }}" y="{{ d.y }}" font-size="{{ d.font }}" text-anchor="middle" dominant-baseline="central"
              class="acs-hub-t" pointer-events="none">A</text>
      </g>
    </g>
    {% endif %}
    {% endfor %}
    {#- факт и название -#}
    {% set n = s.now %}
    <text x="{{ n.x }}" y="{{ n.label_y }}" font-size="{{ n.label_size }}" text-anchor="{{ n.anchor }}"
          class="acs-dim{{ ' in' if n.inside }}">сейчас</text>
    <text x="{{ n.x }}" y="{{ n.y }}" font-size="{{ n.size }}" font-weight="650" letter-spacing="-1"
          text-anchor="{{ n.anchor }}" class="acs-ink{{ ' in' if n.inside }}">{{ n.text }}<tspan
          font-size="{{ n.deg }}" font-weight="500" dy="{{ n.dy }}">°</tspan></text>
    {% set nm = s.name %}
    <text x="{{ nm.x }}" y="{{ nm.y }}" font-size="{{ nm.size }}" font-weight="500" text-anchor="{{ nm.anchor }}"
          class="acs-ink{{ ' in' if nm.inside }}">{{ t.title }}</text>
    {#- «назад» и питание -#}
    {% set b = s.back %}
    <g data-z="back">
      {{ shade(b.x, b.y, b.r, s) }}
      <circle cx="{{ b.x }}" cy="{{ b.y }}" r="{{ b.r }}" class="acs-btn"/>
      <path d="M {{ b.x + b.r * 0.18 }},{{ b.y - b.r * 0.45 }} L {{ b.x - b.r * 0.3 }},{{ b.y }} L {{ b.x + b.r * 0.18 }},{{ b.y + b.r * 0.45 }}"
            class="acs-btn-ink" stroke-width="{{ b.r * 0.14 }}"/>
    </g>
    {% set p = s.power %}
    <g data-z="power">
      {{ shade(p.x, p.y, p.r, s) }}
      <circle cx="{{ p.x }}" cy="{{ p.y }}" r="{{ p.r }}" class="acs-pw"/>
      <path d="M {{ p.x - p.r * 0.27 }},{{ p.y - p.r * 0.27 }} A {{ p.r * 0.38 }},{{ p.r * 0.38 }} 0 1 0 {{ p.x + p.r * 0.27 }},{{ p.y - p.r * 0.27 }} M {{ p.x }},{{ p.y - p.r * 0.52 }} L {{ p.x }},{{ p.y - p.r * 0.08 }}"
            class="acs-pw-ink" stroke-width="{{ p.r * 0.1 }}"/>
    </g>
    {#- выбор режима: шторка от верхнего края, открывает пульт -#}
    <g class="acs-ch">
      <rect width="{{ s.w }}" height="{{ s.ch_h + 18 }}" class="acs-ch-bg" data-z="ch-bg"/>
      <rect y="{{ s.ch_h + 17 }}" width="{{ s.w }}" height="1" class="acs-ch-line"/>
      {% for c in s.chooser %}
      <g data-z="pick" data-mode="{{ c.key }}">
        <rect x="{{ c.x }}" y="{{ s.ch_y }}" width="{{ c.w }}" height="{{ s.ch_pill }}" rx="{{ s.ch_pill / 2 }}"
              class="acs-pill{{ ' on' if c.on }}"/>
        {% if c.key == 'auto' %}
        <text x="{{ c.tx }}" y="{{ s.ch_iy }}" font-size="{{ c.isize }}" text-anchor="middle"
              dominant-baseline="central" class="acs-pill-t{{ ' on' if c.on }}" font-weight="750">A</text>
        {% else %}
        <g class="acs-pill-ic{{ ' on' if c.on }}"><use href="#{{ uid }}ic-{{ c.icon }}" xlink:href="#{{ uid }}ic-{{ c.icon }}"
           x="{{ c.ix }}" y="{{ s.ch_iy - c.isize / 2 }}" width="{{ c.isize }}" height="{{ c.isize }}"/></g>
        {% endif %}
        <text x="{{ c.tx }}" y="{{ s.ch_ty }}" font-size="{{ s.ch_font }}" text-anchor="middle"
              class="acs-pill-t{{ ' on' if c.on }}">{{ c.word }}</text>
      </g>
      {% endfor %}
    </g>
  </g>
{% endmacro %}
