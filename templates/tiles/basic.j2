{#-
  Плитки без собственного прибора: выключатель, число, заголовок
  раздела, ссылка на другую панель.

  Часть templates/panel.svg.j2, вынесенная в отдельный файл при
  разделении шаблона. Импортируется с контекстом: макросам нужны
  uid, fs и rx, общие для всего документа.
-#}

{% import "tiles/_base.j2" as base with context %}

{#- ---- выключатель ---- -#}
{% macro tile_switch(t) %}
  {{ base.plate(t) }}
  {% if t.key %}
    {{ base.rocker(t) }}
  {% elif t.icon == 'toggle' and not t.compact %}
    {{ base.toggle(t) }}
  {% else %}
    {{ base.icon_c(t, t.icon if t.icon != 'toggle' else 'power', 24) }}
  {% endif %}
  {% if not t.key %}{{ base.value_tr(t) }}{% endif %}
  {{ base.caption(t, t.status) }}
{% endmacro %}

{#- Заголовок области: название комнаты и чипы состояния.
    Без плашки по умолчанию - иначе на панели появляется прямоугольник,
    который выглядит как кнопка, но ничего не делает. С plain: false
    рисуется как обычная плитка. -#}
{% macro tile_header(t) %}
  {% if not t.plain %}{{ base.plate(t) }}{% endif %}
  <text x="{{ 6 if t.plain else 18 }}" y="{{ t.h / 2 + 7 }}"
        class="h2">{{ t.title }}</text>
  {% for c in t.chips or [] %}
  <g transform="translate({{ c.x }},{{ c.y }})">
    {{ base.chip(c.icon, c.value, c.badge, c.active, none, c.badge_color,
            c.chart, c.chart_title, c.unit, c.alarm, c.attrs) }}
  </g>
  {% endfor %}
{% endmacro %}

{#- ---- сцена ----
    Кнопка, а не выключатель: состояния нет, гореть нечему. Значок
    крупнее обычного и по центру - на плитке больше ничего и нет, а
    отличать «Кино» от «Ужина» придётся с одного взгляда. -#}
{% macro tile_scene(t) %}
  {{ base.plate(t) }}
  {% if t.compact %}
  <use href="#{{ uid }}ic-{{ t.icon }}" xlink:href="#{{ uid }}ic-{{ t.icon }}"
       x="{{ t.w / 2 - 15 }}" y="{{ t.h / 2 - 22 }}" width="30" height="30"/>
  {% else %}
  <use href="#{{ uid }}ic-{{ t.icon }}" xlink:href="#{{ uid }}ic-{{ t.icon }}"
       x="{{ t.w / 2 - 23 }}" y="{{ t.h / 2 - 32 }}" width="46" height="46"/>
  {% endif %}
  {{ base.caption(t, t.status) }}
{% endmacro %}


{#- ---- сцены сеткой (1.19) ----
    Каждая клавиша - своя кнопка с data-topic: нажатие пишет значение
    сцены, страница подсвечивает клавишу (класс fired), как одиночную. -#}
{% macro tile_scenes(t) %}
  {{ base.plate(t) }}
  <text x="16" y="27" class="name">{{ t.title or 'Сцены' }}</text>
  {% for k in t.skeys %}
  <g class="skey" data-kind="scene" data-topic="{{ k.topic }}" data-on="{{ k.value }}"
     data-off="{{ k.value }}" data-state="0">
    {{ base.soft_rect(k.x, k.y, k.w, k.h, 12, 2) }}
    <rect x="{{ k.x }}" y="{{ k.y }}" width="{{ k.w }}" height="{{ k.h }}" rx="12" class="key skey-face"/>
    <rect x="{{ k.x }}" y="{{ k.y }}" width="{{ k.w }}" height="{{ k.h }}" rx="12" fill="url(#{{ uid }}gl)"/>
    <rect x="{{ k.x }}" y="{{ k.y }}" width="{{ k.w }}" height="{{ k.h }}" rx="12"
          fill="url(#{{ uid }}sglow)" opacity="{{ k.glow * 2 }}"/>
    <use href="#{{ uid }}ic-{{ k.icon }}" xlink:href="#{{ uid }}ic-{{ k.icon }}" class="skey-ic"
         x="{{ k.x + k.w / 2 - k.isize / 2 }}" y="{{ k.y + k.h * 0.40 - k.isize / 2 }}"
         width="{{ k.isize }}" height="{{ k.isize }}"/>
    <text x="{{ k.x + k.w / 2 }}" y="{{ k.y + k.h * 0.82 }}" font-size="{{ k.font }}"
          text-anchor="middle" class="skey-t">{{ k.title }}</text>
    {% for d in k.dots %}
    <circle cx="{{ k.x + k.w - 10 }}" cy="{{ k.y + 34 - loop.index0 * 6 }}" r="1.7"
            class="skey-dot{{ ' on' if d }}"/>
    {% endfor %}
  </g>
  {% endfor %}
{% endmacro %}

{#- Телевизор нового вида (1.21): колесо пульта - зубчатый обод, стрелки,
    OK; «назад» и «домой» круглыми кнопками. На крупной плитке у стрелок,
    OK и кнопок есть зоны tv:<клавиша> - нажатие уходит прямо в мост, пульт
    не открывается. Мимо них - пульт, как раньше. -#}
{% macro tile_tv(t) %}
  {% set k = t.tvk %}
  {% set wh = k.wheel %}
  {{ base.plate(t) }}
  <g class="tvw{{ '' if t.on else ' off' }}">
    {{ base.soft_round(wh.cx, wh.cy, wh.R, wh.sh) }}
    {% set gid = uid ~ 'tg' ~ t.i %}
    <defs><path id="{{ gid }}" d="{{ wh.gear }}"/></defs>
    <use href="#{{ gid }}" xlink:href="#{{ gid }}" class="key"/>
    {% if base.BEVEL == 'round' %}
    <use href="#{{ gid }}" xlink:href="#{{ gid }}" fill="url(#{{ uid }}gl)"/>
    {% elif base.BEVEL == 'sharp' %}
    <use href="#{{ gid }}" xlink:href="#{{ gid }}" fill="url(#{{ uid }}bev)"/>
    <circle cx="{{ wh.cx }}" cy="{{ wh.cy }}" r="{{ (wh.R * 0.84)|round(1) }}" class="key kface"/>
    {% endif %}
    {% for a in wh.arrows %}<path d="{{ a.tri }}" class="tvw-ar" data-k="{{ a.key }}"/>{% endfor %}
    {{ base.soft_round(wh.cx, wh.cy, wh.ok, wh.sh * 0.5) }}
    <circle cx="{{ wh.cx }}" cy="{{ wh.cy }}" r="{{ wh.ok }}" class="tvw-ok" data-k="ok"/>
    <circle cx="{{ wh.cx }}" cy="{{ wh.cy }}" r="{{ wh.ok }}" fill="url(#{{ uid }}gl)"/>
    {% if wh.R >= 30 %}
    <text x="{{ wh.cx }}" y="{{ wh.cy + wh.ok_font * 0.36 }}" font-size="{{ wh.ok_font }}"
          text-anchor="middle" class="tvw-okt">OK</text>
    {% endif %}
    {% for b in k.buttons %}
    {{ base.soft_round(b.cx, b.cy, b.r, 1.2) }}
    <circle cx="{{ b.cx }}" cy="{{ b.cy }}" r="{{ b.r }}" class="key" data-k="{{ b.key }}"/>
    <use href="#{{ uid }}ic-{{ 'undo' if b.key == 'back' else 'home' }}"
         xlink:href="#{{ uid }}ic-{{ 'undo' if b.key == 'back' else 'home' }}"
         x="{{ b.cx - b.icon / 2 }}" y="{{ b.cy - b.icon / 2 }}" width="{{ b.icon }}" height="{{ b.icon }}"
         class="tvw-ic"/>
    {% endfor %}
  </g>
  {% if k.kind == 'low' %}
  <text x="18" y="{{ t.h / 2 - 2 }}" class="name">{{ t.low_title }}</text>
  <text x="18" y="{{ t.h / 2 + 16 }}" class="status{{ ' tv-app' if t.on and t.app }}">{{ t.low_sub }}</text>
  {% else %}
  {{ base.caption(t, t.status) }}
  {% endif %}
  {% if k.keys %}
  {#- зоны поверх всего: нажатие ловит самый верхний элемент -#}
  {% for a in wh.arrows %}<path d="{{ a.zone }}" fill="transparent" data-zone="tv:{{ a.key }}"/>{% endfor %}
  <circle cx="{{ wh.cx }}" cy="{{ wh.cy }}" r="{{ wh.ok }}" fill="transparent" data-zone="tv:ok"/>
  {% endif %}
  {% for b in k.buttons %}
  <circle cx="{{ b.cx }}" cy="{{ b.cy }}" r="{{ b.r + 6 }}" fill="transparent" data-zone="tv:{{ b.key }}"/>
  {% endfor %}
{% endmacro %}

{% macro tile_link(t) %}
  {{ base.plate(t) }}
  {{ base.icon_c(t, t.icon or 'door', 26) }}
  {% if not t.compact %}
  <use href="#{{ uid }}ic-next" xlink:href="#{{ uid }}ic-next"
       x="{{ t.w - 44 }}" y="18" width="24" height="24"/>
  {% endif %}
  {{ base.caption(t, t.status) }}
{% endmacro %}

{#- ---- камера ----
    Кадр во всю плитку, подпись поверх него на затемнении. Подложка под
    кадром обязательна: пока снимок не пришёл, там иначе пусто.

    preserveAspectRatio="xMidYMid slice" - кадрирование по центру, как
    background-size: cover. Камера 16:9, плитка квадратная, и без slice
    картинка вписывалась бы с полями.

    Про <image> важно знать одно: внутри <img src="panel.svg"> внешняя
    ссылка не загрузится, браузер такое блокирует. На самой панели SVG
    вставлен разметкой, и там всё работает; на сводной странице со
    списком панелей плитка камеры останется пустой подложкой. Это не
    поломка, а цена превью картинкой. -#}
{% macro tile_camera(t) %}
  {{ base.plate(t) }}
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" class="cam-hole"/>
    {% if t.src %}
    <image href="{{ t.src }}" xlink:href="{{ t.src }}"
           x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}"
           preserveAspectRatio="xMidYMid slice"/>
    {% endif %}
    {#- Гашение к низу до цвета подложки: подпись должна читаться и на
        светлом кадре, и на тёмном. Градиент scrim для того и заведён. -#}
    <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}"
          fill="url(#{{ uid }}scrim)"/>
  </g>
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}" class="rim"/>
  {% if not t.src %}
  {{ base.icon_c(t, t.icon or 'camera', 24) }}
  {% endif %}
  {{ base.caption(t, t.status) }}
{% endmacro %}

{#- ---- список ----
    Значок и название сверху, число открытых пунктов справа, ниже -
    пункты в том порядке, что задан в окне. Сколько строк влезло,
    посчитал сервер по высоте плитки; последняя строка, если не влезло
    всё, - «ещё N». Мелкая плитка показывает только число и первый пункт
    вместо подписи. -#}
{% macro tile_list(t) %}
  {{ base.plate(t) }}
  {% if t.compact_list or not t.sheet %}
  {{ base.icon_c(t, t.icon or 'list', 24) }}
  {% if t.count and not t.compact %}
  <text x="{{ t.w - 20 }}" y="41" class="li-count" text-anchor="end">{{ t.count }}</text>
  {% endif %}
  {{ base.caption(t, t.status) }}
  {% else %}
  <use href="#{{ uid }}ic-{{ t.icon or 'list' }}" xlink:href="#{{ uid }}ic-{{ t.icon or 'list' }}"
       x="16" y="{{ 15 * fs }}" width="{{ 26 * fs }}" height="{{ 26 * fs }}"/>
  <text x="{{ 16 + 34 * fs }}" y="{{ 35 * fs }}" class="name">{{ t.head or t.title }}</text>
  {% if t.count %}<text x="{{ t.w - 20 }}" y="{{ 36 * fs }}" class="li-count" text-anchor="end">{{ t.count }}</text>{% endif %}
  {#- Лист в линейку (с 1.41): линии под строками, поле, квадратики. -#}
  {% for y in t.rules %}
  <line x1="14" y1="{{ y }}" x2="{{ t.w - 14 }}" y2="{{ y }}" class="li-rule"/>
  {% endfor %}
  {% if t.rules %}<line x1="32" y1="{{ t.rules[0] - t.size * 1.6 }}" x2="32" y2="{{ t.rules[-1] + 4 }}" class="li-margin"/>{% endif %}
  {% for r in t.rows %}
  <rect x="{{ 16 }}" y="{{ r.y - t.size * 0.35 - t.box / 2 }}" width="{{ t.box }}" height="{{ t.box }}" rx="2.5" class="li-box"/>
  <text x="{{ 38 }}" y="{{ r.y }}" font-size="{{ t.size }}" class="li">{{ r.text }}</text>
  {% endfor %}
  {% if not t.rows %}
  <text x="{{ t.w / 2 + 3 }}" y="{{ t.rules[(t.rules|length - 1) // 2] - t.size * 0.55 if t.rules else t.h / 2 }}"
        font-size="{{ t.size }}" text-anchor="middle" class="li-empty">{{ t.status or 'пусто' }}</text>
  {% endif %}
  {% if t.more %}
  <text x="38" y="{{ t.more_y }}" font-size="{{ t.size * 0.9 }}" class="li-more">ещё {{ t.more }}…</text>
  {% endif %}
  {% endif %}
{% endmacro %}

{#- ---- расписание ----
    Шапка как у списка: значок, «Сегодня», дата справа. Строки: цветная
    точка календаря, время, название. Идущее сейчас - время оранжевым и
    словом «сейчас», прошедшее - бледным. На мелкой плитке - одна строка
    про ближайшее событие. -#}
{#- Листок отрывного календаря (с 1.41): полоса цвета акцента с днём
    недели, кольца сверху, число крупно. -#}
{% macro calpage(x, y, s, day, wd) %}
  <g class="calp">
    {{ base.soft_rect(x, y, s, s * 1.06, 5, 1.5) }}
    <rect x="{{ x }}" y="{{ y }}" width="{{ s }}" height="{{ (s * 1.06)|round(1) }}" rx="5" class="calp-page"/>
    <path d="M{{ x }},{{ y + 5 }} a5,5 0 0 1 5,-5 h{{ s - 10 }} a5,5 0 0 1 5,5 v{{ (s * 0.3 - 5)|round(1) }} h{{ -s }}z" class="calp-band"/>
    <text x="{{ x + s / 2 }}" y="{{ (y + s * 0.235)|round(1) }}" font-size="{{ (s * 0.2)|round(1) }}" text-anchor="middle" class="calp-wd">{{ wd|upper }}</text>
    <text x="{{ x + s / 2 }}" y="{{ (y + s * 0.88)|round(1) }}" font-size="{{ (s * 0.5)|round(1) }}" text-anchor="middle" class="calp-day">{{ day }}</text>
    <rect x="{{ (x + s * 0.27 - 1.5)|round(1) }}" y="{{ y - 3 }}" width="3" height="7" rx="1.5" class="calp-ring"/>
    <rect x="{{ (x + s * 0.73 - 1.5)|round(1) }}" y="{{ y - 3 }}" width="3" height="7" rx="1.5" class="calp-ring"/>
  </g>
{% endmacro %}

{% macro tile_agenda(t) %}
  {{ base.plate(t) }}
  {% if t.compact_agenda %}
  {% if t.day and t.compact %}{{ calpage(((t.w - 28) / 2)|round(1), 13, 28, t.day, t.wd) }}
  {% elif t.day and t.h < base.LOW %}{{ calpage(16, ((t.h - 30) / 2)|round(1), 28, t.day, t.wd) }}
  {% elif t.day %}{{ calpage(18, 16, 32, t.day, t.wd) }}
  {% else %}{{ base.icon_c(t, t.icon or 'calendar', 24) }}{% endif %}
  {{ base.caption(t, t.status) }}
  {% else %}
  {% if t.day %}{{ calpage(16, 14, 28, t.day, t.wd) }}{% else %}
  <use href="#{{ uid }}ic-{{ t.icon or 'calendar' }}" xlink:href="#{{ uid }}ic-{{ t.icon or 'calendar' }}"
       x="16" y="{{ 15 * fs }}" width="{{ 26 * fs }}" height="{{ 26 * fs }}"/>{% endif %}
  <text x="{{ 16 + 34 * fs }}" y="{{ 35 * fs }}" class="name">{{ t.title }}</text>
  {% if t.date %}
  <text x="{{ t.w - 20 }}" y="{{ 35 * fs }}" class="ag-date" font-size="13.5" text-anchor="end">{{ t.date }}</text>
  {% endif %}
  {% for r in t.rows %}
  {% if r.kind == 'ev' %}
  <g class="{{ 'ag-past' if r.state == 'past' }}">
    <circle cx="24" cy="{{ r.dot_y }}" r="4" fill="{{ r.color }}"/>
    <text x="34" y="{{ r.y }}" font-size="{{ 12 if r.small else t.size }}"
          class="ag-time {{ 'small' if r.small }} {{ 'ag-now' if r.state == 'now' }}">{{ r.time }}</text>
    <text x="{{ t.text_x }}" y="{{ r.y }}" font-size="{{ t.size }}" class="ag-txt">{{ r.text }}</text>
  </g>
  {% elif r.kind == 'sep' %}
  <text x="20" y="{{ r.y }}" font-size="12.5" class="ag-sep">{{ r.text|upper }}</text>
  {% else %}
  <text x="20" y="{{ r.y }}" font-size="{{ t.size }}" class="ag-empty">{{ r.text }}</text>
  {% endif %}
  {% endfor %}
  {% if t.more %}
  <text x="34" y="{{ t.more_y }}" font-size="{{ t.size * 0.9 }}" class="li-more">ещё {{ t.more }}…</text>
  {% endif %}
  {% endif %}
{% endmacro %}

{#- ---- «Сегодня» (с 1.43) ----
    Дела и события одной плиткой: шапка с листком календаря, дела
    квадратиками на линейках, под чертой события как у расписания. -#}
{% macro tile_today(t) %}
  {{ base.plate(t) }}
  {% if t.compact_today %}
  {% if t.compact %}{{ calpage(((t.w - 28) / 2)|round(1), 13, 28, t.day, t.wd) }}
  {% elif t.h < base.LOW %}{{ calpage(16, ((t.h - 30) / 2)|round(1), 28, t.day, t.wd) }}
  {% else %}{{ calpage(18, 16, 32, t.day, t.wd) }}{% endif %}
  {{ base.caption(t, t.status) }}
  {% else %}
  {{ calpage(16, 14, 28, t.day, t.wd) }}
  <text x="{{ 16 + 34 * fs }}" y="{{ 35 * fs }}" class="name">{{ t.title }}</text>
  {% if t.date %}
  <text x="{{ t.w - 20 }}" y="{{ 35 * fs }}" class="ag-date" font-size="13.5" text-anchor="end">{{ t.date }}</text>
  {% endif %}
  {% for y in t.rules %}
  <line x1="14" y1="{{ y }}" x2="{{ t.w - 14 }}" y2="{{ y }}" class="li-rule"/>
  {% endfor %}
  {% for r in t.tasks %}
  <rect x="16" y="{{ r.y - t.size * 0.35 - t.box / 2 }}" width="{{ t.box }}" height="{{ t.box }}" rx="2.5" class="li-box"/>
  <text x="34" y="{{ r.y }}" font-size="{{ t.size }}" class="li">{{ r.text }}</text>
  {% endfor %}
  {% if t.tasks_empty %}
  <text x="34" y="{{ t.tasks_empty.y }}" font-size="{{ t.size }}" class="li-empty">{{ t.tasks_empty.text }}</text>
  {% endif %}
  {% if t.more_t %}
  <text x="34" y="{{ t.more_t_y }}" font-size="{{ t.size * 0.9 }}" class="li-more">ещё {{ t.more_t }}…</text>
  {% endif %}
  {% if t.div_y %}
  <line x1="14" y1="{{ t.div_y }}" x2="{{ t.w - 14 }}" y2="{{ t.div_y }}" class="td-div"/>
  {% endif %}
  {% for r in t.events %}
  {% if r.kind == 'ev' %}
  <g class="{{ 'ag-past' if r.state == 'past' }}">
    <circle cx="21" cy="{{ r.dot_y }}" r="4" fill="{{ r.color }}"/>
    <text x="30" y="{{ r.y }}" font-size="{{ 12 if r.small else t.size }}"
          class="ag-time {{ 'small' if r.small }} {{ 'ag-now' if r.state == 'now' }}">{{ r.time }}</text>
    <text x="{{ t.text_x }}" y="{{ r.y }}" font-size="{{ t.size }}" class="ag-txt">{{ r.text }}</text>
  </g>
  {% elif r.kind == 'sep' %}
  <text x="16" y="{{ r.y }}" font-size="12.5" class="ag-sep">{{ r.text|upper }}</text>
  {% else %}
  <text x="30" y="{{ r.y }}" font-size="{{ t.size }}" class="ag-empty">{{ r.text }}</text>
  {% endif %}
  {% endfor %}
  {% if t.more_e %}
  <text x="30" y="{{ t.more_e_y }}" font-size="{{ t.size * 0.9 }}" class="li-more">ещё {{ t.more_e }}…</text>
  {% endif %}
  {% endif %}
{% endmacro %}

{#- Датчик протечки (с 1.41): плоская шайба на полу, диод посередине.
    Мокрый - диод красный и мигает. -#}
{% macro puck(cx, cy, r, wet) %}
  <g class="puck{{ ' wet' if wet }}">
    {{ base.soft_round(cx, cy + r * 0.2, r * 0.9, 2) if not wet }}
    <ellipse cx="{{ cx }}" cy="{{ cy + r * 0.22 }}" rx="{{ r }}" ry="{{ (r * 0.42)|round(1) }}" class="puck-side"/>
    <ellipse cx="{{ cx }}" cy="{{ cy }}" rx="{{ r }}" ry="{{ (r * 0.4)|round(1) }}" class="puck-top"/>
    <ellipse cx="{{ cx - r * 0.25 }}" cy="{{ cy - r * 0.12 }}" rx="{{ r * 0.45 }}" ry="{{ (r * 0.1)|round(1) }}" class="puck-hl"/>
    <circle cx="{{ cx }}" cy="{{ cy }}" r="{{ (r * 0.13)|round(1) }}" class="puck-led">
      {% if wet %}<animate attributeName="opacity" values="1;.2;1" dur="1s" repeatCount="indefinite"/>{% endif %}
    </circle>
  </g>
{% endmacro %}

{#- ---- протечка ----
    В покое - обычная плитка с каплей и «Сухо». При тревоге подложка
    красная, текст и значок белые (класс onlight делает ровно это для
    ленты), значок мигает. Мигание - анимацией SVG, а не CSS: librsvg её
    просто не проигрывает, а разбор палитры к ней не прикасается. -#}
{% macro tile_leak(t) %}
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        class="plate {{ 'alarm' if t.alarm }}"/>
  {% if not t.alarm %}{{ base.sheen(t) }}{% endif %}
  <g class="{{ 'onlight' if t.alarm }}">
    {% if t.alarm %}
    {#- Значок рисуется прямо здесь, а не через use: селекторы не проникают
        в теневое дерево символа, и onlight не сделал бы его белым - на
        красном остался бы серый. Положение и размер - как у icon_c. -#}
    {% if not t.compact and t.h >= 117 %}
    {#- Датчик на мокром полу (с 1.41): лужа и расходящиеся круги. -#}
    <ellipse cx="38" cy="44" rx="30" ry="8" class="puddle"/>
    {% for d in (0, 1) %}
    <ellipse cx="38" cy="44" rx="22" ry="6" class="ripple">
      <animate attributeName="rx" values="20;40" dur="2.4s" begin="{{ d * 1.2 }}s" repeatCount="indefinite"/>
      <animate attributeName="ry" values="5;11" dur="2.4s" begin="{{ d * 1.2 }}s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values=".7;0" dur="2.4s" begin="{{ d * 1.2 }}s" repeatCount="indefinite"/>
    </ellipse>
    {% endfor %}
    {{ puck(38, 34, 19, True) }}
    {% else %}
    {% if t.compact %}{% set ix, iy, isz = (t.w - 24) / 2, 14, 24 %}
    {% elif t.h < 117 %}{% set ix, iy, isz = 16, (t.h - 27) / 2, 27 %}
    {% else %}{% set ix, iy, isz = 18, 17, 27 %}{% endif %}
    <g transform="translate({{ ix }},{{ iy }}) scale({{ isz / 24 }})">
      <path d="M12 3.2s5.4 6 5.4 9.5a5.4 5.4 0 1 1-10.8 0C6.6 9.2 12 3.2 12 3.2z"
            fill="#FFFFFF" stroke="#FFFFFF" stroke-width="1.8" stroke-linejoin="round"/>
      <animate attributeName="opacity" values="1;.25;1" dur="1.4s"
               repeatCount="indefinite"/>
    </g>
    {% endif %}
    {% else %}
    {% if not t.compact and t.h >= base.LOW %}{{ puck(38, 34, 19, False) }}
    {% else %}{{ base.icon_c(t, t.icon or 'drop', 24) }}{% endif %}
    {% endif %}
    {#- Число мокрых - только когда датчиков не видно списком. -#}
    {% if t.alarm and t.wet and t.count > 1 and not t.compact and t.h >= 117 and not t.chips %}
    <text x="{{ t.w - 20 }}" y="41" class="badge" text-anchor="end">{{ t.wet }}</text>
    {% endif %}
    {#- Датчики списком: кружок и имя. Сухой - пустой кружок, мокрый -
        залитый, без данных - бледный. -#}
    {% for c in t.chips or [] %}
    {% if c.more %}
    <text x="{{ c.x }}" y="{{ c.y }}" font-size="{{ c.size }}" class="lk-more">{{ c.more }}</text>
    {% else %}
    <ellipse cx="{{ c.cx }}" cy="{{ c.cy }}" rx="{{ c.r * 1.3 }}" ry="{{ c.r * 0.72 }}" class="lk-{{ c.state }}"/>
    <text x="{{ c.tx }}" y="{{ c.y }}" font-size="{{ c.size }}" class="lk {{ 'wet' if c.state == 'wet' }}">{{ c.text }}</text>
    {% endif %}
    {% endfor %}
    {% if t.compact %}
    {#- Мелкая плитка: вместо названия - состояние. Название «Протечки» на
        ней ничего не говорит, а «Сухо» и «Протечка» говорят всё. -#}
    <text x="{{ t.w / 2 }}" y="{{ t.h - 13 }}" class="name-s" text-anchor="middle">{{ t.status_s }}</text>
    {% else %}
    {{ base.caption(t, t.status) }}
    {% endif %}
  </g>
{% endmacro %}

{#- ---- кран ----
    Значок крана с каплей цвета воды: синяя - холодная, красная - горячая.
    Перекрытый - красная рамка. Нажатие не переключает, а открывает окно с
    одной кнопкой. -#}
{#- Шаровой кран (с 1.41, look: ball): труба через плитку, корпус с гайками, ручка
    цвета воды. Открыт - ручка вдоль трубы и вода в ней до края; перекрыт -
    ручка поперёк, за краном труба пустая. -#}
{% macro valve_big(t) %}
  {% set py = (t.h * 0.46)|round(1) %}{% set cx = (t.w / 2)|round(1) %}
  {% set sy = py - 21 %}
  <g class="vlv{{ ' shut' if t.closed }}{{ ' nodata' if t.open is none }}" clip-path="url(#{{ uid }}clip{{ t.i }})">
    <rect x="-2" y="{{ py - 9 }}" width="{{ t.w + 4 }}" height="18" class="vlv-pipe"/>
    <line x1="0" y1="{{ py - 9 }}" x2="{{ t.w }}" y2="{{ py - 9 }}" class="vlv-hl"/>
    <line x1="0" y1="{{ py + 9 }}" x2="{{ t.w }}" y2="{{ py + 9 }}" class="vlv-edge"/>
    {% if t.open %}
    <rect x="0" y="{{ py - 3 }}" width="{{ t.w }}" height="6" rx="3" fill="{{ t.water_color }}" class="vlv-water"/>
    {% elif t.closed %}
    <rect x="0" y="{{ py - 3 }}" width="{{ cx - 26 }}" height="6" rx="3" fill="{{ t.water_color }}" class="vlv-water"/>
    {% endif %}
  </g>
  <g class="vlv{{ ' shut' if t.closed }}{{ ' nodata' if t.open is none }}">
    {{ base.soft_rect(cx - 27, py - 15, 54, 30, 9, 2) }}
    {% for nx in (cx - 40, cx + 27) %}
    <rect x="{{ nx }}" y="{{ py - 13 }}" width="13" height="26" rx="2.5" class="vlv-nut"/>
    <line x1="{{ nx + 4.3 }}" y1="{{ py - 12 }}" x2="{{ nx + 4.3 }}" y2="{{ py + 12 }}" class="vlv-facet"/>
    <line x1="{{ nx + 8.7 }}" y1="{{ py - 12 }}" x2="{{ nx + 8.7 }}" y2="{{ py + 12 }}" class="vlv-facet"/>
    {% endfor %}
    <rect x="{{ cx - 27 }}" y="{{ py - 15 }}" width="54" height="30" rx="9" class="vlv-body"/>
    <line x1="{{ cx - 20 }}" y1="{{ py - 13.5 }}" x2="{{ cx + 20 }}" y2="{{ py - 13.5 }}" class="vlv-hl"/>
    <rect x="{{ cx - 4.5 }}" y="{{ sy }}" width="9" height="8" rx="1.5" class="vlv-nut"/>
    <g transform="rotate({{ -90 if t.closed else 0 }} {{ cx }} {{ sy }})">
      {{ base.soft_rect(cx - 7, sy - 6, 56, 12, 6, 2) }}
      <rect x="{{ cx - 7 }}" y="{{ sy - 6 }}" width="56" height="12" rx="6" fill="{{ t.water_color }}" class="vlv-lever"/>
      <line x1="{{ cx + 4 }}" y1="{{ sy - 4.2 }}" x2="{{ cx + 45 }}" y2="{{ sy - 4.2 }}" class="vlv-lever-hl"/>
    </g>
    <circle cx="{{ cx }}" cy="{{ sy }}" r="5.5" class="vlv-cap"/>
  </g>
{% endmacro %}

{#- Классический кран (1.41): ручка-барашек, корпус, излив. Открыт -
    ручка поперёк (вся видна) и под изливом капля цвета воды; перекрыт -
    ручка повёрнута к нам торцом, излив сухой. Рамка 100×100, масштаб k. -#}
{% macro faucet(x, y, k, opened, color, drop) %}
  <g transform="translate({{ x }} {{ y }}) scale({{ k }})" class="fct{{ ' shut' if not opened }}">
    <rect x="1" y="28" width="10" height="38" rx="5"/>
    <path d="M11,32.4H20M11,48H20M47,32.4H64A19,19 0 0 1 83,51.4V60.5M47,48H56.6A7.8,7.8 0 0 1 64.4,55.8V60.5M30,15.6V25M37.2,15.6V25"/>
    <rect x="64.4" y="60.5" width="18.6" height="10.5" rx="1.5"/>
    <rect x="20" y="25" width="27" height="30" rx="4"/>
    {% if opened %}
    <path d="M27.4,3H17A6,6 0 0 0 17,15H27.4M39.8,3H50A6,6 0 0 1 50,15H39.8"/>
    {% else %}
    <rect x="26.4" y="2.2" width="14.4" height="13.6" rx="5"/>
    {% endif %}
    <circle cx="33.6" cy="9" r="6.4"/>
    {% if drop %}
    <path d="M73.7,77C70,83 66.3,86.6 66.3,91.3a7.4,7.4 0 0 0 14.8,0C81.1,86.6 77.4,83 73.7,77z"
          class="fct-drop" style="fill:{{ color }};stroke:{{ color }}"/>
    {% endif %}
  </g>
{% endmacro %}

{% macro tile_valve(t) %}
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        class="plate {{ 'closed' if t.closed }}"/>
  {{ base.sheen(t) }}
  {#- Шаровой кран рисунком - только по look: ball (с 1.41); по умолчанию
      значок крана с точкой цвета воды. -#}
  {% if t.ball and not t.compact and t.h >= 117 %}
  {{ valve_big(t) }}
  {% elif not t.compact and t.h >= 117 and not t.icon_set %}
  {{ faucet(16, 13, 0.74, t.open != False, t.water_color, t.open == True) }}
  {% else %}{{ base.icon_c(t, t.icon or 'tap', 24) }}{% endif %}
  {% if t.ball and not t.compact and t.h >= 117 %}
  {% elif not t.compact and t.h >= 117 %}
  <circle cx="{{ t.w - 26 }}" cy="29" r="7" fill="{{ t.water_color }}"/>
  {% elif not t.compact %}
  {#- Половинная плитка: точка у значка, справа место под «Перекрыт: Душ». -#}
  <circle cx="{{ 41 }}" cy="{{ (t.h - 27) / 2 + 4 }}" r="5" fill="{{ t.water_color }}"
          stroke="var(--tile)" stroke-width="1.5"/>
  {% else %}
  <circle cx="{{ t.w - 12 }}" cy="12" r="4.5" fill="{{ t.water_color }}"/>
  {% endif %}
  {{ base.caption(t, t.status) }}
{% endmacro %}

{#- ---- простое значение ---- -#}
{% macro tile_value(t) %}
  {{ base.plate(t) }}
  {% if t.compact %}
  {#- Узкая плитка (w: 0.5): значку и числу рядом тесно - число налезало на
      значок. Здесь только число, крупно по центру, под ним подпись. -#}
  <text x="{{ t.w / 2 }}" y="{{ (t.h / 2 + 2) | round(1) }}" class="badge" text-anchor="middle"
        style="font-size:{{ (18 * (fs | float)) | round(1) }}px">{{ t.value }}{{ ' ' ~ t.unit if t.unit and t.unit|length > 1 else t.unit }}</text>
  {% else %}
  {{ base.icon_c(t, t.icon or 'thermo', 24) }}
  <text x="{{ t.w - 20 }}" y="41" class="badge" text-anchor="end">{{ t.value }} {{ t.unit }}</text>
  {% endif %}
  {{ base.caption(t, t.subtitle) }}
{% endmacro %}

