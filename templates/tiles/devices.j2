{#-
  Приборы со своей геометрией: штора, лента, диммер, термостат.

  Часть templates/panel.svg.j2, вынесенная в отдельный файл при
  разделении шаблона. Импортируется с контекстом: макросам нужны
  uid, fs и rx, общие для всего документа.
-#}

{% import "tiles/_base.j2" as base with context %}

{#- Стили этого файла. Элемент <style> в SVG остаётся один:
    resolve_css_vars разбирает только первый, и в остальных
    var() уехал бы на контроллер неразвёрнутым, а librsvg и
    старые WebView такое молча игнорируют. Поэтому каркас
    склеивает куски, а не выпускает несколько блоков. -#}
{% macro style() %}
  /* ---- фанкойл пультом (с 1.37) ---- */
  .fcp-col          { color: var(--active); }
  .fcp.cool .fcp-col { color: var(--ac-seg-cool); }
  .fcp.heat .fcp-col { color: var(--ac-seg-heat); }
  .fcp.fan .fcp-col, .fcp.off .fcp-col, .fcp-dimc { color: var(--ink-dim); }
  .fcp-tk           { stroke: var(--ink); opacity: .35; }
  .fcp-tk.mj        { opacity: .65; }
  .fcp-faint        { fill: var(--ink-faint); }
  .fcp-dim          { fill: var(--ink-dim); }
  .fcp-ink          { fill: var(--ink); }
  .fcp.off .fcp-lcdg { opacity: .45; }
  .fcp-ghost        { fill: var(--ink); opacity: .07; }
  .fcp-num          { fill: var(--ink); font-weight: 650; letter-spacing: -1px; }
  .fcp-well         { fill: var(--well); }
  .fcp-fill         { fill: currentColor; }
  .fcp-blade        { fill: currentColor; opacity: .55; }
  .fcp.off .fcp-blade { opacity: .25; }
  .fcp-hub          { fill: var(--tile); stroke: currentColor; stroke-width: 1.2; }
  .fcp-slat         { fill: var(--tile); }
  .fcp-hl           { stroke: #FFFFFF; stroke-opacity: .45; stroke-width: .8; }
  .fcp-rib          { stroke: var(--shadow); stroke-opacity: .55; stroke-width: 1.2; }
  .fcp-frame        { fill: none; stroke: var(--edge); stroke-width: 2; }
  .fcp-lcd          { fill: var(--lcd); }
  .fcp-shadow       { fill: var(--shadow); opacity: .5; }
  .fcp-edge         { stroke: var(--edge); }
  .fcp-side         { fill: var(--key-side); }
  .fcp-led          { fill: var(--led-off); stroke: var(--edge); stroke-width: .6; }
  .fcp-led.on       { fill: currentColor; stroke: none; }
  .fcp-ledglow      { fill: currentColor; opacity: .45; }
  .fcp-klab         { fill: var(--ink); font-weight: 650; opacity: .85; }
  .fcp-klab.in      { opacity: .6; }
  .fcp-word         { fill: currentColor; }
  .fcp-col use, .fcp-dimc use { color: currentColor; }
  /* карманы под рейки и нижняя рейка рулонной шторы. Цвет literal, а не
     var(--ink): это тень на ткани, и в тёмной теме она тоже тень, а не
     светлая линия, какой стала бы, взявшись от цвета текста. */
  .pleat line{ stroke: #000; stroke-width: calc(1px * var(--fs)); opacity: .13; }
  .hem{ fill: #000; opacity: .22; }
  /* шторы нового вида (1.20): приглушённая ткань, переплёт окна, ручка */
  .drape{ fill: var(--drape); }
  .sash line{ stroke: var(--sash); stroke-width: calc(4px * var(--fs)); }
  .sash .bar{ stroke-width: calc(3px * var(--fs)); }
  .handle{ fill: var(--active); }
  /* цель хода. Оранжевый, как у всего действующего на панели, и пунктир -
     чтобы не спутать с кромкой полотна, которая сплошная. */
  .goal{ stroke: var(--active); stroke-width: calc(1.8px * var(--fs));
         stroke-dasharray: calc(5px * var(--fs)) calc(4px * var(--fs));
         opacity: .95; }
  /* циферблат термостата */
  .dial .track { fill: none; stroke: var(--ink); stroke-width: calc(7px * var(--fs));
                 stroke-linecap: round; opacity: .12; }
  .dial .fill  { fill: none; stroke: var(--stroke); stroke-width: calc(7px * var(--fs));
                 stroke-linecap: round; opacity: .55; }
  .dial.live .fill { stroke: var(--active); opacity: .95; }
  /* Уставка ниже фактической - прибору предстоит охлаждать. Тёплый цвет
     тут сбивает: одинаковая дуга не должна означать разные вещи. */
  .dial.cool .fill { stroke: var(--cool); }
  .dial.cool .mark.target { stroke: var(--cool); }
  .dial .mark  { stroke: var(--ink); stroke-width: calc(2.4px * var(--fs)); stroke-linecap: round;
                 opacity: .70; }
  .dial .mark-dot { fill: var(--ink); opacity: .70; }
  .dial .mark.target { stroke: var(--active); stroke-width: calc(3.4px * var(--fs)); opacity: 1; }
  .dial.muted  { opacity: .5; }
  /* Полосы скорости вентилятора: три ступени, как шкала сигнала. Горят
     оранжевым только когда оборудование действительно работает - серые
     полосы у стоящего вентилятора отличают «просили» от «крутится». */
  .fanbars rect      { fill: var(--ink); opacity: .16; }
  .fanbars rect.on   { opacity: .45; }
  .fanbars.live rect.on { fill: var(--active); opacity: .95; }
  .siderow           { font-size: calc(12.5px * var(--fs)); font-weight: 500;
                       fill: var(--ink-dim); }
  .siderow.on        { fill: var(--ink); }
  .dial-big    { font-size: calc(30px * var(--fs)); font-weight: 600; letter-spacing: -1px;
                 fill: var(--ink); }
  .dial-deg    { font-size: calc(18px * var(--fs)); font-weight: 500; fill: var(--ink); }
  .dial-sub    { font-size: calc(11.5px * var(--fs)); font-weight: 500; fill: var(--ink-dim); }
  .dial-mode   { font-size: calc(13px * var(--fs)); font-weight: 600; fill: var(--ink-dim); }
  /* ручка термостата (1.17) */
  .knob .kt     { stroke: var(--ink); opacity: .45; stroke-linecap: round; }
  .knob .kt.mj  { opacity: .85; }
  .knob.off .kt { opacity: .25; }
  .knob.off .kt.mj { opacity: .45; }
  .knob .kl     { fill: var(--ink-dim); font-weight: 600; }
  .knob .ktrack { fill: none; stroke: var(--ink); opacity: .12; stroke-linecap: round; }
  .knob .kfill  { fill: none; stroke-linecap: round; }
  .knob.heat .kfill, .knob.heat .kptr { stroke: var(--ac-seg-heat); }
  .knob.idle .kfill, .knob.idle .kptr { stroke: var(--cool); }
  .knob.off .kfill, .knob.off .kptr   { stroke: var(--ink-dim); }
  .knob .kcur-h { stroke: var(--tile); stroke-linecap: round; }
  .knob .kcur   { stroke: var(--ink); stroke-linecap: round; }
  .knob .ksh    { fill: var(--shadow); }
  .knob .kgear  { fill: var(--ac-pill); stroke: var(--edge); stroke-width: 1; }
  .knob .kptr   { stroke-linecap: round; }
  .knob .kdot   { fill: var(--ink); stroke: var(--tile); }
  .knob.off .kdot { fill: var(--ink-dim); }
  .knob .knum   { fill: var(--ink); font-weight: 650; letter-spacing: -.5px; }
  .knob.off .knum { fill: var(--ink-dim); }
  .knob .kdeg   { font-weight: 500; }
  .knob .ksub   { fill: var(--ink-dim); font-weight: 500; }
  .knob-mode.heat { fill: var(--ac-seg-heat); }
  .knob-mode.idle { fill: var(--cool); }
  /* тёмная карточка (inv) в осенней, ретро и нуаре */
  .inv .knob .kt, .inv .knob .ktrack, .inv .knob .kcur { stroke: var(--inv-ink); }
  .inv .knob .kl   { fill: var(--inv-dim); }
  .inv .knob .kcur-h, .inv .knob .kdot { stroke: var(--inv-tile); }
  .inv .knob .kdot { fill: var(--inv-ink); }
  .inv .knob.heat .kfill, .inv .knob.heat .kptr { stroke: var(--inv-accent); }
  .inv .knob-mode.heat { fill: var(--inv-accent); }
{% endmacro %}

{#- ---- раздвижные шторы ----
    Створки занимают всю плитку и едут от краёв к центру. Ширина каждой
    пропорциональна тому, насколько она НЕ открыта. К низу картинка гаснет
    до цвета подложки - там лежат подписи. -#}
{#- Вид за окном (шторы, с 1.20): небо по высоте солнца, солнце и луна
    на своих местах, облака, осадки. Градиенты объявлены здесь же: цвета
    у них свои на каждое время суток. Фильтров нет - мягкость даёт
    радиальный градиент, размытие на плитку панели не по карману. -#}
{% macro window(t) %}
  {% set k = t.sky %}
  {% set id = uid ~ 'w' ~ t.i %}
  <defs>
    <linearGradient id="{{ id }}sky" x1="0" y1="0" x2="0" y2="{{ k.horizon }}" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="{{ k.sky[0] }}"/>
      <stop offset=".62" stop-color="{{ k.sky[1] }}"/>
      <stop offset="1" stop-color="{{ k.sky[2] }}"/>
    </linearGradient>
    {% if k.sun %}
    <radialGradient id="{{ id }}sun">
      <stop offset="0" stop-color="{{ k.sun.color }}" stop-opacity="{{ k.sun.glow }}"/>
      <stop offset=".35" stop-color="{{ k.sun.color }}" stop-opacity="{{ (k.sun.glow * 0.45)|round(2) }}"/>
      <stop offset="1" stop-color="{{ k.sun.color }}" stop-opacity="0"/>
    </radialGradient>
    {% endif %}
    {% if k.moon %}
    <radialGradient id="{{ id }}moon">
      <stop offset="0" stop-color="#DDE6F2" stop-opacity="{{ k.moon.glow }}"/>
      <stop offset="1" stop-color="#DDE6F2" stop-opacity="0"/>
    </radialGradient>
    {% endif %}
    {% if k.clouds %}
    <radialGradient id="{{ id }}cl">
      <stop offset="0" stop-color="{{ k.cloud_color }}" stop-opacity="{{ k.cloud_op }}"/>
      <stop offset=".55" stop-color="{{ k.cloud_color }}" stop-opacity="{{ (k.cloud_op * 0.75)|round(2) }}"/>
      <stop offset="1" stop-color="{{ k.cloud_color }}" stop-opacity="0"/>
    </radialGradient>
    {% endif %}
    {% if k.fog %}
    <linearGradient id="{{ id }}fog" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="{{ k.fog_color }}" stop-opacity="0"/>
      <stop offset=".45" stop-color="{{ k.fog_color }}" stop-opacity="{{ (k.fog * 0.75)|round(2) }}"/>
      <stop offset="1" stop-color="{{ k.fog_color }}" stop-opacity="{{ (k.fog * 0.9)|round(2) }}"/>
    </linearGradient>
    {% endif %}
  </defs>
  <rect width="{{ t.w }}" height="{{ t.h }}" fill="url(#{{ id }}sky)"/>
  {% for s in k.stars %}<circle cx="{{ s.x }}" cy="{{ s.y }}" r="{{ s.r }}" fill="#FFFFFF" opacity="{{ s.op }}"/>{% endfor %}
  {% if k.moon %}
  {% if k.moon.glow > 0.01 %}<circle cx="{{ k.moon.x }}" cy="{{ k.moon.y }}" r="{{ k.moon.g }}" fill="url(#{{ id }}moon)"/>{% endif %}
  <circle cx="{{ k.moon.x }}" cy="{{ k.moon.y }}" r="{{ k.moon.r }}" fill="#9AA6B8" opacity="{{ (k.moon.op * 0.12)|round(2) }}"/>
  <path d="{{ k.moon.path }}" fill="#EEF2F8" opacity="{{ k.moon.op }}"/>
  {% endif %}
  {% if k.sun %}
  <circle cx="{{ k.sun.x }}" cy="{{ k.sun.y }}" r="{{ k.sun.g }}" fill="url(#{{ id }}sun)"/>
  {% if k.sun.disc > 0.02 %}<circle cx="{{ k.sun.x }}" cy="{{ k.sun.y }}" r="{{ k.sun.r }}" fill="{{ k.sun.color }}" opacity="{{ k.sun.disc }}"/>{% endif %}
  {% endif %}
  {% for c in k.clouds %}<ellipse cx="{{ c.cx }}" cy="{{ c.cy }}" rx="{{ c.rx }}" ry="{{ c.ry }}" fill="url(#{{ id }}cl)"/>{% endfor %}
  {% for hl in k.hills %}<path d="{{ hl.d }}" fill="{{ hl.fill }}"/>{% endfor %}
  {% if k.fog %}<rect y="{{ (t.h * 0.3)|round(1) }}" width="{{ t.w }}" height="{{ (t.h * 0.7)|round(1) }}" fill="url(#{{ id }}fog)"/>{% endif %}
  {% if k.rain %}<g stroke="{{ k.rain_color }}" stroke-width="{{ (1.1 * (fs|float))|round(2) }}" stroke-linecap="round" opacity=".55">
  {% for r in k.rain %}<line x1="{{ r.x1 }}" y1="{{ r.y1 }}" x2="{{ r.x2 }}" y2="{{ r.y2 }}"/>{% endfor %}
  </g>{% endif %}
  {% if k.snow %}<g fill="#FFFFFF" opacity=".85">
  {% for f in k.snow %}<circle cx="{{ f.x }}" cy="{{ f.y }}" r="{{ f.r }}"/>{% endfor %}
  </g>{% endif %}
{% endmacro %}

{#- Подпись нового вида: состояние строкой под названием. На весь экран
    кегль растёт, и строки разводятся на столько же - иначе налезают. -#}
{% macro sky_caption(t) %}
  {% set f = fs|float %}
  {% if f > 1 and t.always_status and not t.compact %}
  <text x="{{ (20 * f)|round(1) }}" y="{{ (t.h - 42 * f)|round(1) }}" class="name">{{ t.title }}</text>
  <text x="{{ (20 * f)|round(1) }}" y="{{ (t.h - 18 * f)|round(1) }}" class="status">{{ t.status }}</text>
  {% else %}
  {{ base.caption(t, t.status) }}
  {% endif %}
{% endmacro %}

{#- Подложка под подписи нового вида: у полной плитки - к низу, у
    половинной - слева, где стоит текст. -#}
{% macro sky_scrim(t) %}
  {% if t.h < base.LOW and not t.compact %}
  <rect width="{{ t.w }}" height="{{ t.h }}" fill="url(#{{ uid }}scrimL)"/>
  {% else %}
  <rect width="{{ t.w }}" height="{{ t.h }}" fill="url(#{{ uid }}scrim2)"/>
  {% endif %}
{% endmacro %}

{% macro tile_curtain(t) %}
  {% if t.sky %}
  {{ base.plate(t) }}
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    {{ window(t) }}
    <g class="sash">
      <line x1="{{ t.w / 2 }}" y1="0" x2="{{ t.w / 2 }}" y2="{{ t.h }}"/>
      <line x1="0" y1="{{ (t.h * 0.42)|round(1) }}" x2="{{ t.w }}" y2="{{ (t.h * 0.42)|round(1) }}" class="bar"/>
    </g>
    {% for p in t.drape.panels %}
    <rect x="{{ p.x }}" y="0" width="{{ p.w }}" height="{{ t.h }}" class="drape"/>
    {% for x in p.stripes %}<rect x="{{ x }}" y="0" width="{{ p.sw }}" height="{{ t.h }}" fill="url(#{{ uid }}plt)"/>{% endfor %}
    {% endfor %}
    {{ sky_scrim(t) }}
    {% set hd = t.drape.handle %}
    <rect x="{{ hd.x }}" y="{{ hd.y }}" width="{{ hd.w }}" height="{{ hd.h }}" rx="{{ hd.w / 2 }}" class="handle"/>
  </g>
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        class="rim {{ 'on' if t.on }}"/>
  {{ sky_caption(t) }}
  {% else %}
  {% set half = t.w / 2.0 %}
  {% set lw = half * (1 - t.left_open) %}
  {% set rw = half * (1 - t.right_open) %}
  {{ base.plate(t) }}
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    <rect width="{{ t.w }}" height="{{ t.h }}" fill="url(#{{ uid }}sky)"/>

    {#- силуэт окна: раму видно в проёме между створками,
        поэтому сразу понятно, что это шторы, а не заливка -#}
    {% set fx = t.w * 0.16 %}
    {% set fy = t.h * 0.12 %}
    {% set fw = t.w * 0.68 %}
    {% set fh = t.h * 0.60 %}
    <g class="frame">
      <rect x="{{ '%.1f'|format(fx) }}" y="{{ '%.1f'|format(fy) }}"
            width="{{ '%.1f'|format(fw) }}" height="{{ '%.1f'|format(fh) }}" rx="2"/>
      <line x1="{{ '%.1f'|format(fx + fw / 2) }}" y1="{{ '%.1f'|format(fy) }}"
            x2="{{ '%.1f'|format(fx + fw / 2) }}" y2="{{ '%.1f'|format(fy + fh) }}"/>
      <line x1="{{ '%.1f'|format(fx) }}" y1="{{ '%.1f'|format(fy + fh * 0.42) }}"
            x2="{{ '%.1f'|format(fx + fw) }}" y2="{{ '%.1f'|format(fy + fh * 0.42) }}"/>
      <line x1="{{ '%.1f'|format(fx - t.w * 0.05) }}" y1="{{ '%.1f'|format(fy + fh) }}"
            x2="{{ '%.1f'|format(fx + fw + t.w * 0.05) }}" y2="{{ '%.1f'|format(fy + fh) }}"
            class="sill"/>
    </g>

    {% if lw > 1 %}
    <rect x="0" y="0" width="{{ '%.1f'|format(lw) }}" height="{{ t.h }}" fill="url(#{{ uid }}weave)"/>
    <rect x="{{ '%.1f'|format([lw - 12, 0]|max) }}" y="0"
          width="{{ '%.1f'|format([lw, 12]|min) }}" height="{{ t.h }}" fill="url(#{{ uid }}foldL)"/>
    {% endif %}

    {% if rw > 1 %}
    <rect x="{{ '%.1f'|format(t.w - rw) }}" y="0"
          width="{{ '%.1f'|format(rw) }}" height="{{ t.h }}" fill="url(#{{ uid }}weave)"/>
    <rect x="{{ '%.1f'|format(t.w - rw) }}" y="0"
          width="{{ '%.1f'|format([rw, 12]|min) }}" height="{{ t.h }}" fill="url(#{{ uid }}foldR)"/>
    {% endif %}

    {# гашение к низу под подписи #}
    <rect width="{{ t.w }}" height="{{ t.h }}" fill="url(#{{ uid }}scrim)"/>
  </g>
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        class="rim {{ 'on' if t.on }}"/>
  {{ base.icon_c(t, t.icon or 'blind', 22) }}
  {{ base.value_tr(t) }}
  {{ base.caption(t, t.status) }}
  {% endif %}
{% endmacro %}

{#- ---- рулонные и римские шторы ----
    Полотно висит сверху и уходит вверх, а не в стороны. Высота его
    пропорциональна тому, насколько штора НЕ поднята.

    Поднятая до конца штора рисуется не пустотой, а узкой полосой ткани
    у карниза: собранное полотно никуда не девается, и без него плитка
    в крайнем положении выглядела бы поломанной, а не открытой.

    Складки сжимаются вместе с полотном: шаг берётся по трети высоты,
    пока она меньше обычного. Так у поднятой шторы видно стопку у
    карниза, а у опущенной - ровные ряды карманов под рейки. -#}
{% macro tile_roller(t) %}
  {% if t.sky %}
  {{ base.plate(t) }}
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    {{ window(t) }}
    <g class="sash">
      <line x1="{{ t.w / 2 }}" y1="0" x2="{{ t.w / 2 }}" y2="{{ t.h }}"/>
    </g>
    {% for d in t.roman.folds %}
    <path d="{{ d }}" class="drape"/>
    <path d="{{ d }}" fill="url(#{{ uid }}rfold)"/>
    {% endfor %}
    {{ sky_scrim(t) }}
    {% if t.goal is not none %}
    <line class="goal" x1="0" y1="{{ '%.1f'|format(t.h * (1 - t.goal)) }}"
          x2="{{ t.w }}" y2="{{ '%.1f'|format(t.h * (1 - t.goal)) }}"/>
    {% endif %}
    {% set hd = t.roman.handle %}
    <rect x="{{ hd.x }}" y="{{ hd.y }}" width="{{ hd.w }}" height="{{ hd.h }}" rx="{{ hd.h / 2 }}" class="handle"/>
  </g>
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        class="rim {{ 'on' if t.on }}"/>
  {{ sky_caption(t) }}
  {% else %}
  {% set stack = t.h * (0.06 + 0.10 * t.open) %}
  {% set drop = [t.h * (1 - t.open), stack]|max %}
  {% set step = [t.h * 0.15, [drop / 3.0, 3.0]|max]|min %}
  {{ base.plate(t) }}
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    <rect width="{{ t.w }}" height="{{ t.h }}" fill="url(#{{ uid }}sky)"/>

    {#- та же рама, что у раздвижной: плитка должна читаться как окно
        независимо от того, куда едет ткань -#}
    {% set fx = t.w * 0.16 %}
    {% set fy = t.h * 0.12 %}
    {% set fw = t.w * 0.68 %}
    {% set fh = t.h * 0.60 %}
    <g class="frame">
      <rect x="{{ '%.1f'|format(fx) }}" y="{{ '%.1f'|format(fy) }}"
            width="{{ '%.1f'|format(fw) }}" height="{{ '%.1f'|format(fh) }}" rx="2"/>
      <line x1="{{ '%.1f'|format(fx + fw / 2) }}" y1="{{ '%.1f'|format(fy) }}"
            x2="{{ '%.1f'|format(fx + fw / 2) }}" y2="{{ '%.1f'|format(fy + fh) }}"/>
      <line x1="{{ '%.1f'|format(fx) }}" y1="{{ '%.1f'|format(fy + fh * 0.42) }}"
            x2="{{ '%.1f'|format(fx + fw) }}" y2="{{ '%.1f'|format(fy + fh * 0.42) }}"/>
      <line x1="{{ '%.1f'|format(fx - t.w * 0.05) }}" y1="{{ '%.1f'|format(fy + fh) }}"
            x2="{{ '%.1f'|format(fx + fw + t.w * 0.05) }}" y2="{{ '%.1f'|format(fy + fh) }}"
            class="sill"/>
    </g>

    <rect x="0" y="0" width="{{ t.w }}" height="{{ '%.1f'|format(drop) }}"
          fill="url(#{{ uid }}weave)"/>
    <g class="pleat">
      {% for k in range(1, 12) %}
      {% set py = k * step %}
      {% if py < drop - 1.5 %}
      <line x1="0" y1="{{ '%.1f'|format(py) }}"
            x2="{{ t.w }}" y2="{{ '%.1f'|format(py) }}"/>
      {% endif %}
      {% endfor %}
    </g>
    {#- тень под нижней рейкой и сама рейка: без них край полотна
        сливается с окном, и непонятно, где штора кончается -#}
    <rect x="0" y="{{ '%.1f'|format([drop - 12, 0]|max) }}" width="{{ t.w }}"
          height="{{ '%.1f'|format([drop, 12]|min) }}" fill="url(#{{ uid }}foldB)"/>
    <rect x="0" y="{{ '%.1f'|format([drop - 2.4, 0]|max) }}" width="{{ t.w }}"
          height="{{ '%.1f'|format([drop, 2.4]|min) }}" class="hem"/>

    {# гашение к низу под подписи #}
    <rect width="{{ t.w }}" height="{{ t.h }}" fill="url(#{{ uid }}scrim)"/>

    {#- Куда едет: пунктир на уровне цели, только на ходу - у стоящего
        привода цель совпадает с кромкой полотна.

        Поверх гашения, а не под ним: низ плитки гасится до цвета подложки
        под подписи, и цель вроде «опустить до 10 %» под ним просто
        пропадала - то есть была не видна ровно тогда, когда нужнее всего.
        Точное число всё равно стоит в подписи, пунктир показывает место. -#}
    {% if t.goal is not none %}
    <line class="goal" x1="0" y1="{{ '%.1f'|format(t.h * (1 - t.goal)) }}"
          x2="{{ t.w }}" y2="{{ '%.1f'|format(t.h * (1 - t.goal)) }}"/>
    {% endif %}
  </g>
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        class="rim {{ 'on' if t.on }}"/>
  {{ base.icon_c(t, t.icon or 'blind', 22) }}
  {{ base.value_tr(t) }}
  {{ base.caption(t, t.status) }}
  {% endif %}
{% endmacro %}

{#- ---- светодиодная лента ----
    Плитка - это поле из двух осей:
      X: слева холодный свет, справа тёплый
      Y: сверху ярко, снизу темно
    Точка показывает фактическое положение, оранжевая рамка - что лента включена. -#}
{% macro tile_light(t) %}
  {% if t.sphere %}
  {{ base.plate(t) }}
  {{ base.sphere(t) }}
  {% if t.compact and t.sphere.kind == 'tall' and t.on and t.short_min %}
  <text x="{{ t.w / 2 }}" y="{{ t.h - 31 }}" class="status" text-anchor="middle">{{ t.short_min }}</text>
  {% endif %}
  {% if not t.compact and t.sphere.kind != 'wide' %}
  {% set label = t.short if t.w >= 260 else t.short_min %}
  {% if label %}<text x="{{ t.w - 20 }}" y="41" class="badge" text-anchor="end">{{ label }}</text>{% endif %}
  {% endif %}
  {{ base.caption(t, t.status) }}
  {% else %}
  {{ base.plate(t) }}
  <linearGradient id="{{ uid }}cct{{ t.i }}" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="{{ t.cold }}"/>
    <stop offset="1" stop-color="{{ t.warm }}"/>
  </linearGradient>
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    {#- включена - полная насыщенность; выключена - бледное поле,
        чтобы на общей панели не бросалась в глаза -#}
    <rect width="{{ t.w }}" height="{{ t.h }}" fill="url(#{{ uid }}cct{{ t.i }})"
          opacity="{{ '1' if t.on else '.34' }}"/>
    <rect width="{{ t.w }}" height="{{ t.h }}" fill="url(#{{ uid }}dim)"
          opacity="{{ '1' if t.on else '.55' }}"/>
    {% if t.has_dot %}
      {% set dx = 16 + t.dot_x * (t.w - 32) %}
      {% set dy = 16 + t.dot_y * (t.h - 32) %}
      {# перекрестье помогает считать положение по осям #}
      <line x1="{{ '%.1f'|format(dx) }}" y1="0"
            x2="{{ '%.1f'|format(dx) }}" y2="{{ t.h }}"
            stroke="#FFF" stroke-width="1" opacity=".26"/>
      <line x1="0" y1="{{ '%.1f'|format(dy) }}"
            x2="{{ t.w }}" y2="{{ '%.1f'|format(dy) }}"
            stroke="#FFF" stroke-width="1" opacity=".26"/>
      <g opacity="{{ '1' if t.on else '.55' }}">
        <circle cx="{{ '%.1f'|format(dx) }}" cy="{{ '%.1f'|format(dy) }}" r="9.5"
                fill="{{ t.color }}" stroke="#FFF" stroke-width="2.6"/>
        <circle cx="{{ '%.1f'|format(dx) }}" cy="{{ '%.1f'|format(dy) }}" r="9.5"
                fill="none" stroke="#000" stroke-width="1" opacity=".22"/>
      </g>
    {% endif %}
  </g>
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        class="rim {{ 'on' if t.on }}"/>
  <g class="{{ 'onlight' if t.on }}">
    {{ base.icon_c(t, t.icon or 'strip', 25) }}
    {#- на мелкой плитке цифру не пишем: поле «холодный-тёплый» и положение
        точки уже показывают и яркость, и температуру -#}
    {% if not t.compact and t.h >= base.LOW %}
    {% set label = t.short if t.w >= 260 else t.short_min %}
    {% if label %}
    <text x="{{ t.w - 20 }}" y="41" class="badge" text-anchor="end">{{ label }}</text>
    {% endif %}
    {% endif %}
    {{ base.caption(t, t.status) }}
  </g>
  {% endif %}
{% endmacro %}

{#- ---- диммируемый светильник ----
    Одна величина, поэтому просто заливка снизу вверх на высоту яркости. -#}
{% macro tile_dimmer(t) %}
  {{ base.plate(t) }}
  {% if t.roll %}
  {#- 1.17: колесо в прорези; плитку снизу подсвечивает свет -#}
  {% if t.on %}
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    <rect x="0" y="{{ (t.h * (1 - t.level) * 0.6)|round(1) }}" width="{{ t.w }}" height="{{ t.h }}"
          fill="url(#{{ uid }}dglow)" opacity="{{ (0.35 + 0.65 * t.level)|round(2) }}"/>
  </g>
  {% endif %}
  {{ base.roller(t) }}
  {% if t.compact and t.roll.kind == 'tall' and t.on and t.short %}
  <text x="{{ t.w / 2 }}" y="{{ t.h - 31 }}" class="status" text-anchor="middle">{{ t.short }}</text>
  {% endif %}
  {% if not t.compact and t.roll.kind != 'wide' %}{{ base.value_tr(t) }}{% endif %}
  {{ base.caption(t, t.status) }}
  {% else %}
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    <rect x="0" y="{{ '%.1f'|format(t.h * (1 - t.fill)) }}"
          width="{{ t.w }}" height="{{ '%.1f'|format(t.h * t.fill) }}"
          fill="{{ t.color }}" opacity=".55"/>
    <rect x="0" y="{{ '%.1f'|format(t.h * (1 - t.fill) - 1) }}"
          width="{{ t.w }}" height="2" fill="{{ t.color }}" opacity=".9"/>
  </g>
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ rx }}"
        class="rim {{ 'on' if t.on }}"/>
  {{ base.icon_c(t, t.icon or 'bulb', 24) }}
  {{ base.value_tr(t) }}
  {#- на мелкой плитке цифра в углу не помещается - ставим по центру -#}
  {% if t.compact and t.short %}
  <text x="{{ t.w / 2 }}" y="{{ '%.0f'|format(t.h * 0.66) }}" class="mid"
        text-anchor="middle">{{ t.short }}</text>
  {% endif %}
  {{ base.caption(t, t.status) }}
  {% endif %}
{% endmacro %}

{#- ---- термостат ----
    Циферблат: незамкнутая дуга со шкалой, закрашен участок МЕЖДУ
    фактической температурой и уставкой - тот самый разрыв, который
    прибору предстоит закрыть. Две засечки отмечают обе границы,
    в разрыве дуги снизу стоит режим работы. -#}
{#- ---- ручка термостата (с 1.17) ----
    Прежняя дуга, в центре зубчатая ручка с уставкой, снаружи шкала.
    Дорожка от начала шкалы до уставки: греет - оранжевая, включён и не
    греет - синяя, выключен - серая. Текущая - риска поперёк. -#}
{% macro knob(t) %}
  {% set k = t.knob %}
  <g class="knob {{ k.state }}">
    {% for x in k.ticks %}
    <line x1="{{ x.x1 }}" y1="{{ x.y1 }}" x2="{{ x.x2 }}" y2="{{ x.y2 }}"
          class="kt{{ ' mj' if x.major }}" stroke-width="{{ k.tick_w2 if x.major else k.tick_w }}"/>
    {% endfor %}
    {% for l in k.labels %}
    <text x="{{ l.x }}" y="{{ l.y }}" font-size="{{ k.lab }}" text-anchor="middle" class="kl">{{ l.text }}</text>
    {% endfor %}
    <path d="{{ k.track }}" class="ktrack" stroke-width="{{ k.tw }}"/>
    {% if k.fill %}<path d="{{ k.fill }}" class="kfill" stroke-width="{{ k.tw }}"/>{% endif %}
    {% if k.cur %}
    <line x1="{{ k.cur.x1 }}" y1="{{ k.cur.y1 }}" x2="{{ k.cur.x2 }}" y2="{{ k.cur.y2 }}"
          class="kcur-h" stroke-width="{{ k.cur.halo }}"/>
    <line x1="{{ k.cur.x1 }}" y1="{{ k.cur.y1 }}" x2="{{ k.cur.x2 }}" y2="{{ k.cur.y2 }}"
          class="kcur" stroke-width="{{ k.cur.w }}"/>
    {% endif %}
    {#- ручка: тень двумя слоями без размытия, тело, блик -#}
    {{ base.soft_round(k.cx, k.cy, k.rk, k.shadow_dy) }}
    {#- Зубчатый край - один путь, два слоя через use (с 1.31): тело и
        блик. Раньше путь в пять килобайт шёл дважды. -#}
    {% set gid = uid ~ 'kg' ~ t.i %}
    <defs><path id="{{ gid }}" d="{{ k.gear }}"/></defs>
    <use href="#{{ gid }}" xlink:href="#{{ gid }}" class="kgear"/>
    {% if base.BEVEL == 'round' %}
    <use href="#{{ gid }}" xlink:href="#{{ gid }}" fill="url(#{{ uid }}gl)"/>
    {% elif base.BEVEL == 'sharp' %}
    <use href="#{{ gid }}" xlink:href="#{{ gid }}" fill="url(#{{ uid }}bev)"/>
    <circle cx="{{ k.cx }}" cy="{{ k.cy }}" r="{{ (k.rk * 0.8)|round(1) }}" class="kgear kface"/>
    {% endif %}
    {% if k.ptr %}
    <line x1="{{ k.ptr.x1 }}" y1="{{ k.ptr.y1 }}" x2="{{ k.ptr.x2 }}" y2="{{ k.ptr.y2 }}"
          class="kptr" stroke-width="{{ k.ptr.w }}"/>
    {% endif %}
    {% if k.dot %}
    <circle cx="{{ k.dot.x }}" cy="{{ k.dot.y }}" r="{{ k.dot.r }}" class="kdot" stroke-width="{{ k.dot.sw }}"/>
    {% endif %}
    {% if k.num %}
    <text x="{{ k.cx }}" y="{{ k.cy + k.num_size * 0.3 }}" font-size="{{ k.num_size }}"
          text-anchor="middle" class="knum">{{ k.num }}</text>
    <text x="{{ k.cx + k.deg_dx }}" y="{{ k.cy - k.num_size * 0.36 }}" font-size="{{ k.deg_size }}"
          class="knum kdeg">°</text>
    {% else %}
    <text x="{{ k.cx }}" y="{{ k.cy + k.num_size * 0.3 }}" font-size="{{ k.num_size }}"
          text-anchor="middle" class="knum">--</text>
    {% endif %}
    {% if t.current %}
    <text x="{{ k.cx }}" y="{{ k.cy + k.num_size * 0.3 + k.sub_size * 1.45 }}" font-size="{{ k.sub_size }}"
          text-anchor="middle" class="ksub">сейчас {{ t.current }}</text>
    {% endif %}
  </g>
  <text x="{{ t.w / 2 }}" y="20" class="tag" text-anchor="middle">{{ t.title|upper }}</text>
  <text x="{{ t.w / 2 }}" y="{{ t.h - 16 }}" class="dial-mode knob-mode {{ k.state }}"
        text-anchor="middle">{{ t.status }}</text>
{% endmacro %}

{% macro tile_thermostat(t) %}
  {#- Невидимые зоны плюс и минус по краям плитки. Рисовать кнопки не нужно:
      на плитке и так тесно, а место у краёв всё равно пустует. Долгое
      нажатие открывает пульт, короткое по центру - ничего не делает,
      чтобы случайное касание не меняло уставку. -#}
  {#- Работающий климат плитку не красит (с 1.37): ни заливки, ни рамки, ни
      отсвета. О работе говорят цвет дуги и слово «Греет» - этого хватает,
      а залитая плитка перетягивала взгляд с действительно включённого. -#}
  {{ base.plate(dict(t, on=False)) }}
  {% if t.knob and not t.compact %}
    {{ knob(t) }}
  {% elif t.dial and not t.compact %}
    <g class="dial {{ 'live' if t.on }} {{ 'cool' if t.cooling }} {{ 'muted' if not t.enabled }}">
      {% if t.dial.track %}<path d="{{ t.dial.track }}" class="track"/>{% endif %}
      {% if t.dial.fill %}<path d="{{ t.dial.fill }}" class="fill"/>{% endif %}
      {% for m in t.dial.marks %}
      <line x1="{{ m.x1 }}" y1="{{ m.y1 }}" x2="{{ m.x2 }}" y2="{{ m.y2 }}"
            class="mark {{ m.kind }}"/>
      {% if m.kind == 'current' %}
      {#- точка на конце: риска текущей температуры не теряется на заливке -#}
      <circle cx="{{ m.x2 }}" cy="{{ m.y2 }}" r="2.6" class="mark-dot"/>
      {% endif %}
      {% endfor %}
    </g>
    {#- центрируем ЧИСЛО, знак градуса приписываем за ним: иначе широкий "°"
        перетягивает центровку и цифра кажется сдвинутой влево -#}
    <g {% if not t.enabled %}opacity=".5"{% endif %}>
      <text x="{{ t.dial.cx }}" y="{{ t.dial.cy + 6 }}" class="dial-big"
            text-anchor="middle">{{ t.target_num }}</text>
      {% if t.target_num != '--' %}
      <text x="{{ t.dial.cx + t.deg_dx }}" y="{{ t.dial.cy - 8 }}" class="dial-deg">°</text>
      {% endif %}
    </g>
    {% if t.current %}
    <text x="{{ t.dial.cx }}" y="{{ t.dial.cy + 27 }}" class="dial-sub"
          text-anchor="middle">сейчас {{ t.current }}</text>
    {% endif %}
    <text x="{{ t.w / 2 }}" y="20" class="tag" text-anchor="middle">{{ t.title|upper }}</text>
    <text x="{{ t.w / 2 }}" y="{{ t.h - 16 }}" class="dial-mode"
          text-anchor="middle">{{ t.status }}</text>
  {% else %}
    {{ base.icon_c(t, t.icon or 'heat', 24) }}
    {% if t.current and not t.compact %}
    <text x="{{ t.w - 20 }}" y="41" class="badge" text-anchor="end">{{ t.current }}</text>
    {% endif %}
    {% if not t.compact %}
    <text x="20" y="{{ t.h - 62 }}" class="big"
          {% if not t.enabled %}opacity=".5"{% endif %}>{{ t.target }}</text>
    {% endif %}
    {{ base.caption(t, t.status) }}
  {% endif %}
{% endmacro %}


{#- ---- фанкойл ----
    Циферблат термостата: дуга со шкалой, две засечки - факт и уставка,
    закрашен разрыв между ними. Дошёл до уставки - закраска исчезла, и
    это видно без слов.

    На широкой плитке дуга уезжает влево, оставаясь окружностью: радиус
    считается от меньшей стороны. Справа встаёт колонка - режим,
    вентилятор со ступенями скорости и клапан. Строкой внизу это не
    передать, а на дугу не положить. -#}
{% macro tile_fancoil(t) %}
  {#- Работающий климат плитку не красит (с 1.37): ни заливки, ни рамки, ни
      отсвета. О работе говорят цвет дуги и слово «Греет» - этого хватает,
      а залитая плитка перетягивала взгляд с действительно включённого. -#}
  {{ base.plate(dict(t, on=False)) }}
  {% if t.panel and not t.compact %}
    {% if t.panel.square %}{{ fcsquare(t) }}{% else %}{{ fcpanel(t) }}{% endif %}
  {% elif t.dial and not t.compact %}
    <g class="dial {{ 'live' if t.on }} {{ 'cool' if t.cooling }} {{ 'muted' if not t.enabled }}">
      {% if t.dial.track %}<path d="{{ t.dial.track }}" class="track"/>{% endif %}
      {% if t.dial.fill %}<path d="{{ t.dial.fill }}" class="fill"/>{% endif %}
      {% for m in t.dial.marks %}
      <line x1="{{ m.x1 }}" y1="{{ m.y1 }}" x2="{{ m.x2 }}" y2="{{ m.y2 }}"
            class="mark {{ m.kind }}"/>
      {% if m.kind == 'current' %}
      <circle cx="{{ m.x2 }}" cy="{{ m.y2 }}" r="2.6" class="mark-dot"/>
      {% endif %}
      {% endfor %}
    </g>
    {#- центрируем ЧИСЛО, знак градуса приписываем за ним -#}
    <g {% if not t.enabled %}opacity=".5"{% endif %}>
      <text x="{{ t.dial.cx }}" y="{{ t.dial.cy + 6 }}" class="dial-big"
            text-anchor="middle">{{ t.target_num }}</text>
      {% if t.target_num != '--' %}
      <text x="{{ t.dial.cx + t.deg_dx }}" y="{{ t.dial.cy - 8 }}" class="dial-deg">°</text>
      {% endif %}
    </g>
    {% if t.current %}
    <text x="{{ t.dial.cx }}" y="{{ t.dial.cy + 27 }}" class="dial-sub"
          text-anchor="middle">сейчас {{ t.current }}</text>
    {% endif %}
    <text x="{{ t.dial.cx }}" y="20" class="tag" text-anchor="middle">{{ t.title|upper }}</text>
    <text x="{{ t.dial.cx }}" y="{{ t.h - 16 }}" class="dial-mode"
          text-anchor="middle">{{ t.status }}</text>

    {#- узкая плитка: значки по верхним углам, колонки там нет -#}
    {% if t.corners %}
    <use href="#{{ uid }}ic-{{ t.corners.mode.icon }}" xlink:href="#{{ uid }}ic-{{ t.corners.mode.icon }}"
         x="{{ t.corners.mode.x }}" y="12" width="17" height="17"
         opacity="{{ '.95' if t.corners.mode.on else '.40' }}"/>
    <use href="#{{ uid }}ic-{{ t.corners.fan.icon }}" xlink:href="#{{ uid }}ic-{{ t.corners.fan.icon }}"
         x="{{ t.corners.fan.x }}" y="12" width="17" height="17"
         opacity="{{ '.95' if t.corners.fan.on else '.40' }}"/>
    <g class="fanbars {{ 'live' if t.on }}">
      {% for b in t.corners.fan.bars %}
      <rect x="{{ b.x }}" y="{{ b.y }}" width="4" height="{{ b.h }}" rx="1.5"
            class="{{ 'on' if b.on }}"/>
      {% endfor %}
    </g>
    {% endif %}

    {% if t.side %}
    {% for row in t.rows %}
    <use href="#{{ uid }}ic-{{ row.icon }}" xlink:href="#{{ uid }}ic-{{ row.icon }}"
         x="{{ t.side.x }}" y="{{ row.y - 13 }}" width="17" height="17"
         opacity="{{ '.95' if row.on else '.40' }}"/>
    <text x="{{ t.side.text_x }}" y="{{ row.y }}"
          class="siderow{{ ' on' if row.on }}">{{ row.text }}</text>
    {% if row.bars %}
    <g class="fanbars {{ 'live' if t.on }}">
      {% for b in row.bars %}
      <rect x="{{ b.x }}" y="{{ b.y }}" width="4" height="{{ b.h }}" rx="1.5"
            class="{{ 'on' if b.on }}"/>
      {% endfor %}
    </g>
    {% endif %}
    {% endfor %}
    {% endif %}
  {% else %}
    {{ base.icon_c(t, t.icon or 'fan', 24) }}
    {% if t.current and not t.compact %}
    <text x="{{ t.w - 20 }}" y="41" class="badge" text-anchor="end">{{ t.current }}</text>
    {% endif %}
    {% if not t.compact %}
    <text x="20" y="{{ t.h - 62 }}" class="big"
          {% if not t.enabled %}opacity=".5"{% endif %}>{{ t.target }}</text>
    {% endif %}
    {{ base.caption(t, t.status) }}
  {% endif %}
{% endmacro %}


{#- ---- фанкойл пультом (с 1.37) ----
    Ползунок уставки, квадратная решётка с пропеллером, табло уставки
    сегментными цифрами, «сейчас», клавиши скорости, режим и клапан.
    Рисуется в рамке 354×170 (квадратная плитка - 170×170) и
    масштабируется в плитку (k, dx, dy). Части общие у обеих рамок. -#}
{% macro fc_defs(id) %}
  <defs>
    <linearGradient id="{{ id }}cap" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--key-hi)"/><stop offset="1" stop-color="var(--key-lo)"/></linearGradient>
    <linearGradient id="{{ id }}in" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--key-in-a)"/><stop offset="1" stop-color="var(--key-in-b)"/></linearGradient>
    <filter id="{{ id }}sh" filterUnits="userSpaceOnUse" x="-20" y="-20" width="400" height="220"><feGaussianBlur stdDeviation="2"/></filter>
  </defs>
{% endmacro %}

{% macro fc_slider(p, id, labels=True) %}
    {% for k in p.ticks %}
    <line x1="{{ k.x1 }}" y1="{{ k.y }}" x2="{{ k.x2 }}" y2="{{ k.y }}" class="fcp-tk{{ ' mj' if k.major }}"/>
    {% if labels and k.label is not none %}<text x="{{ p.sx - 25 }}" y="{{ k.y + 3.5 }}" font-size="9.5" text-anchor="end" class="fcp-faint">{{ k.label }}</text>{% endif %}
    {% endfor %}
    <rect x="{{ p.sx - 5 }}" y="{{ p.slot_y }}" width="10" height="{{ p.slot_h }}" rx="5" class="fcp-well"/>
    {% if p.fill %}<rect x="{{ p.sx - 2 }}" y="{{ p.fill.y }}" width="4" height="{{ p.fill.h }}" rx="2" class="fcp-col fcp-fill"/>{% endif %}
    {% if p.cur_y is not none %}<circle cx="{{ p.sx }}" cy="{{ p.cur_y }}" r="2.6" class="fcp-ink"/>{% endif %}
{% endmacro %}

{% macro fc_cap(p, id) %}
    <rect x="{{ p.sx - 20 }}" y="{{ p.cap_y - 9 }}" width="40" height="24" rx="6" class="fcp-shadow" filter="url(#{{ id }}sh)"/>
    <rect x="{{ p.sx - 20 }}" y="{{ p.cap_y - 11 }}" width="40" height="22" rx="6" fill="url(#{{ id }}cap)" class="fcp-edge"/>
    {% for d in (-5, 0, 5) %}
    <line x1="{{ p.sx - 13 }}" y1="{{ p.cap_y + d }}" x2="{{ p.sx + 13 }}" y2="{{ p.cap_y + d }}" class="fcp-rib"/>
    <line x1="{{ p.sx - 13 }}" y1="{{ p.cap_y + d + 1.2 }}" x2="{{ p.sx + 13 }}" y2="{{ p.cap_y + d + 1.2 }}" class="fcp-hl"/>
    {% endfor %}
{% endmacro %}

{% macro fc_grille(g) %}
    {% set rx = (g.w * 0.13)|round(1) %}
    <rect x="{{ g.x }}" y="{{ g.y }}" width="{{ g.w }}" height="{{ g.w }}" rx="{{ rx }}" class="fcp-well"/>
    <g class="fcp-col">
      <g>
        {% for b in g.blades %}<path d="{{ b }}" class="fcp-blade"/>{% endfor %}
        <circle cx="{{ g.cx }}" cy="{{ g.cy }}" r="{{ g.hub }}" class="fcp-hub"/>
        {% if g.spin %}<animateTransform attributeName="transform" type="rotate" from="0 {{ g.cx }} {{ g.cy }}"
            to="360 {{ g.cx }} {{ g.cy }}" dur="{{ g.dur }}s" repeatCount="indefinite"/>{% endif %}
      </g>
    </g>
    {% for y in g.slats %}
    <rect x="{{ g.x + 4 }}" y="{{ y }}" width="{{ g.w - 8 }}" height="{{ (g.w - 8) / 16 }}" rx="1.5" class="fcp-slat"/>
    <line x1="{{ g.x + 5 }}" y1="{{ y + 0.6 }}" x2="{{ g.x + g.w - 5 }}" y2="{{ y + 0.6 }}" class="fcp-hl"/>
    {% endfor %}
    <rect x="{{ g.x }}" y="{{ g.y }}" width="{{ g.w }}" height="{{ g.w }}" rx="{{ rx }}" class="fcp-frame"/>
{% endmacro %}

{% macro fc_lcd(l) %}
    <rect x="{{ l.x }}" y="{{ l.y }}" width="{{ l.w }}" height="{{ l.h }}" rx="9" class="fcp-well"/>
    <rect x="{{ l.x + 3 }}" y="{{ l.y + 3 }}" width="{{ l.w - 6 }}" height="{{ l.h - 6 }}" rx="6.5" class="fcp-lcd"/>
    <g class="fcp-lcdg">
    {% for q in l.polys %}<polygon points="{{ q.p }}" class="{{ 'fcp-ink' if q.on else 'fcp-ghost' }}"/>{% endfor %}
    {% for d in l.dots %}<circle cx="{{ d.x }}" cy="{{ d.y }}" r="{{ d.r }}" class="fcp-ink"/>{% endfor %}
    {% if l.deg %}<text x="{{ l.cx }}" y="{{ l.cy }}" font-size="10" font-weight="700" class="fcp-ink">°C</text>{% endif %}
    {% for b in l.bars %}<rect x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ b.h }}" rx="1" class="{{ 'fcp-ink' if b.on else 'fcp-ghost' }}"/>{% endfor %}
    {% if l.auto %}<text x="{{ l.auto.x }}" y="{{ l.auto.y }}" font-size="8" font-weight="700" text-anchor="middle" class="fcp-ink">A</text>{% endif %}
    </g>
{% endmacro %}

{% macro fcpanel(t) %}
  {% set p = t.panel %}{% set id = uid ~ 'fc' ~ t.i %}
  {{ fc_defs(id) }}
  <g transform="translate({{ p.dx }} {{ p.dy }}) scale({{ p.k }})" class="fcp {{ p.tone }}{{ ' off' if not t.enabled }}">
    {{ fc_slider(p, id) }}
    {{ fc_grille(p.grille) }}
    {{ fc_lcd(p.lcd) }}
    {{ fc_cap(p, id) }}
    {#- правая колонка -#}
    <text x="340" y="26" text-anchor="end" font-size="11" class="tag">{{ p.title }}</text>
    <text x="{{ p.right }}" y="26" font-size="11" class="fcp-dim">сейчас</text>
    <text x="{{ p.right }}" y="52" font-size="24" class="fcp-num">{{ p.current }}<tspan font-size="13" dy="-10">°</tspan></text>
    {% for k in p['keys'] %}
    {% set dz = 4 if k.down else 0 %}{% set top = p.ky + dz %}{% set fh = p.kh - dz - (2 if k.down else 5) %}
    <rect x="{{ k.x - 2.5 }}" y="{{ p.ky - 2.5 }}" width="{{ k.w + 5 }}" height="{{ p.kh + 5 }}" rx="8.5" class="fcp-well"/>
    {% if not k.down %}<rect x="{{ k.x + 1 }}" y="{{ p.ky + 5 }}" width="{{ k.w - 2 }}" height="{{ p.kh - 2 }}" rx="6" class="fcp-shadow" filter="url(#{{ id }}sh)"/>{% endif %}
    <rect x="{{ k.x }}" y="{{ top }}" width="{{ k.w }}" height="{{ p.kh - dz }}" rx="6" class="fcp-side"/>
    <rect x="{{ k.x }}" y="{{ top }}" width="{{ k.w }}" height="{{ fh }}" rx="6"
          fill="url(#{{ id }}{{ 'in' if k.down else 'cap' }})" class="fcp-edge"/>
    <line x1="{{ k.x + 5 }}" y1="{{ top + 1.2 }}" x2="{{ k.x + k.w - 5 }}" y2="{{ top + 1.2 }}" class="fcp-hl"/>
    {% if k.label != '0' %}
    <g class="{{ 'fcp-col' if k.led }}">
      <rect x="{{ k.cx - 7 }}" y="{{ top + 6 }}" width="14" height="3.2" rx="1.6" class="fcp-led{{ ' on' if k.led }}"/>
      {% if k.led %}<rect x="{{ k.cx - 9 }}" y="{{ top + 4 }}" width="18" height="7" rx="3.5" class="fcp-ledglow" filter="url(#{{ id }}sh)"/>{% endif %}
    </g>
    {% endif %}
    <text x="{{ k.cx }}" y="{{ top + fh / 2 + 8 }}" font-size="14" text-anchor="middle"
          class="fcp-klab{{ ' in' if k.down }}">{{ k.label }}</text>
    {% endfor %}
    {#- режим и клапан: значки 16 и подписи на одной средней линии -#}
    <g class="fcp-col">
      <use href="#{{ uid }}ic-{{ p.mode.icon }}" xlink:href="#{{ uid }}ic-{{ p.mode.icon }}" x="{{ p.right }}" y="{{ p.ml - 8 }}" width="16" height="16"/>
      <text x="{{ p.right + 21 }}" y="{{ p.ml + 4.2 }}" font-size="12" font-weight="600" class="fcp-word">{{ p.mode.title }}</text>
    </g>
    {% if p.valve is not none %}
    <g class="{{ 'fcp-col' if p.valve and t.enabled else 'fcp-dimc' }}">
      <use href="#{{ uid }}ic-drop" xlink:href="#{{ uid }}ic-drop" x="{{ p.vx }}" y="{{ p.ml - 8 }}" width="16" height="16"/>
      <text x="{{ p.vx + 21 }}" y="{{ p.ml + 4.2 }}" font-size="12" font-weight="600" class="fcp-word">{{ 'клапан' if p.valve else 'закрыт' }}</text>
    </g>
    {% endif %}
  </g>
{% endmacro %}

{#- Квадратная плитка фанкойла (с 1.38) - «фейдер»: ползунок, решётка,
    табло; текущая температура слева сверху, значок режима и название справа. -#}
{% macro fcsquare(t) %}
  {% set p = t.panel %}{% set id = uid ~ 'fc' ~ t.i %}
  {{ fc_defs(id) }}
  <g transform="translate({{ p.dx }} {{ p.dy }}) scale({{ p.k }})" class="fcp {{ p.tone }}{{ ' off' if not t.enabled }}">
    {{ fc_slider(p, id, False) }}
    <text x="14" y="22" font-size="13" class="fcp-num">{{ p.current }}<tspan font-size="8" dy="-5">°</tspan></text>
    <text x="156" y="22" font-size="11" text-anchor="end" class="tag">{{ p.title }}</text>
    <g class="{{ 'fcp-col' if t.enabled else 'fcp-dimc' }}">
      <use href="#{{ uid }}ic-{{ p.mode.icon }}" xlink:href="#{{ uid }}ic-{{ p.mode.icon }}"
           x="{{ p.icon_x }}" y="11" width="14" height="14"/>
    </g>
    {{ fc_grille(p.grille) }}
    {{ fc_lcd(p.lcd) }}
    {{ fc_cap(p, id) }}
  </g>
{% endmacro %}
