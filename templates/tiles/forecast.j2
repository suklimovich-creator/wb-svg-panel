{#-
  Погода: текущая слева, прогноз кривой справа.

  Часть templates/panel.svg.j2, вынесенная в отдельный файл при
  разделении шаблона. Импортируется с контекстом: макросам нужны
  uid, fs и rx, общие для всего документа.
-#}

{% import "tiles/_base.j2" as base with context %}

{#- ---- погода: текущая слева, прогноз кривой ----
    Данные не из истории, а из каналов temp_00…temp_NN виртуального
    устройства: это прогноз вперёд, а не прошлое. Сетка и подписи - те же,
    что у обычных графиков, чтобы плитки читались одинаково. -#}
{% macro tile_forecast(t) %}
  {{ base.plate(t) }}
  <g clip-path="url(#{{ uid }}clip{{ t.i }})">
    {#- сетка: часы по вертикали, шкала по горизонтали -#}
    {% for tk in t.ticks %}
    <line x1="{{ tk.x }}" y1="0" x2="{{ tk.x }}" y2="{{ t.h }}"
          class="tick{{ ' major' if tk.major }}"/>
    {% endfor %}
    {% for hl in t.hlines %}
    <line x1="0" y1="{{ hl.y }}" x2="{{ t.w }}" y2="{{ hl.y }}"
          class="hline{{ ' edge' if hl.edge }}"/>
    {% endfor %}
    {#- Облачность фоном под верхней границей: чем плотнее облака, тем
        серее. Это подложка, а не данные для чтения, поэтому без шкалы. -#}
    {% for c in t.sky or [] %}
    <rect x="{{ c.x }}" y="{{ t.h * 0.40 }}" width="{{ c.w }}"
          height="{{ t.h * 0.42 }}" fill="#8A9AAE" opacity="{{ c.opacity }}"/>
    {% endfor %}
    {#- Дождь столбиками от нижней линии: высота - вероятность,
        насыщенность - количество. -#}
    {% for b in t.bars or [] %}
    <rect x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ b.h }}"
          rx="2" fill="#3B8FD4" opacity="{{ b.opacity }}"/>
    {% endfor %}
    {#- Значок погоды на каждый подписанный час. Над графиком места нет -
        там строка про дождь и текущая температура, значки на них наезжали.
        Поэтому внутри полосы, у верхнего края, приглушённо: кривая рисуется
        позже и проходит поверх. -#}
    {% for ic in t.icons or [] %}
    <g transform="translate({{ ic.x - 7 }},{{ t.h * 0.40 + 3 }})" opacity=".38">
      <use href="#{{ uid }}ic-{{ ic.name }}" xlink:href="#{{ uid }}ic-{{ ic.name }}"
           width="14" height="14"/>
    </g>
    {% endfor %}
    {% if t.geom %}
    <linearGradient id="{{ uid }}wfade{{ t.i }}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0"   stop-color="#5AA9E6" stop-opacity=".34"/>
      <stop offset=".55" stop-color="#5AA9E6" stop-opacity=".12"/>
      <stop offset="1"   stop-color="#5AA9E6" stop-opacity=".02"/>
    </linearGradient>
    <path d="{{ t.geom.area }}" fill="url(#{{ uid }}wfade{{ t.i }})"/>
    <path d="{{ t.geom.line }}" fill="none" stroke="#3B8FD4"
          stroke-width="{{ t.line_w | default(2.4) }}"
          stroke-linecap="round" stroke-linejoin="round"/>
    {% for m in t.marks %}
    {#- экстремумы: только точки, значения читаются по шкале слева -#}
    <circle cx="{{ m.x }}" cy="{{ m.y }}" r="{{ 3.4 * (fs | default(1)) }}"
            fill="{{ '#C4553B' if m.kind == 'max' else '#3B8FD4' }}"
            stroke="var(--tile)" stroke-width="1.5"/>
    {% endfor %}
    {% endif %}
    {% if t.grid_labels %}
      {% for hl in t.hlines %}
        {% if hl.text %}
      <text x="7" y="{{ hl.y - 3 }}" class="axis"
            style="fill:{{ t.label_color | default('#2B6B9E') }}">{{ hl.text }}</text>
        {% endif %}
      {% endfor %}
    {% endif %}
    {% if t.time_labels %}
      {% for tm in t.times %}
      <text x="{{ tm.x }}" y="{{ t.h * 0.82 - 3 }}" class="axis"
            text-anchor="{{ tm.anchor }}">{{ tm.text }}</text>
      {% endfor %}
    {% endif %}
  </g>
  <rect x="1" y="1" width="{{ t.w - 2 }}" height="{{ t.h - 2 }}" rx="{{ (t.rx|default(rx)) }}" class="rim"/>

  {{ base.icon_c(t, t.icon or t.icon_now or 'sun', 26) }}
  <text x="{{ t.w - 20 }}" y="42" class="wnow" text-anchor="end">{{ t.now_temp }}</text>
  {% if t.weather_desc %}
  <text x="{{ t.w - 20 }}" y="{{ 42 + 18 * (fs | default(1)) }}" class="status" text-anchor="end" data-forecast-desc="true"
        style="font-size:{{ t.forecast_desc_fit.size }}px"
        {% if t.forecast_desc_fit.length %}textLength="{{ t.forecast_desc_fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ t.weather_desc }}</text>
  {% endif %}

  <text x="20" y="{{ t.h - 20 }}" class="name">{{ t.title }}</text>
  {% if t.extra %}
  <text x="{{ t.w - 20 }}" y="{{ t.h - 20 }}" class="status" text-anchor="end" data-forecast-extra="true"
        style="font-size:{{ t.forecast_extra_fit.size }}px"
        {% if t.forecast_extra_fit.length %}textLength="{{ t.forecast_extra_fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ t.extra }}</text>
  {% endif %}
  {% if t.stale_forecast %}
  <circle cx="{{ t.w - 12 }}" cy="12" r="3.5" class="dot-warn"/>
  {% endif %}
{% endmacro %}


{#- ---- часы и текущая погода: композиция базовых блоков (1.77.4) ----
    low = два блока 177×75; square = два блока 170×85;
    wide = два блока 177×170; tall = 177×170 + 170×85;
    tower = два блока 177×170. Один режим масштабирует свой базовый блок.
    Раскрытие по-прежнему использует полноценный прогноз выше. -#}
{% macro clock_low(t) %}
  <g data-clock-block="clock-low">
    <text x="88.5" y="38" text-anchor="middle" class="wnow" data-clock-time="true"
          style="font-size:{{ t.clock_low_time_fit.size }}px;letter-spacing:-1.2px;font-variant-numeric:tabular-nums"
          {% if t.clock_low_time_fit.length %}textLength="{{ t.clock_low_time_fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ t.clock_time }}</text>
    <text x="88.5" y="55" text-anchor="middle" class="status" data-clock-date="true"
          style="font-size:11.5px;font-weight:500">{{ t.clock_date }}</text>
  </g>
{% endmacro %}

{% macro weather_low(t) %}
  <g data-clock-block="weather-low">
    <use href="#{{ uid }}ic-{{ t.icon_now or 'sun' }}" xlink:href="#{{ uid }}ic-{{ t.icon_now or 'sun' }}"
         x="13" y="6" width="24" height="24" class="icon"/>
    <text x="161" y="38" text-anchor="end" class="wnow" data-clock-temp="true"
          style="font-size:{{ t.clock_low_temp_fit.size }}px;letter-spacing:-1px"
          {% if t.clock_low_temp_fit.length %}textLength="{{ t.clock_low_temp_fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ t.now_temp }}</text>
    {% if t.weather_desc %}
    <text x="88.5" y="53" text-anchor="middle" class="status" data-clock-desc="true"
          style="font-size:{{ t.clock_low_desc_fit.size }}px;font-weight:500"
          {% if t.clock_low_desc_fit.length %}textLength="{{ t.clock_low_desc_fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ t.weather_desc }}</text>
    {% endif %}
    <text x="88.5" y="68" text-anchor="middle" class="status" data-clock-extra="true"
          style="font-size:{{ t.clock_low_extra_fit.size }}px;font-weight:500"
          {% if t.clock_low_extra_fit.length %}textLength="{{ t.clock_low_extra_fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ t.extra or '—' }}</text>
  </g>
{% endmacro %}

{% macro clock_half(t) %}
  <g data-clock-block="clock-half">
    <text x="85" y="56" text-anchor="middle" class="wnow" data-clock-time="true"
          style="font-size:{{ t.clock_half_time_fit.size }}px;letter-spacing:-1.5px;font-variant-numeric:tabular-nums"
          {% if t.clock_half_time_fit.length %}textLength="{{ t.clock_half_time_fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ t.clock_time }}</text>
    <text x="85" y="77" text-anchor="middle" class="status" data-clock-date="true"
          style="font-size:14px;font-weight:500">{{ t.clock_date }}</text>
  </g>
{% endmacro %}

{% macro weather_half(t) %}
  <g data-clock-block="weather-half">
    <use href="#{{ uid }}ic-{{ t.icon_now or 'sun' }}" xlink:href="#{{ uid }}ic-{{ t.icon_now or 'sun' }}"
         x="{{ t.clock_half_icon_x }}" y="9" width="24" height="24" class="icon"/>
    <text x="{{ t.clock_half_temp_x }}" y="35" class="wnow" data-clock-temp="true"
          style="font-size:{{ t.clock_half_temp_fit.size }}px;letter-spacing:-1px"
          {% if t.clock_half_temp_fit.length %}textLength="{{ t.clock_half_temp_fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ t.now_temp }}</text>
    {% if t.weather_desc %}
    <text x="85" y="51" text-anchor="middle" class="status" data-clock-desc="true"
          style="font-size:{{ t.clock_half_desc_fit.size }}px;font-weight:500"
          {% if t.clock_half_desc_fit.length %}textLength="{{ t.clock_half_desc_fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ t.weather_desc }}</text>
    {% endif %}
    <text x="85" y="66" text-anchor="middle" class="status" data-clock-extra="true"
          style="font-size:{{ t.clock_half_extra_fit.size }}px;font-weight:500"
          {% if t.clock_half_extra_fit.length %}textLength="{{ t.clock_half_extra_fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ t.extra or '—' }}</text>
  </g>
{% endmacro %}

{% macro clock_square(t) %}
  <g data-clock-block="clock-square">
    <text x="88.5" y="93" text-anchor="middle" class="wnow" data-clock-time="true"
          style="font-size:{{ t.clock_square_time_fit.size }}px;letter-spacing:-2px;font-variant-numeric:tabular-nums"
          {% if t.clock_square_time_fit.length %}textLength="{{ t.clock_square_time_fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ t.clock_time }}</text>
    <text x="88.5" y="120" text-anchor="middle" class="status" data-clock-date="true"
          style="font-size:15px;font-weight:500">{{ t.clock_date }}</text>
  </g>
{% endmacro %}

{% macro weather_square(t) %}
  <g data-clock-block="weather-square">
    <use href="#{{ uid }}ic-{{ t.icon_now or 'sun' }}" xlink:href="#{{ uid }}ic-{{ t.icon_now or 'sun' }}"
         x="13" y="28" width="36" height="36" class="icon"/>
    <text x="164" y="66" text-anchor="end" class="wnow" data-clock-temp="true"
          style="font-size:{{ t.clock_square_temp_fit.size }}px;letter-spacing:-1.5px"
          {% if t.clock_square_temp_fit.length %}textLength="{{ t.clock_square_temp_fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ t.now_temp }}</text>
    {% if t.weather_desc %}
    <text x="88.5" y="92" text-anchor="middle" class="status" data-clock-desc="true"
          style="font-size:{{ t.clock_square_desc_fit.size }}px;font-weight:500"
          {% if t.clock_square_desc_fit.length %}textLength="{{ t.clock_square_desc_fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ t.weather_desc }}</text>
    {% endif %}
    {% for metric in t.clock_metrics %}
    <text x="164" y="{{ 110 + loop.index0 * 17 }}" text-anchor="end" class="status" data-clock-metric="true"
          style="font-size:{{ metric.fit.size }}px;font-weight:500"
          {% if metric.fit.length %}textLength="{{ metric.fit.length }}" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ metric.text }}</text>
    {% endfor %}
  </g>
{% endmacro %}

{% macro clock_single(t) %}
  {% if t.clock_layout == 'low' %}
    {% set bw, bh = 177, 75 %}
  {% else %}
    {% set bw, bh = 177, 170 %}
  {% endif %}
  {% set s = [t.w / bw, t.h / bh] | min %}
  {% set dx = (t.w - bw * s) / 2 %}
  {% set dy = (t.h - bh * s) / 2 %}
  <g data-clock-layout="single-{{ t.clock_mode }}" data-clock-mode="{{ t.clock_mode }}"
     transform="translate({{ dx }},{{ dy }}) scale({{ s }})">
    {% if t.clock_mode == 'clock' %}
      {% if t.clock_layout == 'low' %}{{ clock_low(t) }}{% else %}{{ clock_square(t) }}{% endif %}
    {% else %}
      {% if t.clock_layout == 'low' %}{{ weather_low(t) }}{% else %}{{ weather_square(t) }}{% endif %}
    {% endif %}
  </g>
{% endmacro %}

{% macro clock_composite(t) %}
  {% if t.clock_layout == 'low' %}
    {% set bw, bh = 354, 75 %}
  {% elif t.clock_layout == 'wide' %}
    {% set bw, bh = 354, 170 %}
  {% elif t.clock_layout == 'tall' %}
    {% set bw, bh = 177, 255 %}
  {% elif t.clock_layout == 'tower' %}
    {% set bw, bh = 177, 340 %}
  {% else %}
    {% set bw, bh = 170, 170 %}
  {% endif %}
  {% set s = [t.w / bw, t.h / bh] | min %}
  {% set dx = (t.w - bw * s) / 2 %}
  {% set dy = (t.h - bh * s) / 2 %}
  <g data-clock-layout="{{ t.clock_layout }}" data-clock-mode="clock_weather"
     {% if s != 1 or dx or dy %}transform="translate({{ dx }},{{ dy }}) scale({{ s }})"{% endif %}>
    {% if t.clock_layout == 'low' %}
      {{ clock_low(t) }}
      <g transform="translate(177,0)">{{ weather_low(t) }}</g>
      <line x1="177" y1="6" x2="177" y2="69" class="tick" style="stroke-width:1px;opacity:.35"/>
    {% elif t.clock_layout == 'wide' %}
      {{ clock_square(t) }}
      <g transform="translate(177,0)">{{ weather_square(t) }}</g>
      <line x1="177" y1="25" x2="177" y2="145" class="tick" style="stroke-width:1px;opacity:.35"/>
    {% elif t.clock_layout == 'tall' %}
      {{ clock_square(t) }}
      <g transform="translate(3.5,170)">{{ weather_half(t) }}</g>
      <line x1="16" y1="170" x2="161" y2="170" class="tick" style="stroke-width:1px;opacity:.35"/>
    {% elif t.clock_layout == 'tower' %}
      {{ clock_square(t) }}
      <g transform="translate(0,170)">{{ weather_square(t) }}</g>
      <line x1="16" y1="170" x2="161" y2="170" class="tick" style="stroke-width:1px;opacity:.35"/>
    {% else %}
      {{ clock_half(t) }}
      <g transform="translate(0,85)">{{ weather_half(t) }}</g>
      <line x1="16" y1="85" x2="154" y2="85" class="tick" style="stroke-width:1px;opacity:.35"/>
    {% endif %}
  </g>
{% endmacro %}

{% macro tile_clock(t) %}
  {% if t.view == 'pad' %}
    {{ tile_forecast(t) }}
  {% else %}
    {{ base.plate(t) }}
    {% if t.clock_mode == 'clock_weather' %}{{ clock_composite(t) }}{% else %}{{ clock_single(t) }}{% endif %}
    {% if t.stale_forecast %}
    <circle cx="{{ t.w - 12 }}" cy="12" r="3.5" class="dot-warn"/>
    {% endif %}
  {% endif %}
{% endmacro %}
