[Unit]
Description=SVG-панели умного дома (wb-svg-panel)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
# Всё лежит на /mnt/data — это единственный раздел, который переживает
# обновление прошивки. На rootfs (/opt, /etc) держать код нельзя.
User=root
WorkingDirectory=/mnt/data/wb-svg-panel
Environment=PYTHONUNBUFFERED=1
Environment=WB_PANEL_CONFIG=/mnt/data/wb-svg-panel/config.yaml
ExecStart=/usr/bin/python3 /mnt/data/wb-svg-panel/panel.py
Restart=always
RestartSec=5

# Логи только в journald — ничего не пишем на eMMC.
StandardOutput=journal
StandardError=journal

# Писать демону можно только в data/ - там файл списков. Всё остальное
# под ProtectSystem=strict только на чтение: состояние в памяти, история
# читается через MQTT-RPC. Без ReadWritePaths списки жили только в памяти
# и пропадали при каждом перезапуске (до 1.12.1).
#
# Папку создаём до запуска и вне песочницы («+»): systemd не смонтирует
# на запись то, чего нет, а изнутри песочницы её уже не создать. «-» у
# ReadWritePaths - не валить запуск, если папки всё же нет; это поймает
# страница /check.
ExecStartPre=+/bin/mkdir -p /mnt/data/wb-svg-panel/data
ReadWritePaths=-/mnt/data/wb-svg-panel/data
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
