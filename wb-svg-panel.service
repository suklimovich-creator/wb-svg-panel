[Unit]
Description=SVG-панели умного дома (wb-svg-panel)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
# Всё лежит на /mnt/data — это единственный раздел, который переживает
# обновление прошивки. На rootfs (/opt, /etc) держать код нельзя.
User=root
WorkingDirectory=/mnt/data/wb-svg-panel
Environment=PYTHONUNBUFFERED=1
Environment=WB_PANEL_CONFIG=/mnt/data/wb-svg-panel/config.yaml
ExecStart=/usr/bin/python3 /mnt/data/wb-svg-panel/panel.py
Restart=always
RestartSec=5

# Логи только в journald — ничего не пишем на eMMC.
StandardOutput=journal
StandardError=journal

# Публикация редактора заменяет YAML через rename, поэтому на запись
# нужен каталог конфига и его подкаталоги с !include. Код, шаблоны,
# темы и служебные файлы приложения по-прежнему монтируются read-only.
# RevisionStore ограничивает изменения деревом управляемых документов.
ExecStartPre=+/bin/mkdir -p /mnt/data/wb-svg-panel/data
ReadWritePaths=/mnt/data/wb-svg-panel
ReadOnlyPaths=-/mnt/data/wb-svg-panel/.git -/mnt/data/wb-svg-panel/.github
ReadOnlyPaths=/mnt/data/wb-svg-panel/wbpanel /mnt/data/wb-svg-panel/templates /mnt/data/wb-svg-panel/static
ReadOnlyPaths=-/mnt/data/wb-svg-panel/themes -/mnt/data/wb-svg-panel/docs -/mnt/data/wb-svg-panel/tools -/mnt/data/wb-svg-panel/tests -/mnt/data/wb-svg-panel/extras
ReadOnlyPaths=/mnt/data/wb-svg-panel/panel.py /mnt/data/wb-svg-panel/install.sh /mnt/data/wb-svg-panel/update.sh
ReadOnlyPaths=-/mnt/data/wb-svg-panel/wb-svg-panel.service -/mnt/data/wb-svg-panel/nginx-panel-location.conf -/mnt/data/wb-svg-panel/nginx-wb-svg-panel.conf
ReadOnlyPaths=-/mnt/data/wb-svg-panel/close-8080.sh -/mnt/data/wb-svg-panel/check-secrets.sh
ReadOnlyPaths=-/mnt/data/wb-svg-panel/config.example.yaml -/mnt/data/wb-svg-panel/docs.html
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
